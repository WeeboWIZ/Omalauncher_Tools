#!/usr/bin/python
import pathlib, subprocess, json, sys
home = pathlib.Path.home()
sys.path.insert(0, str(home/'.local/share/oma-voice'))
from language import local
try:
    text = home.joinpath('.cache/oma-speak/latest.txt').read_text().strip()
    if not text:
        raise ValueError()
    subprocess.run([str(home/'.local/bin/oma-voice'), 'send', '--json', '--text', text], check=False)
except (OSError, ValueError):
    message = '請先開始語音輸入，停止後保存。'
    print(json.dumps({'ok': False, 'error': message, 'error_ui': local(message)}, ensure_ascii=False))
