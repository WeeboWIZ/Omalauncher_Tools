#!/usr/bin/env python3
'''Local Markdown notebook and development log for OMA Linux.'''
from __future__ import annotations

import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
from pathlib import Path

ROOT = Path.home() / "oma-devlogs"
NOTES = ROOT / "notes"
JOURNAL = ROOT / "journal"
# The widget passes --lang; a command typed by hand or by an agent follows the locale.
LANGUAGE = "zh" if os.environ.get("LC_ALL", os.environ.get("LANG", "")).lower().startswith("zh") else "en"


def t(zh: str, en: str) -> str:
    return zh if LANGUAGE == "zh" else en


def ensure_dirs() -> None:
    for path in (ROOT, NOTES, JOURNAL):
        path.mkdir(parents=True, exist_ok=True)
        try:
            # Called on every refresh: leave a folder that is already private untouched.
            if path.stat().st_mode & 0o777 != 0o700:
                path.chmod(0o700)
        except OSError:
            pass


def journal_records() -> list[dict]:
    '''Daily views over monthly storage; still accept legacy daily files.'''
    records = []
    for path in sorted(JOURNAL.glob("*.md")):
        if not re.fullmatch(r"\d{4}-\d{2}(?:-\d{2})?", path.stem):
            continue
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines()):
            if not line.startswith("- "):
                continue
            text = line[2:]
            dated = re.fullmatch(r"(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2} · .+)", text)
            if dated and dated[1].startswith(path.stem[:7] + "-"):
                day, text = dated[1], dated[2]
            elif len(path.stem) == 10:
                day = path.stem
            else:
                continue
            try:
                dt.date.fromisoformat(day)
            except ValueError:
                continue
            records.append({"day": day, "text": text, "id": f"{path.stem}:{number}:{line_hash(line)}"})
    return sorted(records, key=lambda record: (record["day"], record["text"][:5]))


def journal_entries() -> list[tuple[str, str]]:
    return [(record["day"], record["text"]) for record in journal_records()]


def line_hash(line: str) -> str:
    return hashlib.sha256(line.encode("utf-8")).hexdigest()[:10]


def find_log_line(entry_id: str) -> tuple[Path, list[str], int]:
    '''The file and line an id names; refused when the line changed since it was listed.'''
    found = re.fullmatch(r"(\d{4}-\d{2}(?:-\d{2})?):(\d+):([0-9a-f]{10})", entry_id)
    if not found:
        raise ValueError(t("無效的日誌編號。", "Invalid log id."))
    path = JOURNAL / f"{found[1]}.md"
    lines = path.read_text(encoding="utf-8").splitlines(keepends=True) if path.is_file() else []
    number = int(found[2])
    if number >= len(lines) or not lines[number].startswith("- ") or line_hash(lines[number].rstrip("\n")) != found[3]:
        raise ValueError(t("日誌已變更，請更新後再試。", "The log changed; refresh and try again."))
    return path, lines, number


def write_journal(path: Path, lines: list[str]) -> None:
    temporary = path.with_name(path.name + ".new")
    temporary.write_text("".join(lines), encoding="utf-8")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def edit_log(entry_id: str, text: str) -> None:
    clean = " ".join(text.replace("\x00", "").split()).strip()
    if not clean:
        raise ValueError(t("請輸入日誌內容。", "Write something to log."))
    with (ROOT / ".journal.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path, lines, number = find_log_line(entry_id)
        # Keep the date and time; only the words after them change.
        stamp = lines[number].rstrip("\n").split(" · ", 1)[0]
        lines[number] = f"{stamp} · {clean}\n"
        write_journal(path, lines)


def delete_log(entry_id: str) -> None:
    with (ROOT / ".journal.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path, lines, number = find_log_line(entry_id)
        trash = Path.home() / ".local/share/oma-devlogs/trash"
        trash.mkdir(parents=True, exist_ok=True, mode=0o700)
        saved = trash / f"log-{uuid.uuid4().hex}.json"
        saved.write_text(json.dumps({"file": str(path), "line": lines[number].rstrip("\n"),
                                     "deleted": dt.datetime.now().astimezone().isoformat()}, ensure_ascii=False), encoding="utf-8")
        saved.chmod(0o600)
        del lines[number]
        write_journal(path, lines)


def read_latest() -> tuple[str, str]:
    entries = journal_entries()
    return entries[-1] if entries else (dt.datetime.now().astimezone().date().isoformat(), "")


def inside_home(path: Path) -> None:
    try:
        path.relative_to(Path.home().resolve())
    except ValueError:
        raise ValueError(t("只能使用家目錄內的路徑", "Only paths inside your home can be used")) from None


def status() -> None:
    ensure_dirs()
    entries = journal_entries()
    day, latest = entries[-1] if entries else (dt.datetime.now().astimezone().date().isoformat(), "")
    logs = [text for _, text in entries]
    print(json.dumps({
        "notes": len(list(NOTES.glob("*.md"))),
        "entries": len(logs),
        "recent": list(reversed(logs[-3:])),
        "day": day,
        "latest": latest,
        "root": str(ROOT),
        "home": str(Path.home()),
        "projects": str(Path.home() / 'projects' if (Path.home() / 'projects').is_dir() else Path.home()),
        "updated": dt.datetime.now().astimezone().strftime("%H:%M:%S"),
    }, ensure_ascii=False))


KINDS = {
    "md": {"md", "markdown"},
    "code": {"py", "sh", "bash", "js", "mjs", "ts", "tsx", "jsx", "kt", "kts", "java", "c", "h", "cpp", "hpp", "rs", "go",
             "rb", "lua", "php", "swift", "dart", "css", "html", "owl", "json", "yaml", "yml", "toml", "ini", "conf", "xml", "sql"},
    "image": {"png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "ico", "avif"},
    "archive": {"zip", "tar", "gz", "tgz", "xz", "zst", "bz2", "7z", "rar", "apk", "deb"},
}
# Folders a search never enters: generated, vendored or version-control data.
SKIPPED = {"node_modules", ".git", "__pycache__", "build", "dist", ".venv", "venv", "target", ".gradle"}


def kind(path: Path) -> str:
    suffix = path.suffix.lower().lstrip(".")
    return next((name for name, suffixes in KINDS.items() if suffix in suffixes), "other")


def describe(item: Path) -> dict:
    row = {"name": item.name, "path": str(item), "dir": False, "size": 0, "link": item.is_symlink(), "kind": "other"}
    try:
        if item.is_dir():
            row["dir"] = True
            row["kind"] = "folder"
            # A count for the folder icon; capped so a huge folder stays quick.
            count = 0
            for child in os.scandir(item):
                if not child.name.startswith("."):
                    count += 1
                    if count >= 999:
                        break
            row["count"] = count
        else:
            row["size"] = item.stat().st_size
            row["kind"] = kind(item)
    except OSError:
        pass
    return row


def browse(raw: str, offset: int = 0, limit: int = 40) -> None:
    try:
        path = Path(raw).expanduser().resolve()
        inside_home(path)
        if not path.is_dir():
            raise ValueError(t("不是目錄", "Not a directory"))
        items = sorted(path.iterdir(), key=lambda p: (not p.is_dir(), p.name.casefold()))
        items = [p for p in items if not p.name.startswith(".")]
        offset = max(0, offset)
        limit = min(max(1, limit), 40)
        home = Path.home().resolve()
        crumbs = [{"name": "~", "path": str(home)}]
        if path != home:
            for part in path.relative_to(home).parts:
                crumbs.append({"name": part, "path": str(Path(crumbs[-1]["path"]) / part)})
        print(json.dumps({"path": str(path), "parent": str(path.parent) if path != home else str(path),
                          "crumbs": crumbs[-4:], "items": [describe(item) for item in items[offset:offset + limit]],
                          "offset": offset, "limit": limit, "total": len(items),
                          "more": offset + limit < len(items)}, ensure_ascii=False))
    except (OSError, ValueError) as error:
        print(json.dumps({"path": raw, "items": [], "error": str(error)}, ensure_ascii=False))


def search(raw: str, query: str, content: bool = False, depth: int = 6, budget: float = 5.0) -> dict:
    '''Names, and optionally Markdown or text contents, below a folder in your home: 40 hits, 6 levels, 5 seconds.'''
    try:
        root = Path(raw).expanduser().resolve()
        inside_home(root)
        if not root.is_dir():
            raise ValueError(t("不是目錄", "Not a directory"))
        needle = " ".join(query.split()).casefold()
        if not needle:
            raise ValueError(t("請輸入要搜尋的文字。", "Enter something to search for."))
        deadline = time.monotonic() + budget
        rows, stopped = [], False
        for folder, folders, files in os.walk(root):
            here = Path(folder)
            level = len(here.relative_to(root).parts)
            folders[:] = sorted(name for name in folders if not name.startswith(".") and name not in SKIPPED) if level < depth else []
            for name in folders + sorted(name for name in files if not name.startswith(".")):
                if len(rows) >= 40 or time.monotonic() > deadline:
                    stopped = True
                    break
                item = here / name
                match = ""
                if needle not in name.casefold():
                    if not content or item.is_symlink() or kind(item) != "md" and item.suffix.lower() != ".txt":
                        continue
                    try:
                        if item.stat().st_size > 1024 * 1024:
                            continue
                        match = next((line.strip()[:160] for line in item.read_text(encoding="utf-8", errors="replace").splitlines()
                                      if needle in line.casefold()), "")
                    except OSError:
                        continue
                    if not match:
                        continue
                row = describe(item)
                row["rel"] = str(item.relative_to(root))
                row["match"] = match
                rows.append(row)
            if stopped:
                break
        return {"path": str(root), "query": query, "content": content, "items": rows, "total": len(rows), "more": stopped}
    except (OSError, ValueError) as error:
        return {"path": raw, "query": query, "items": [], "total": 0, "error": str(error)}


def history(day: str = "", offset: int = 0) -> None:
    records = journal_records()
    days = sorted({record["day"] for record in records}, reverse=True)
    selected = day or (days[0] if days else "")
    if selected and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", selected):
        raise SystemExit(t("日期格式必須為 YYYY-MM-DD", "The date must be YYYY-MM-DD"))
    if selected:
        try:
            dt.date.fromisoformat(selected)
        except ValueError:
            raise SystemExit(t("日期格式必須為有效的 YYYY-MM-DD", "The date must be a real YYYY-MM-DD date"))
    entries = [{"id": record["id"], "text": record["text"]} for record in reversed(records) if record["day"] == selected]
    offset = max(0, offset)
    print(json.dumps({"days": days[:500], "day": selected, "entries": entries[offset:offset + 40],
                      "offset": offset, "total": len(entries), "more": offset + 40 < len(entries)}, ensure_ascii=False))


def refresh_widget() -> None:
    '''Notify the launcher after a successful write; logging also works offline.'''
    sender = shutil.which("owl-send")
    if not sender:
        return
    # Store-installed filenames differ from the GitHub install's filename.
    widgets = Path.home() / '.config/omalauncher/widgets'
    for path in widgets.glob('*.owl'):
        if path.name.startswith('preview-'):
            continue
        try:
            if not re.match(r'\s*widget "DEV LOGS"', path.read_text()):
                continue
        except OSError:
            continue
        # Only a refresh: the day someone is reading stays on screen.
        try:
            subprocess.run([sender, str(path), "refresh"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=2, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass


def log_entry(text: str) -> None:
    ensure_dirs()
    clean = " ".join(text.replace("\x00", "").split()).strip()
    if not clean:
        raise SystemExit(t("請輸入日誌內容。", "Write something to log."))
    now = dt.datetime.now().astimezone()
    month = now.strftime('%Y-%m')
    path = JOURNAL / f"{month}.md"
    with (ROOT / '.journal.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with path.open("a", encoding="utf-8") as stream:
            if stream.tell() == 0:
                stream.write(f"# {t('開發日誌', 'Dev log')} · {month}\n\n")
            stream.write(f"- {now.strftime('%Y-%m-%d %H:%M')} · {clean}\n")
    try:
        path.chmod(0o600)
    except OSError:
        pass
    print(f"{t('已儲存', 'Saved')} → {path.relative_to(ROOT)}", flush=True)
    refresh_widget()


def slugify(title: str) -> str:
    slug = title.strip().lower()
    slug = re.sub(r"[^\w\u3400-\u9fff-]+", "-", slug, flags=re.UNICODE)
    slug = re.sub(r"-+", "-", slug).strip("-_")
    return slug[:60] or "untitled"


def create_note(title: str, body: str = "") -> Path:
    ensure_dirs()
    clean_title = " ".join(title.split()).strip()
    if not clean_title:
        raise SystemExit(t("標題不能為空。", "The title cannot be empty."))
    stem = slugify(clean_title)
    path = NOTES / f"{stem}.md"
    serial = 2
    while path.exists():
        path = NOTES / f"{stem}-{serial}.md"
        serial += 1
    content = f"# {clean_title}\n\n"
    if body.strip():
        content += body.strip() + "\n"
    else:
        content += t("## 想法\n\n\n## 下一步\n\n- [ ] \n", "## Ideas\n\n\n## Next steps\n\n- [ ] \n")
    path.write_text(content, encoding="utf-8")
    try:
        path.chmod(0o600)
    except OSError:
        pass
    return path


def home_directory(raw: str) -> Path:
    path = Path(raw).expanduser().resolve(strict=True)
    inside_home(path)
    if not path.is_dir():
        raise ValueError(t("不是目錄", "Not a directory"))
    return path


def create_markdown(raw: str, title: str) -> Path:
    folder = home_directory(raw)
    title = title.strip()
    if title.lower().endswith('.md'):
        title = title[:-3].strip()
    if not title or title.startswith('.') or any(c in title for c in ('/', '\\', '\x00', '\n', '\r')):
        raise ValueError(t("請輸入檔名，不含路徑或換行。", "Enter a file name without a path or line break."))
    stem = title[:120]
    for serial in range(1, 10000):
        path = folder / (stem + (f'-{serial}' if serial > 1 else '') + '.md')
        try:
            with path.open('x', encoding='utf-8') as stream:
                path.chmod(0o600)
                stream.write(f'# {title}\n\n')
            return path
        except FileExistsError:
            continue
    raise ValueError(t("同名檔案過多，請換一個檔名。", "Too many files with this name; choose another."))


def trash_markdown(raw: str) -> Path:
    supplied = Path(raw).expanduser()
    if supplied.is_symlink():
        raise ValueError(t("不刪除符號連結，請開啟實際目錄後操作。", "Symbolic links are not deleted; open the real folder instead."))
    path = supplied.resolve(strict=True)
    inside_home(path)
    if not path.is_file() or path.suffix.lower() != '.md':
        raise ValueError(t("只能刪除 Markdown 檔案。", "Only Markdown files can be deleted."))
    trash = Path.home() / '.local/share/oma-devlogs/trash'
    trash.mkdir(parents=True, exist_ok=True, mode=0o700)
    token = uuid.uuid4().hex
    target = trash / f'{token}.md'
    metadata = trash / f'{token}.json'
    metadata.write_text(json.dumps({'original': str(path), 'deleted': dt.datetime.now().astimezone().isoformat()}, ensure_ascii=False), encoding='utf-8')
    metadata.chmod(0o600)
    try:
        shutil.move(str(path), str(target))
    except BaseException:
        metadata.unlink()
        raise
    return target


def need_gum() -> None:
    if shutil.which("gum") is None:
        raise SystemExit(t("互動選單需要 gum（pacman -S gum）；也可以用 `oma-devlogs log '內容'` 記錄日誌。",
                           "The interactive menu needs gum (pacman -S gum); `oma-devlogs log 'text'` works without it."))


def gum_input(prompt: str, placeholder: str = "") -> str:
    result = subprocess.run(
        ["gum", "input", "--prompt", prompt, "--placeholder", placeholder],
        text=True,
        check=False,
        capture_output=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def pager(path: Path) -> None:
    with path.open(encoding="utf-8") as stream:
        subprocess.run(["gum", "pager"], stdin=stream, check=False)


def interactive() -> None:
    ensure_dirs()
    need_gum()
    while True:
        print("\033[2J\033[H", end="")
        print("\033[38;5;45mDEV LOGS\033[0m   " + t("本機 Markdown · 開發日誌", "Local Markdown · dev log"))
        print(f"{ROOT}\n")
        menu = {"快速記日誌": "Quick log", "新增 Markdown": "New Markdown", "編輯 Markdown": "Edit Markdown",
                "瀏覽筆記": "Browse notes", "查看本月日誌": "This month's log", "歷史日誌": "Earlier logs", "退出": "Quit"}
        labels = {t(zh, en): zh for zh, en in menu.items()}
        choice = subprocess.run(["gum", "choose", *labels], text=True, check=False, capture_output=True)
        # The branches below keep the Chinese keys whatever language is shown.
        selected = labels.get(choice.stdout.strip(), "退出")
        if choice.returncode != 0 or selected == "退出":
            return
        back = t("\nEnter 返回…", "\nEnter to go back…")
        if selected == "快速記日誌":
            text = gum_input(t("日誌 › ", "Log › "), t("完成了什麼？", "What was done?"))
            if text:
                log_entry(text)
                input(back)
        elif selected == "新增 Markdown":
            title = gum_input(t("標題 › ", "Title › "), t("例如：測試計畫", "For example: test plan"))
            if title:
                body_result = subprocess.run(
                    ["gum", "write", "--placeholder", t("在這裡寫 Markdown…", "Write Markdown here…"), "--header", title],
                    text=True,
                    check=False,
                    capture_output=True,
                )
                if body_result.returncode == 0:
                    path = create_note(title, body_result.stdout)
                    print(f"\n{t('已建立', 'Created')} → {path.relative_to(ROOT)}")
                    input(back)
        elif selected in {"編輯 Markdown", "瀏覽筆記"}:
            files = sorted(NOTES.glob("*.md"))
            if not files:
                print(t("\n目前沒有筆記。", "\nNo notes yet."))
                input(back)
                continue
            listing = "\n".join(str(p) for p in files)
            chosen = subprocess.run(
                ["gum", "filter", "--placeholder", t("搜尋筆記…", "Search notes…")],
                input=listing,
                text=True,
                check=False,
                capture_output=True,
            )
            path = Path(chosen.stdout.strip()) if chosen.returncode == 0 and chosen.stdout.strip() else None
            if path and path.exists():
                if selected == "瀏覽筆記":
                    pager(path)
                else:
                    edited = subprocess.run(
                        ["gum", "write", "--header", path.name, "--value", path.read_text(encoding="utf-8")],
                        text=True,
                        check=False,
                        capture_output=True,
                    )
                    if edited.returncode == 0:
                        temp = path.with_suffix(path.suffix + ".new")
                        temp.write_text(edited.stdout, encoding="utf-8")
                        os.replace(temp, path)
                        try:
                            path.chmod(0o600)
                        except OSError:
                            pass
        elif selected == "歷史日誌":
            files = sorted(JOURNAL.glob("*.md"), reverse=True)
            if files:
                chosen = subprocess.run(["gum", "choose", *[p.name for p in files]], text=True, capture_output=True)
                if chosen.returncode == 0 and chosen.stdout.strip() in {p.name for p in files}:
                    pager(JOURNAL / chosen.stdout.strip())
            else:
                input(t("沒有歷史日誌。Enter 返回…", "No earlier logs. Enter to go back…"))
        elif selected == "查看本月日誌":
            path = JOURNAL / f"{dt.datetime.now().astimezone().strftime('%Y-%m')}.md"
            if path.exists():
                pager(path)
            else:
                print(t("\n本月還沒有日誌。", "\nNo log this month yet."))
                input(back)


def main(argv: list[str]) -> None:
    global LANGUAGE
    if len(argv) >= 2 and argv[0] == "--lang":
        LANGUAGE = "zh" if argv[1] == "zh" else "en"
        argv = argv[2:]
    ensure_dirs()
    if not argv or argv[0] in {"open", "ui"}:
        interactive()
    elif argv[0] == "browse":
        browse(argv[1] if len(argv) > 1 else str(Path.home()), int(argv[2]) if len(argv) > 2 else 0,
               int(argv[3]) if len(argv) > 3 else 40)
    elif argv[0] == "search" and len(argv) >= 3:
        print(json.dumps(search(argv[1], argv[2], argv[3:4] == ["content"]), ensure_ascii=False))
    elif argv[0] in {"edit", "delete-log"} and len(argv) == (3 if argv[0] == "edit" else 2):
        try:
            if argv[0] == "edit":
                edit_log(argv[1], argv[2])
            else:
                delete_log(argv[1])
        except (OSError, ValueError) as error:
            raise SystemExit(str(error))
        print(t("已儲存", "Saved") if argv[0] == "edit" else t("已移至回收區", "Moved to trash"), flush=True)
        refresh_widget()
    elif argv[0] == "history":
        history(argv[1] if len(argv) > 1 else "", int(argv[2]) if len(argv) > 2 else 0)
    elif argv[0] == "status":
        status()
    elif argv[0] == "new-at" and len(argv) == 3:
        try:
            print(f"{t('已建立', 'Created')} → {create_markdown(argv[1], argv[2])}", flush=True)
        except (OSError, ValueError) as error:
            raise SystemExit(str(error))
    elif argv[0] == "delete-md" and len(argv) == 2:
        try:
            trash_markdown(argv[1])
            print(t("已移至回收區", "Moved to trash"), flush=True)
        except (OSError, ValueError) as error:
            raise SystemExit(str(error))
    elif argv[0] in {"log", "add"}:
        log_entry(" ".join(argv[1:]))
    elif argv[0] in {"new", "note"}:
        if len(argv) < 2:
            raise SystemExit(t("用法：oma-devlogs new <標題>", "Usage: oma-devlogs new <title>"))
        path = create_note(" ".join(argv[1:]))
        print(path)
    elif argv[0] == "list":
        for path in sorted(NOTES.glob("*.md")):
            print(path.relative_to(ROOT))
    elif argv[0] == "help":
        print(t("oma-devlogs [--lang en|zh] [open|status|browse <目錄> [偏移] [數量]|search <目錄> <文字> [content]|history [日期] [偏移]|log <文字>|edit <編號> <文字>|delete-log <編號>|new <標題>|new-at <目錄> <檔名>|delete-md <檔案>|list]",
                "oma-devlogs [--lang en|zh] [open|status|browse <folder> [offset] [count]|search <folder> <text> [content]|history [date] [offset]|log <text>|edit <id> <text>|delete-log <id>|new <title>|new-at <folder> <name>|delete-md <file>|list]"))
    else:
        raise SystemExit(t(f"未知指令：{argv[0]}（用 `oma-devlogs help` 查看）", f"Unknown command: {argv[0]} (see `oma-devlogs help`)"))


if __name__ == "__main__":
    main(sys.argv[1:])
