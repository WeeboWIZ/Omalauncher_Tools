widget "Dictation" {
 page: 1
 order: 7
 size: 3x4
 minSize: 3x3
 meta { owl: 6; description: "Dictate by voice, let Claude or Codex tidy the text, review it, then send it to a Codex chat or to Claude or any CLI in tmux. One page, no copy and paste."; version: "__VERSION__"; license: "MIT"; category: "productivity" }
 requires { pacman: ["python", "espeak-ng", "libpulse", "mpg123", "tmux", "curl", "util-linux"] }
 source uiLanguage = file("~/.config/omalauncher/voice-ui-language")
 source installed = file("~/.local/share/oma-voice/dictation-version")
 source payloadVersion = file("~/.local/share/oma-voice/store-version")
 source setupState = file("~/.cache/oma-voice/setup-state")
 let ready = installed == "__PAYLOAD_ID__" || (installed == "" && payloadVersion == "__PAYLOAD_ID__")
 let setupText = setupState == "installing" && !ready ? _("Installing, about a minute…") : setupState == "failed" ? _("Setup failed: see ~/.cache/oma-voice/setup.log") : installed == "" ? _("First use: writes the voice and dictation programs to ~/.local and downloads edge-tts for online speech.") : _("The programs have an update; install it to continue.")
 source voice = file("~/.cache/oma-voice/state.json") json
 source latest = file("~/.cache/oma-speak/latest.txt")
 source refined = file("~/.cache/oma-speak/refined.txt")
 source refineStatus = file("~/.cache/oma-speak/refine-status.json") json
 source sendStatus = file("~/.cache/oma-speak/send-status.json") json
 source queued = file("~/.cache/oma-voice/queued.json") json
 let sendMessage = sendStatus.phase == "sending" ? _("Sending…") : sendStatus.phase == "sent" ? (sendStatus.status_ui ?? _("Queued for current target")) : sendStatus.phase == "failed" ? (sendStatus.error_ui ?? sendStatus.error ?? _("Send failed")) : sendStatus.phase == "saved" ? _("Saved to home") : _("Save, then send")
 let refineMessage = refineStatus.phase == "refining" ? _("Refining…") : refineStatus.phase == "ready" ? _("Refined draft ready") : refineStatus.phase == "failed" ? (refineStatus.error ?? _("Refining failed; original is available")) : _("Refine the saved text with Agent")
 state actionKind = ""
 state actionPending = ""
 state actionResult = ""
 state copyState = ""
 on actionResult { actionPending = "" }
 let actionMessage = actionPending != "" ? _("Working…") : actionResult != "" ? (parseJson(actionResult).ok ? (parseJson(actionResult).status_ui ?? (actionKind == "open" ? _("Dictation opened") : _("Done"))) : (parseJson(actionResult).error_ui ?? parseJson(actionResult).error ?? _("Action failed"))) : ""
 let actionFailed = actionPending == "" && actionResult != "" && parseJson(actionResult).ok != true
 let copyNotice = copyState == "copied" ? _("Copied") : copyState == "empty" ? _("No saved text") : ""
 onTap: screen()
 Column {
  fill: true
  gap: 5
  if !ready {
   Text { text: _("DICTATION"); style: label; color: accent }
   Text { text: setupText; style: small; maxLines: 8; weight: 1; color: setupState == "failed" ? red : muted }
   Button { fill: width; height: 36; text: installed == "" ? _("Set up") : _("Update"); onTap: run("""__SETUP_COMMAND__""") }
   Button { fill: width; height: 36; text: _("Details"); onTap: screen() }
  } else {
  Text { text: _("DICTATION"); style: label; color: accent }
  Button { fill: width; height: 36; text: _("Start dictation"); onTap: run("bash ~/.local/bin/speak") }
  Text { text: _("Send to: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : voice.source == 'claude' ? 'Claude' : 'Codex chat'}"); style: small; color: accent; maxLines: 2 }
  Text { text: latest == "" || latest == null ? _("Start → speak → stop and save") : latest; style: small; maxLines: 3; weight: 1 }
  Text { text: queued.id != null ? _("Waiting for Codex: newest message only") : sendMessage; style: small; color: queued.id != null ? yellow : sendStatus.phase == "failed" ? red : sendStatus.phase == "sent" || sendStatus.phase == "saved" ? accent : muted; maxLines: 2 }
  Row {
   gap: 4
   if voice.source == "claude" && (voice.term_pane == "" || voice.term_pane == null) {
    Button { height: 36; weight: 1; text: copyState == "copied" ? _("Copied") : _("Copy text"); onTap: { copyState = latest == "" || latest == null ? "empty" : "copied"; copy(latest) } }
   } else {
   Button { height: 36; weight: 1; text: actionPending == "send" || sendStatus.phase == "sending" ? _("Sending…") : sendStatus.phase == "sent" && sendStatus.version == "original" ? _("Queued") : _("Send original"); onTap: { actionKind = "send"; actionPending = "send"; actionResult = ""; actionResult = run("python ~/.local/bin/oma-send-dictation --json") } }
   }
   if queued.id != null {
    Button { height: 36; weight: 1; text: actionPending == "unqueue" ? _("Working…") : _("Cancel waiting"); onTap: { actionKind = "unqueue"; actionPending = "unqueue"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py unqueue --json") } }
   } else {
    Button { height: 36; weight: 1; text: _("Details"); onTap: screen() }
   }
  }
  }
 }
 screen {
  title: (uiLanguage == "zh" ? "語音輸入" : "DICTATION")
  Column {
   fill: width
   scroll: true
   height: screenHeight
   gap: 12
   if !ready { Text { text: (uiLanguage == "zh" ? "尚未安裝或需要更新：請返回首頁，在此小工具上按「安裝」。" : "Not set up yet: go back and tap Set up on the tile."); color: yellow; maxLines: 3 } }
   Button { fill: width; height: 52; text: actionPending == "open" ? (uiLanguage == "zh" ? "處理中…" : "Working…") : (uiLanguage == "zh" ? "開始語音輸入" : "Start dictation"); color: background; background: accent; onTap: { actionKind = "open"; actionPending = "open"; actionResult = ""; actionResult = run("bash ~/.local/bin/speak --json") } }
   if actionKind == "open" && actionMessage != "" { Text { text: actionMessage; style: small; color: actionFailed ? red : accent; maxLines: 3 } }
   Text { text: (uiLanguage == "zh" ? "送到" : "Send to"); style: small; color: muted }
   Row {
    gap: 6
    Button { weight: 1; height: 44; text: actionPending == "source" ? "…" : "Codex"; color: voice.source == "codex" ? background : accent; background: voice.source == "codex" ? accent : alpha(accent, 0); onTap: { actionKind = "source"; actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source codex --json") } }
    Button { weight: 1; height: 44; text: actionPending == "source" ? "…" : "Claude"; color: voice.source == "claude" ? background : accent; background: voice.source == "claude" ? accent : alpha(accent, 0); onTap: { actionKind = "source"; actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source claude --json") } }
    Button { weight: 1; height: 44; text: actionPending == "source" ? "…" : "tmux"; color: voice.source == "terminal" ? background : accent; background: voice.source == "terminal" ? accent : alpha(accent, 0); onTap: { actionKind = "source"; actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source terminal --json") } }
   }
   if voice.source == "claude" && (voice.term_pane == "" || voice.term_pane == null) {
    Text { text: (uiLanguage == "zh" ? "Claude 不在 tmux 中：只能複製貼上" : "Claude is not in tmux: copy and paste only"); style: small; color: yellow; maxLines: 2 }
    Button { fill: width; height: 44; text: (uiLanguage == "zh" ? "在 tmux 開啟 Claude" : "Open Claude in tmux"); onTap: terminal("tmux new -A -s oma-voice 'claude; exec bash'", "Claude") }
   }
   if actionKind == "source" && actionMessage != "" { Text { text: actionMessage; style: small; color: actionFailed ? red : accent; maxLines: 3 } }
   Column {
    fill: width
    padding: 12
    border: 1
    borderColor: border
    gap: 10
    Text { text: (uiLanguage == "zh" ? "最近文字" : "Latest text"); bold: true; color: accent }
    Text { text: latest == "" || latest == null ? (uiLanguage == "zh" ? "開始 → 說話 → 停止並保存，文字會出現在這裡" : "Start → speak → stop and save; the text shows here") : latest; color: latest == "" || latest == null ? muted : foreground; maxLines: 160 }
    Row {
     gap: 6
     if voice.source == "claude" && (voice.term_pane == "" || voice.term_pane == null) {
      Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "複製給 Claude" : "Copy for Claude"); color: background; background: accent; onTap: { copyState = latest == "" || latest == null ? "empty" : "copied"; copy(latest) } }
     } else {
      Button { weight: 1; height: 44; text: actionPending == "send" || sendStatus.phase == "sending" ? (uiLanguage == "zh" ? "正在送出…" : "Sending…") : sendStatus.phase == "sent" && sendStatus.version == "original" ? (uiLanguage == "zh" ? "已排隊" : "Queued") : (uiLanguage == "zh" ? "送出" : "Send"); color: background; background: accent; onTap: { actionKind = "send"; actionPending = "send"; actionResult = ""; actionResult = run("python ~/.local/bin/oma-send-dictation --json") } }
      Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "複製" : "Copy"); onTap: { copyState = latest == "" || latest == null ? "empty" : "copied"; copy(latest) } }
     }
    }
    if sendStatus.phase == "sending" || sendStatus.phase == "sent" || sendStatus.phase == "failed" { Text { text: sendMessage; style: small; color: sendStatus.phase == "failed" ? red : accent; maxLines: 3 } }
    if copyNotice != "" { Text { text: copyNotice; style: small; color: latest == "" || latest == null ? red : accent; maxLines: 2 } }
   }
   if queued.id != null {
    Column {
     fill: width
     padding: 12
     border: 1
     borderColor: yellow
     gap: 8
     Text { text: (uiLanguage == "zh" ? "排隊中：Codex 回覆完成後送出（只保留最新一則）" : "Waiting: sends when Codex finishes (newest message only)"); color: yellow; bold: true; maxLines: 3 }
     Text { text: queued.text ?? ""; style: small; maxLines: 6 }
     Button { fill: width; height: 44; text: actionPending == "unqueue" ? (uiLanguage == "zh" ? "處理中…" : "Working…") : (uiLanguage == "zh" ? "取消排隊" : "Cancel waiting"); onTap: { actionKind = "unqueue"; actionPending = "unqueue"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py unqueue --json") } }
    }
   }
   Button { fill: width; height: 44; text: actionPending == "refine" || refineStatus.phase == "refining" ? (uiLanguage == "zh" ? "正在整理…" : "Refining…") : (uiLanguage == "zh" ? "✦ 用 Agent 整理文字" : "✦ Refine with Agent"); onTap: { actionKind = "refine"; actionPending = "refine"; actionResult = ""; actionResult = run("python ~/.local/bin/oma-refine-dictation --start --json") } }
   if refineStatus.phase == "refining" || refineStatus.phase == "failed" { Text { text: refineMessage; style: small; color: refineStatus.phase == "failed" ? red : muted; maxLines: 3 } }
   if refineStatus.phase == "ready" && refined != "" {
    Column {
     fill: width
     padding: 12
     border: 1
     borderColor: accent
     gap: 10
     Text { text: (uiLanguage == "zh" ? "整理稿" : "Refined draft"); color: accent; bold: true }
     Text { text: refined; maxLines: 160 }
     Button { fill: width; height: 44; text: actionPending == "send" && actionKind == "send" ? (uiLanguage == "zh" ? "正在送出…" : "Sending…") : sendStatus.phase == "sent" && sendStatus.version == "refined" ? (uiLanguage == "zh" ? "已排隊" : "Queued") : (uiLanguage == "zh" ? "送出整理稿" : "Send refined draft"); color: background; background: accent; onTap: { actionKind = "send"; actionPending = "send"; actionResult = ""; actionResult = run("python ~/.local/bin/oma-send-dictation --refined --json") } }
    }
   }
  }
 }
}
