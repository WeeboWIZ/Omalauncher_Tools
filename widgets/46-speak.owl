widget "Terminal Voice" {
  page: 1
  order: 6
  size: 3x4
  minSize: 3x4
  meta { owl: 6; description: "Reads Codex replies or a tmux terminal aloud, also a task finished with the screen off. For Codex, Claude or any CLI. English, Chinese, Spanish, German, French, Japanese, Korean."; version: "__VERSION__"; license: "MIT"; category: "productivity" }
  requires { pacman: ["python", "espeak-ng", "libpulse", "mpg123", "tmux", "curl", "util-linux"] }
  source uiLanguage = file("~/.config/omalauncher/voice-ui-language")
  source installed = file("~/.local/share/oma-voice/store-version")
  source setupState = file("~/.cache/oma-voice/setup-state")
  let ready = installed == "__PAYLOAD_ID__"
  let setupText = setupState == "installing" && !ready ? _("Installing, about a minute…") : setupState == "failed" ? _("Setup failed: see ~/.cache/oma-voice/setup.log") : installed == "" ? _("First use: writes the voice and dictation programs to ~/.local and downloads edge-tts for online speech.") : _("The programs have an update; install it to continue.")
  source service = cmd("if [ -f ~/.local/share/oma-voice/oma_voice.py ]; then python ~/.local/share/oma-voice/oma_voice.py ensure; fi") every 30s status
  source voice = file("~/.cache/oma-voice/state.json") json
  let offline = service.ok == false
  let replyTime = voice.reply_at == null ? _("Nothing to read yet") : _("Reply ${fmtTime(voice.reply_at, 'MM-dd HH:mm')}")
  let statusText = offline ? _("Service offline · tap Sync") : voice.awaiting ? _("Working · previous reply below") : voice.status_ui ?? _("Connecting…")
  state detailTab = "read"
  state actionPending = ""
  state actionResult = ""
  on actionResult { actionPending = "" }
  onTap: screen()
  Column {
    fill: true
    gap: 6
    if !ready {
      Text { text: _("TERMINAL VOICE"); style: label; color: accent }
      Text { text: setupText; style: small; maxLines: 8; weight: 1; color: setupState == "failed" ? red : muted }
      Button { fill: width; height: 40; text: installed == "" ? _("Set up") : _("Update"); onTap: run("""__SETUP_COMMAND__""") }
      Button { fill: width; height: 40; text: _("Details"); onTap: screen() }
    } else {
    Text { text: _("TERMINAL VOICE"); style: label; color: accent }
    Text { text: voice.source == "terminal" ? _("Source: ${voice.source_name ?? 'Terminal'}") : _("Source: Codex chat"); style: small; color: accent }
    Text { text: statusText; style: small; maxLines: 2; color: offline ? yellow : muted }
    Text { text: replyTime; style: small; color: muted }
    Text { text: voice.summary == "" || voice.summary == null ? _("Choose a Codex chat or connect a tmux terminal.") : voice.summary; style: small; maxLines: 4; weight: 1 }
    Row {
      gap: 4
      Button { text: _("Play"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py replay") }
      Button { text: _("Stop"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py stop") }
    }
    Row {
      gap: 4
      Button { text: _("Sync"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py refresh") }
      Button { text: _("Details"); weight: 1; height: 40; onTap: screen() }
    }
    }
  }
  screen {
    title: _("TERMINAL // VOICE")
    Column {
      fill: true
      height: screenHeight
      gap: 10
      Row {
        height: 44
        Button { weight: 1; height: 44; text: _("Sync reply"); onTap: { actionPending = "sync"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py refresh --json") } }
        Button { weight: 1; height: 44; text: _("Stop audio"); onTap: { actionPending = "stop"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py stop --json") } }
        Button { weight: 1; height: 44; text: _("Back"); onTap: close() }
      }
      Row {
        gap: 8
        Button { weight: 1; height: 44; text: detailTab == "read" ? _("Playback selected") : _("Playback"); onTap: detailTab = "read" }
        Button { weight: 1; height: 44; text: detailTab == "settings" ? _("Settings selected") : _("Settings"); onTap: detailTab = "settings" }
      }
      Column {
        scroll: true
        fill: width
        height: max(1, screenHeight - 108)
        gap: 12
        if !ready { Text { text: _("Not set up yet: go back and tap Set up on the tile."); color: yellow; maxLines: 3 } }
        Text { text: statusText; color: offline ? yellow : accent; maxLines: 3 }
        if actionPending != "" { Text { text: _("Working…"); color: accent } }
        if actionPending == "" && actionResult != "" { Text { text: parseJson(actionResult).ok ? (parseJson(actionResult).status_ui ?? _("Done")) : (parseJson(actionResult).error_ui ?? _("Action failed")); color: parseJson(actionResult).ok ? accent : red; maxLines: 3 } }
        Text { text: voice.error_ui ?? ""; style: small; color: red; maxLines: 5 }
        if detailTab == "read" {
        Text { text: replyTime; style: small; color: muted }
        Text { text: voice.source == "terminal" ? _("Reading: ${voice.source_name ?? 'Terminal'} · tmux session oma-voice") : _("Reading: Codex chat"); bold: true; color: accent; maxLines: 3 }
        Row {
          Button { weight: 1; height: 44; text: voice.source == "codex" ? _("Codex chat selected") : _("Codex chat"); onTap: { actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source codex --json") } }
          Button { weight: 1; height: 44; text: voice.source == "terminal" ? _("Terminal / Claude selected") : _("Terminal / Claude"); onTap: { actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source terminal --json") } }
        }
        if voice.source == "terminal" {
          Text { text: _("Run this in your existing terminal, then start Codex, Claude or another program there. Play reads the current screen; dictation sends to that pane."); style: small; color: muted; maxLines: 7 }
          Button { fill: width; height: 44; text: _("Copy terminal setup command"); onTap: copy("tmux new -A -s oma-voice") }
        } else {
        Text { text: voice.follow_latest ? _("Following latest active Codex chat") : _("Pinned to this chat"); bold: true }
        Text { text: voice.thread ?? _("Waiting for connection"); style: small; maxLines: 2; color: muted }
        Text { text: _("Completed replies update automatically. Sync refreshes text without replaying older replies."); style: small; maxLines: 4; color: muted }
        }
        Row {
          Button { weight: 1; height: 44; text: _("Summary"); onTap: { actionPending = "play"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py replay --json") } }
          Button { weight: 1; height: 44; text: _("Full reply"); onTap: { actionPending = "play"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py replay --full --json") } }
        }
        Text { text: voice.source == "terminal" ? _("Terminal screen") : _("Latest reply"); bold: true; color: accent }
        Text { text: voice.full == "" || voice.full == null ? _("Nothing to read yet") : voice.full; maxLines: 160 }
        Button { fill: width; height: 44; text: _("Copy text"); onTap: copy(voice.full ?? "") }
        }
        if detailTab == "settings" {
        Text { text: _("Voice settings"); bold: true; color: accent }
        if voice.source != "terminal" { Button { fill: width; height: 44; text: voice.follow_latest ? _("Chat: follow latest") : _("Chat: pinned"); onTap: { actionPending = "follow"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py follow --json") } } }
        if voice.source != "terminal" { Button { fill: width; height: 44; text: voice.auto ? _("Auto-read: on") : _("Auto-read: off"); onTap: { actionPending = "auto"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py auto toggle --json") } } }
        Row {
          gap: 8
          Button { weight: 1; height: 44; text: voice.engine == "online" ? _("Online voice selected") : _("Online voice"); onTap: { actionPending = "engine"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py engine online --json") } }
          Button { weight: 1; height: 44; text: voice.engine == "offline" ? _("Offline voice selected") : _("Offline voice"); onTap: { actionPending = "engine"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py engine offline --json") } }
        }
        Text { text: voice.pause_minutes == 0 ? _("Idle pause: never") : _("Idle pause: ${voice.pause_minutes ?? 10} min"); style: small; color: accent }
        Row {
          gap: 8
          Button { weight: 1; height: 44; text: voice.pause_minutes == 10 ? _("10 minutes selected") : _("10 minutes"); onTap: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause 10 --json") } }
          Button { weight: 1; height: 44; text: voice.pause_minutes == 0 ? _("Never pause selected") : _("Never pause"); onTap: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause off --json") } }
        }
        Input { placeholder: _("Custom minutes (1–1440), then send"); clear: true; onSubmit: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause ${sh(value)} --json") } }
        Text { text: _("Idle pause stops the service when the tile is off screen and Codex is inactive. It does not slow replies while connected."); style: small; color: muted; maxLines: 4 }
        Text { text: _("Interface language"); bold: true; color: accent }
        Grid {
          columns: 2
          gap: 8
          Button { fill: width; height: 44; text: uiLanguage == "en" ? "✓ English" : "English"; onTap: run("mkdir -p ~/.config/omalauncher && printf en > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "zh" ? "✓ 中文" : "中文"; onTap: run("mkdir -p ~/.config/omalauncher && printf zh > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "es" ? "✓ Español" : "Español"; onTap: run("mkdir -p ~/.config/omalauncher && printf es > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "de" ? "✓ Deutsch" : "Deutsch"; onTap: run("mkdir -p ~/.config/omalauncher && printf de > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "fr" ? "✓ Français" : "Français"; onTap: run("mkdir -p ~/.config/omalauncher && printf fr > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "ja" ? "✓ 日本語" : "日本語"; onTap: run("mkdir -p ~/.config/omalauncher && printf ja > ~/.config/omalauncher/voice-ui-language") }
          Button { fill: width; height: 44; text: uiLanguage == "ko" ? "✓ 한국어" : "한국어"; onTap: run("mkdir -p ~/.config/omalauncher && printf ko > ~/.config/omalauncher/voice-ui-language") }
        }
        Button { fill: width; height: 44; text: _("Start dictation"); onTap: run("bash ~/.local/bin/speak") }
        }
      }
    }
  }
}
