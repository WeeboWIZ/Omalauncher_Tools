widget "Terminal Voice" {
  page: 1
  order: 6
  size: 3x4
  minSize: 3x4
  meta { owl: 6; description: "Hear Codex or Claude replies, or a tmux terminal running any CLI, read aloud, even a task that finishes with the screen off. Pairs with Dictation to answer by voice."; version: "__VERSION__"; license: "MIT"; category: "productivity" }
  requires { pacman: ["python", "espeak-ng", "libpulse", "mpg123", "tmux", "curl", "util-linux"] }
  source uiLanguage = file("~/.config/omalauncher/voice-ui-language")
  source installed = file("~/.local/share/oma-voice/terminal-voice-version")
  source payloadVersion = file("~/.local/share/oma-voice/store-version")
  source setupState = file("~/.cache/oma-voice/setup-state")
  let ready = installed == "__PAYLOAD_ID__" || (installed == "" && payloadVersion == "__PAYLOAD_ID__")
  let setupText = setupState == "installing" && !ready ? _("Installing, about a minute…") : setupState == "failed" ? _("Setup failed: see ~/.cache/oma-voice/setup.log") : installed == "" ? _("First use: writes the voice and dictation programs to ~/.local and downloads edge-tts for online speech.") : _("The programs have an update; install it to continue.")
  source service = cmd("if [ -f ~/.local/share/oma-voice/oma_voice.py ]; then python ~/.local/share/oma-voice/oma_voice.py ensure; fi") every 30s status
  source voice = file("~/.cache/oma-voice/state.json") json
  let offline = service.ok == false
  let replyTime = voice.reply_at == null ? _("Nothing to read yet") : _("Reply ${fmtTime(voice.reply_at, 'MM-dd HH:mm')}")
  let statusText = offline ? _("Service offline · tap Sync") : voice.awaiting ? _("Working · previous reply below") : voice.status_ui ?? _("Connecting…")
  state detailTab = "read"
  state actionPending = ""
  state actionResult = ""
  on actionResult { actionPending = "" }
  onTap: screen()
  Column {
    fill: true
    gap: 6
    if !ready {
      Text { text: _("TERMINAL VOICE"); style: label; color: accent }
      Text { text: setupText; style: small; maxLines: 8; weight: 1; color: setupState == "failed" ? red : muted }
      Button { fill: width; height: 40; text: installed == "" ? _("Set up") : _("Update"); onTap: run("""__SETUP_COMMAND__""") }
      Button { fill: width; height: 40; text: _("Details"); onTap: screen() }
    } else {
    Text { text: _("TERMINAL VOICE"); style: label; color: accent }
    Text { text: voice.source == "terminal" ? _("Source: ${voice.source_name ?? 'Terminal'}") : voice.source == "claude" ? _("Source: Claude chat") : _("Source: Codex chat"); style: small; color: accent }
    Text { text: statusText; style: small; maxLines: 2; color: offline ? yellow : muted }
    Text { text: replyTime; style: small; color: muted }
    Text { text: voice.summary == "" || voice.summary == null ? _("Choose a Codex chat or connect a tmux terminal.") : voice.summary; style: small; maxLines: 4; weight: 1 }
    Row {
      gap: 4
      Button { text: _("Play"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py replay") }
      Button { text: _("Stop"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py stop") }
    }
    Row {
      gap: 4
      Button { text: _("Sync"); weight: 1; height: 40; onTap: run("python ~/.local/share/oma-voice/oma_voice.py refresh") }
      Button { text: _("Details"); weight: 1; height: 40; onTap: screen() }
    }
    }
  }
  screen {
    title: (uiLanguage == "zh" ? "TERMINAL // 播報" : "TERMINAL // VOICE")
    Column {
      fill: true
      height: screenHeight
      gap: 10
      Row {
        gap: 8
        Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "播放與內容" : "Playback"); color: detailTab == "read" ? background : accent; background: detailTab == "read" ? accent : alpha(accent, 0); onTap: detailTab = "read" }
        Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "設定" : "Settings"); color: detailTab == "settings" ? background : accent; background: detailTab == "settings" ? accent : alpha(accent, 0); onTap: detailTab = "settings" }
      }
      Column {
        scroll: true
        fill: width
        height: max(1, screenHeight - 54)
        gap: 12
        Column {
          fill: width
          padding: 12
          border: 1
          borderColor: offline || (voice.error_ui ?? "") != "" ? yellow : border
          gap: 4
          if !ready { Text { text: (uiLanguage == "zh" ? "尚未安裝或需要更新：請返回首頁，在此小工具上按「安裝」。" : "Not set up yet: go back and tap Set up on the tile."); color: yellow; maxLines: 3 } }
          Text { text: actionPending != "" ? (uiLanguage == "zh" ? "處理中…" : "Working…") : statusText; color: offline ? yellow : accent; maxLines: 3 }
          if actionPending == "" && actionResult != "" && parseJson(actionResult).ok != true { Text { text: parseJson(actionResult).error_ui ?? (uiLanguage == "zh" ? "操作失敗" : "Action failed"); style: small; color: red; maxLines: 3 } }
          if (voice.error_ui ?? "") != "" { Text { text: voice.error_ui; style: small; color: red; maxLines: 5 } }
        }
        if detailTab == "read" {
        Text { text: (uiLanguage == "zh" ? "讀取來源" : "Read from"); style: small; color: muted }
        Row {
          gap: 6
          Button { weight: 1; height: 44; text: "Codex"; color: voice.source == "codex" ? background : accent; background: voice.source == "codex" ? accent : alpha(accent, 0); onTap: { actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source codex --json") } }
          Button { weight: 1; height: 44; text: "Claude"; color: voice.source == "claude" ? background : accent; background: voice.source == "claude" ? accent : alpha(accent, 0); onTap: { actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source claude --json") } }
          Button { weight: 1; height: 44; text: "tmux"; color: voice.source == "terminal" ? background : accent; background: voice.source == "terminal" ? accent : alpha(accent, 0); onTap: { actionPending = "source"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py source terminal --json") } }
        }
        if voice.source == "claude" {
          if voice.term_pane == "" || voice.term_pane == null {
            Text { text: (uiLanguage == "zh" ? "Claude 不在 tmux 中：語音輸入只能複製貼上" : "Claude is not in tmux: dictation can only be copied"); style: small; color: yellow; maxLines: 2 }
            Button { fill: width; height: 44; text: (uiLanguage == "zh" ? "在 tmux 開啟 Claude" : "Open Claude in tmux"); onTap: terminal("tmux new -A -s oma-voice 'claude; exec bash'", "Claude") }
          } else {
            Text { text: (uiLanguage == "zh" ? "Claude 在 tmux 中：語音輸入可直接送出" : "Claude is in tmux: dictation sends directly"); style: small; color: muted; maxLines: 2 }
          }
        } else if voice.source == "terminal" {
          Text { text: (uiLanguage == "zh" ? "讀取 ${voice.source_name ?? '終端'} 的畫面；在終端執行連接命令即可使用" : "Reads ${voice.source_name ?? 'the terminal'}'s screen; run the setup command in your terminal"); style: small; color: muted; maxLines: 2 }
          Button { fill: width; height: 44; text: (uiLanguage == "zh" ? "複製終端連接命令" : "Copy terminal setup command"); onTap: copy("tmux new -A -s oma-voice") }
        } else {
          Text { text: (voice.follow_latest ? (uiLanguage == "zh" ? "跟隨最近活動的對話" : "Following the latest active chat") : (uiLanguage == "zh" ? "已固定對話" : "Pinned chat")) + " · " + (voice.thread ?? (uiLanguage == "zh" ? "等待連接" : "waiting for connection")); style: small; color: muted; maxLines: 2 }
        }
        Row {
          gap: 6
          Button { weight: 1; height: 48; text: (uiLanguage == "zh" ? "▶ 摘要" : "▶ Summary"); color: background; background: accent; onTap: { actionPending = "play"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py replay --json") } }
          Button { weight: 1; height: 48; text: (uiLanguage == "zh" ? "▶ 全文" : "▶ Full"); onTap: { actionPending = "play"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py replay --full --json") } }
          Button { weight: 1; height: 48; text: (uiLanguage == "zh" ? "■ 停止" : "■ Stop"); onTap: { actionPending = "stop"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py stop --json") } }
        }
        Column {
          fill: width
          padding: 12
          border: 1
          borderColor: border
          gap: 10
          Row {
            align: center
            Column {
              weight: 1
              gap: 2
              Text { text: voice.source == "terminal" ? (uiLanguage == "zh" ? "終端畫面" : "Terminal screen") : (uiLanguage == "zh" ? "最近回覆" : "Latest reply"); bold: true; color: accent }
              if voice.reply_at != null { Text { text: fmtTime(voice.reply_at, 'MM-dd HH:mm'); style: small; color: muted } }
            }
            Button { width: 84; height: 36; text: (uiLanguage == "zh" ? "同步" : "Sync"); onTap: { actionPending = "sync"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py refresh --json") } }
            Button { width: 84; height: 36; text: (uiLanguage == "zh" ? "複製" : "Copy"); onTap: copy(voice.full ?? "") }
          }
          Text { text: voice.full == "" || voice.full == null ? (uiLanguage == "zh" ? "尚無可讀內容" : "Nothing to read yet") : (voice.full_view ?? voice.full); color: voice.full == "" || voice.full == null ? muted : foreground; maxLines: 160 }
        }
        }
        if detailTab == "settings" {
        Text { text: (uiLanguage == "zh" ? "播報" : "Reading"); bold: true; color: accent }
        if voice.source == "codex" { Button { fill: width; height: 44; text: voice.follow_latest ? (uiLanguage == "zh" ? "對話：自動跟隨最近的" : "Chat: follow latest") : (uiLanguage == "zh" ? "對話：固定目前的" : "Chat: pinned"); onTap: { actionPending = "follow"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py follow --json") } } }
        if voice.source != "terminal" { Button { fill: width; height: 44; text: voice.auto ? (uiLanguage == "zh" ? "自動播報：開" : "Auto-read: on") : (uiLanguage == "zh" ? "自動播報：關" : "Auto-read: off"); color: voice.auto ? background : accent; background: voice.auto ? accent : alpha(accent, 0); onTap: { actionPending = "auto"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py auto toggle --json") } } }
        Text { text: voice.source == "claude" ? (uiLanguage == "zh" ? "從 Claude 的對話記錄讀取已完成的回覆，在任何終端都可用。語音輸入只能送到在 oma-voice tmux 會話中執行的 Claude。" : "Reads Claude's finished replies from its chat log, in any terminal. Dictation can be sent only when Claude runs in the oma-voice tmux session.") : voice.source == "terminal" ? (uiLanguage == "zh" ? "在原本的終端執行 tmux new -A -s oma-voice，之後可在該視窗執行 Codex、Claude 或其他程式。播放會讀取目前畫面；語音輸入會送到這個窗格。" : "Run tmux new -A -s oma-voice in your existing terminal, then start Codex, Claude or another program there. Play reads the current screen; dictation sends to that pane.") : (uiLanguage == "zh" ? "正式回覆完成後自動更新；同步只更新文字，不會自動重播舊內容。" : "Completed replies update automatically. Sync refreshes text without replaying older replies."); style: small; color: muted; maxLines: 7 }
        Text { text: (uiLanguage == "zh" ? "聲音" : "Voice"); bold: true; color: accent }
        Row {
          gap: 8
          Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "自然人聲（線上）" : "Online voice"); color: voice.engine == "online" ? background : accent; background: voice.engine == "online" ? accent : alpha(accent, 0); onTap: { actionPending = "engine"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py engine online --json") } }
          Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "離線語音" : "Offline voice"); color: voice.engine == "offline" ? background : accent; background: voice.engine == "offline" ? accent : alpha(accent, 0); onTap: { actionPending = "engine"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py engine offline --json") } }
        }
        Text { text: voice.pause_minutes == 0 ? (uiLanguage == "zh" ? "閒置暫停：不暫停" : "Idle pause: never") : (uiLanguage == "zh" ? "閒置暫停：${voice.pause_minutes ?? 10} 分鐘" : "Idle pause: ${voice.pause_minutes ?? 10} min"); bold: true; color: accent }
        Row {
          gap: 8
          Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "10 分鐘" : "10 minutes"); color: voice.pause_minutes == 10 ? background : accent; background: voice.pause_minutes == 10 ? accent : alpha(accent, 0); onTap: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause 10 --json") } }
          Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "不暫停" : "Never"); color: voice.pause_minutes == 0 ? background : accent; background: voice.pause_minutes == 0 ? accent : alpha(accent, 0); onTap: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause off --json") } }
        }
        Input { placeholder: (uiLanguage == "zh" ? "自訂分鐘數（1–1440），輸入後送出" : "Custom minutes (1–1440), then send"); clear: true; onSubmit: { actionPending = "pause"; actionResult = ""; actionResult = run("python ~/.local/share/oma-voice/oma_voice.py pause ${sh(value)} --json") } }
        Text { text: (uiLanguage == "zh" ? "小工具離開畫面且 Codex 閒置時，服務才會依設定暫停；連接期間不會拖慢回覆。" : "Idle pause stops the service when the tile is off screen and Codex is inactive. It does not slow replies while connected."); style: small; color: muted; maxLines: 4 }
        }
      }
    }
  }
}
