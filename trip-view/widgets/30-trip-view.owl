// Trip View: animated pixel-art scenes for the omalauncher home screen, or one your terminal agent paints from a sentence.
// Copyright (C) 2026 WeeboWIZ. All scenes, characters and pixel art (C) 2026 WeeboWIZ.
// SPDX-License-Identifier: MIT
// Licensed under the MIT License; see LICENSE.
widget "trip view" {
  meta { owl: 7; description: "Animated pixel scene templates for your home screen. Describe a mood in one sentence and your agent generates an animated scene, which you can also set as your wallpaper."; version: "1.0"; license: "MIT"; category: "fun" }
  page: 3
  order: 1
  size: 6x6
  minSize: 2x2
  padding: 0

  // ~/.local/bin/pixbg 把通過本機檢查（編譯、AGSL 規則、GPU 運算量）的場景打包進 bundle.json。
  // 切換場景、語言都只改這裡的狀態，不跑程式，按下去馬上換；生成、刪除、設為桌布才交給 pixbg，
  // 它做完用 owl-send 設定 sel／langCode。
  source bundle = file("~/.cache/pixbg/bundle.json") json
  source ui = file("~/.cache/pixbg/ui.json") json
  source exp = file("~/.cache/pixbg/export.json") json
  source st = file("~/.cache/pixbg/status.json") json
  source walls = file("~/.cache/pixbg/walls.json") json
  // 兩個 agent CLI 裝了沒、登入了沒（pixbg agents 寫的）
  source agents = file("~/.cache/pixbg/agents.json") json
  source now = clock every 1s
  // 只用來算螢幕密度，讓角色的格子和 shader 的像素格一樣大
  source sys = android.system every 30m
  state sel = "05-ramen" persist
  state langCode = "" persist
  state zone = 0 persist
  state speed = 1 persist
  state wish = "" persist
  state sound = false persist
  state showClock = false persist
  state pet = true persist
  state tileClean = false persist
  state langWish = "" persist
  state panel = true
  state hiddenAt = 0
  state langOpen = false
  state poke = 0
  state copiedAt = 0
  // 刪除要按兩次：第一次記下要刪哪個場景、什麼時候按的，10 秒內在確認框按「確認刪除」才真的刪
  state delId = ""
  state delAt = 0

  // 目前的場景。設為桌布時 export.json 指定要畫哪一個、隱藏介面
  let list = bundle.scenes ?? []
  let exporting = exp.on == true
  let curIdx = max(0, list.map(x => x.id).indexOf(exporting && exp.id != null ? exp.id : sel))
  let cur = list[curIdx] ?? {}
  let total = len(list)
  let nextId = total > 0 ? list[(curIdx + 1) % total].id : sel
  let prevId = total > 0 ? list[(curIdx + total - 1) % total].id : sel
  // 預設與量測用的 shader 也要宣告 zone 與 speed：傳進不存在的 uniform 會在原生層出錯
  let blank = "uniform float zone; uniform float speed; uniform float cellpx; half4 main(float2 p) { return half4(0.0, 0.0, 0.0, 1.0); }"
  let probe = "uniform float zone; uniform float speed; uniform float cellpx; half4 main(float2 p) { return half4(1.0, 0.0, 1.0, 1.0); }"
  let code = exporting && exp.probe == true ? probe : cur.code ?? blank
  // 卡片縮圖要用每個場景代表性的那一幕：匯出時 export.json 可以指定配色組
  let zn = exporting && exp.zone != null ? exp.zone : zone

  // 語言：ui.json 裝著所有語言包（~/.local/share/pixbg/lang/*.json）
  let lc = langCode != "" ? langCode : ui.code ?? "en"
  let LP = get(ui.packs ?? {}, lc, null) ?? get(ui.packs ?? {}, "en", {})
  let T = LP.T ?? {}
  let latin = (LP.names ?? "zh") == "en"
  // 場景名只顯示一種語言（pixbg 把「VOID SPACE 虛空」拆成 en／zh）
  let nm = latin ? (cur.en ?? cur.name ?? "Trip View") : (cur.zh ?? cur.name ?? "Trip View")
  // 星期自己算（Sakamoto 公式），名稱用語言包的，不跟手機語系走
  let ymd = words(fmtTime(now, "yyyy M d"))
  let yy = num(ymd[1]) < 3 ? num(ymd[0]) - 1 : num(ymd[0])
  let wd = (yy + floor(yy / 4) - floor(yy / 100) + floor(yy / 400) + [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4][num(ymd[1]) - 1] + num(ymd[2])) % 7
  let dateShort = "${ymd[1]}/${ymd[2]} ${(LP.wd ?? [])[wd] ?? ""}"

  // 場景目前這組配色：時鐘、吉祥物、按鈕都用它，和背景是同一套顏色
  let P = cur.pal[zn] ?? {bg: "#101018", c0: "#2a2a40", c1: "#6a6a90", c2: "#e8e8ff", ac: "#ffd84a", ink: "#101018", lite: "#e8e8ff", fg: "#e8e8ff"}
  let mascot = cur.mascot ?? "ufo"

  // 進度：pixbg 給目前進度 p，以及 eta 秒內要推到的 to（等 agent 時只知道大概要多久）
  // 生成時 pixbg 每幾秒更新 beat：超過 45 秒沒更新就是行程死了，別一直顯示忙碌
  let alive = st.job == "gen" ? (st.beat ?? st.t) > now - 45 : st.t > now - 900
  let busy = st.state == "working" && alive
  let stalled = st.state == "working" && st.job == "gen" && !alive && st.t > now - 3600
  let pct = busy ? clamp(st.p + (st.to - st.p) * min(1, (now - st.since) / max(st.eta, 1)), 0, 1) : 0
  let elapsed = max(0, now - (st.started ?? now))
  let jobName = st.job == "wall" ? T.setWall : T.aiGen
  let fresh = st.t > now - 12
  let doneMsg = fresh && st.state == "done" ? "✓ ${st.msg}" : fresh && st.state == "error" ? "✕ ${st.msg}" : ""
  // 目前選的 agent 的狀態；不能用時給使用者一行可以複製到終端的指令
  let agentId = ui.agent ?? "claude"
  let agentInfo = (agents.list ?? []).find(x => x.id == agentId) ?? {}
  let genErr = st.job == "gen" && st.state == "error" && st.t > now - 1800
  let fixCmd = genErr && (st.fix ?? "") != "" ? st.fix : agentInfo.ok == false ? (agentInfo.fix ?? "") : ""
  // 開全螢幕頁時，agent 狀態超過 10 分鐘就重查（背景跑，一兩秒）
  let probeStale = now - (agents.t ?? 0) > 600
  // 刪除確認框：只在 10 秒內、還是同一個場景時出現
  let delAsking = delId == cur.id && now - delAt < 10
  let reacting = now - poke < 3

  // 一個像素格（shader 的 PX）有多少 dp：手機像素 ÷ 密度
  let dens = (sys.display.width ?? 1080) / max(screenWidth ?? 411.43, 1)
  let W = tileWidth ?? 360
  let H = tileHeight ?? 360
  let tiny = cols <= 2 || rows <= 1
  let big = cols >= 4 && rows >= 4
  let pad = tiny ? 8 : 12
  let clockPx = clamp(floor(min((cols >= 4 && rows <= 3 ? W * 0.42 : W * 0.62) / 19, H * (tiny ? 0.3 : 0.32) / 7)), 2, 10)
  let mascotPx = clamp(floor(min(W, H) / (tiny || rows <= 2 ? 30 : 46)), 2, 5)
  let tileCell = max(2, floor(W * dens / 216)) / dens
  // 全螢幕頁滿版（照 AlienGo 的 bleed，見 70-aliengo.owl 的 Scene）：背景在繪製時放大 k 倍、位移到螢幕中心，蓋住啟動器的標題列與外框。
  // 放大前每格 fullCell / k 個像素，放大後剛好整數 fullCell 個，和真正的全螢幕一樣對齊。匯出（桌布、縮圖）時不放大。
  let sb = ui.screen
  let bleed = sb != null && !exporting
  let bw = sb != null ? sb.box[2] - sb.box[0] : 1
  let bh = sb != null ? sb.box[3] - sb.box[1] : 1
  let bk = bleed ? max(sb.size[0] / bw, sb.size[1] / bh) + 0.004 : 1
  let fullCell = sb != null ? max(2, floor(sb.size[0] / 216)) : 2
  let bleedCell = bleed ? fullCell / bk : 0
  let bleedOff = bleed ? [(sb.size[0] / 2 - (sb.box[0] + sb.box[2]) / 2) / dens, (sb.size[1] / 2 - (sb.box[1] + sb.box[3]) / 2) / dens] : [0, 0]
  let screenCell = bleed ? bleedCell / dens : max(2, floor((screenWidth ?? 411.43) * dens / 216)) / dens

  // 「自定義語言」：給使用者的 agent 的提示詞
  let langTarget = trim(langWish) == "" ? "<the language you want>" : trim(langWish)
  let langPromptA = """Add an interface language to Trip View (its tool is pixbg), a home-screen widget of omalauncher (an Android launcher whose widgets are OWL files; docs: ~/.config/omalauncher/widgets/README.md).

Language to add: """
  let langPromptB = """

How its languages work:
- Language packs are ~/.local/share/pixbg/lang/<code>.json. en.json is the base English pack; copy it to add any language, including Traditional Chinese (zh). Each pack has:
  - "name": the language's own name, shown on its button
  - "names": "en" or "zh". Built-in scene names are bilingual ("VOID SPACE 虛空"); this picks the half to show: "zh" for languages written in Chinese characters, otherwise "en".
  - "wd": 7 short weekday names, Sunday first
  - "T": the widget's labels
  - "msg": progress messages the pixbg tool writes
- pixbg lang <code> switches to a pack and lists strings it is missing; pixbg langs lists the packs; pixbg preview asks the phone to redraw the widget and prints the full-screen PNG.

Steps:
1. Pick a BCP-47 code (ja, ko, es, pt-BR …), written <code> below.
2. Copy en.json to <code>.json and translate every value of "name", "wd", "T" and "msg". Keep the keys, every {placeholder}, and symbols such as ◀ ▶ ✦ ● ＋ ✓. Keep labels short: buttons are narrow (about 8 CJK or 14 Latin characters; "gen" and "zone" about 4).
3. Run pixbg lang <code>, then pixbg preview, and open the PNG it prints. Check that no text is cut off and shorten translations where it is.
4. Change nothing else (not the widget file, the scenes or the tool): Trip View picks the pack up by itself and lists it under Language.
"""
  // 三引號字串不代入 ${}，所以語言名稱用串接放進去
  let langPrompt = langPromptA + langTarget + "\n\n" + langPromptB

  // 3×5 像素字型
  let FONT = {
    "0": ["aaa", "a.a", "a.a", "a.a", "aaa"], "1": [".a.", "aa.", ".a.", ".a.", "aaa"],
    "2": ["aaa", "..a", "aaa", "a..", "aaa"], "3": ["aaa", "..a", ".aa", "..a", "aaa"],
    "4": ["a.a", "a.a", "aaa", "..a", "..a"], "5": ["aaa", "a..", "aaa", "..a", "aaa"],
    "6": ["aaa", "a..", "aaa", "a.a", "aaa"], "7": ["aaa", "..a", ".a.", ".a.", ".a."],
    "8": ["aaa", "a.a", "aaa", "a.a", "aaa"], "9": ["aaa", "a.a", "aaa", "..a", "aaa"],
    ":": [".", "a", ".", "a", "."]
  }
  let hhmm = fmtTime(now, "HH:mm")
  let clockArt = range(5).map(r => join(range(len(hhmm)).map(i => get(FONT, sub(hhmm, i, i + 1), FONT["0"])[r]), "."))

  // 吉祥物：每個場景一隻，字母是顏色角色（a 亮色 c 主色 x 對比色 w 白 k 暗 m 金屬 y 黃 r 紅 d 閃燈 g 呼吸光）
  let MASCOTS = {
    ufo: [".....aaa.....", "....awwaa....", "...aaaaaaa...", ".mmmmmmmmmmm.", "mmdmmdmmdmmdm", ".kmmmmmmmmmk.", "...k.....k..."],
    car: ["....aaaaa.....", "...aawaaaa....", ".xxxxxxxxxxxx.", "wxxxxxxxxxxxxr", ".kkxxxxxxxxkk.", "..dd......dd.."],
    star: [".....y.....", "....yyy....", "yyyyyyyyyyy", ".yykyyykyy.", "..yyyrryy..", "..yyy.yyy..", ".yy.....yy."],
    firefly: [".w.....w.", "..w...w..", "...ccc...", "..cwcwc..", "..ccccc..", "..ggggg..", "...ggg..."],
    sentinel: ["...ccccc...", "..ccccccc..", ".cckkrkkcc.", ".ccccccccc.", "..c.c.c.c..", ".c.c.c.c.c.", "c.c.c.c.c.."]
  }

  component PixelClock(px = 6) {
    Canvas {
      width: 19 * px
      height: 7 * px
      // 亮色字、墨色外框（pixbg 從場景配色算出來），淺色深色場景都看得清楚
      for o in [[0, 1], [2, 1], [1, 0], [1, 2], [2, 2]] {
        sprite(clockArt, o[0] * px, o[1] * px, px, palette: {a: P.ink ?? P.bg})
      }
      sprite(clockArt, px, px, px, palette: {a: P.lite ?? P.c2})
    }
  }

  component Mascot(px = 4) {
    Canvas {
      width: 16 * px
      height: 12 * px
      onTap: { poke = now; haptic(); run(sound ? (mascot == "ufo" ? "paplay ~/.cache/pixbg/sfx/beam.wav" : "paplay ~/.cache/pixbg/sfx/boing.wav") : "true") }
      let blink = sin(time * 4) > 0
      let hop = reacting ? abs(sin(time * 9)) * 3 * px : 0
      let bob = round(sin(time * 2) * px * 0.8)
      let x0 = 2 * px
      let y0 = 2 * px + bob - hop
      // 被點到：UFO 放出牽引光束，其他的跳一跳、冒星星
      if reacting && mascot == "ufo" {
        path([[x0 + 4 * px, y0 + 6 * px], [x0 + 9 * px, y0 + 6 * px], [x0 + 12 * px, 12 * px], [x0 + px, 12 * px]], closed: true, fill: alpha(P.c2, 0.35))
      }
      sprite(MASCOTS[mascot] ?? MASCOTS.ufo, x0, y0, px, palette: {
        a: P.c2, c: P.c1, x: P.ac, w: "#ffffff", k: "#151520", m: "#c9cde0", y: "#ffe46a", r: "#ff3a4a",
        d: blink ? P.ac : P.c0, g: mix(P.ac, P.c2, sin(time * 1.5) * 0.5 + 0.5)
      })
      if reacting {
        for i in range(5) {
          let a = time * 3 + i * 1.256
          let r = 5 * px + sin(time * 5 + i) * px
          rect(x0 + 6 * px + sin(a) * r, y0 + 3 * px - cos(a) * r * 0.6, px, px, fill: i % 2 == 0 ? P.ac : "#ffffff")
        }
      }
    }
  }

  component Chip(label, tint = foreground, lines = 1) {
    Text { text: label; color: tint; font: mono; style: small; maxLines: lines; padding: [8, 4]; background: alpha(background, 0.8) }
  }

  component ProgressPanel(compact = false) {
    Column {
      fill: width
      gap: 5
      padding: compact ? [8, 6] : [10, 8]
      background: alpha(background, 0.85)
      if compact {
        Text { text: "${jobName} ${round(pct * 100)}% · ${st.msg}"; style: small; color: P.ac; maxLines: 1 }
      } else {
        Row {
          gap: 6
          Text { text: "${jobName} · ${round(pct * 100)}%"; style: small; bold: true; color: P.ac; weight: 1; maxLines: 1 }
          Text { text: fmtDuration(elapsed); style: small; color: muted; width: 64; align: end }
        }
      }
      Progress { value: pct * 100; color: P.ac; fill: width; height: compact ? 5 : 8 }
      if !compact { Text { text: st.msg; style: small; color: foreground; maxLines: 2 } }
    }
  }

  // ---------------------------------------------------------------- 像素 UI（照 AlienGo 的做法）
  // 按鈕畫在 Canvas 裡：兩階切角、深色外框、亮的上緣、2 單位的厚邊；選中時用場景的對比色發光，
  // shine 時掃過一道光（只有它讀 time）。組件不能在使用處掛 onTap，所以每顆都包在有 onTap 的 Box 裡。
  let ink = "#06080c"
  let slab = "#263043"
  let glass = alpha("#0c111a", 0.86)
  let soft = "#b4bed2"
  let good = "#7dff8a"
  component PixelBtn(label, tone = "#5ef0ff", on = false, dim = false, h = 56, size = 15, shine = false, pad = 12) {
    Box {
      height: h
      fill: width
      align: center
      Canvas {
        fill: true
        let u = 3
        let m = 2 * u
        let x = m
        let y = m
        let w = width - 2 * m
        let bh = height - 2 * m
        let face = on ? tone : dim ? "#141a25" : slab
        let top = on ? mix(tone, "#ffffff", 0.4) : dim ? "#19202c" : "#3a4864"
        let lip = on ? mix(tone, "#000000", 0.55) : "#0a0e15"
        if on && !dim {
          rect(u, 0, width - 2 * u, height, fill: alpha(tone, 0.10))
          rect(0, u, width, height - 2 * u, fill: alpha(tone, 0.10))
          rect(2 * u, u, width - 4 * u, height - 2 * u, fill: alpha(tone, 0.16))
        }
        rect(x + 2 * u, y, w - 4 * u, bh, fill: ink)
        rect(x + u, y + u, w - 2 * u, bh - 2 * u, fill: ink)
        rect(x, y + 2 * u, w, bh - 4 * u, fill: ink)
        rect(x + 2 * u, y + u, w - 4 * u, bh - 2 * u, fill: lip)
        rect(x + u, y + 2 * u, w - 2 * u, bh - 4 * u, fill: lip)
        rect(x + 2 * u, y + u, w - 4 * u, bh - 4 * u, fill: linear(0, y, 0, y + bh - 3 * u, [top, face]))
        rect(x + u, y + 2 * u, w - 2 * u, bh - 6 * u, fill: linear(0, y, 0, y + bh - 3 * u, [top, face]))
        rect(x + 2 * u, y + u, w - 4 * u, u, fill: alpha("#ffffff", on ? 0.55 : dim ? 0.04 : 0.16))
        rect(x + 2 * u, y + 2 * u, u, u, fill: alpha("#ffffff", on ? 0.6 : 0.2))
        if !on && !dim { rect(x + 3 * u, y + bh - 3 * u, w - 6 * u, u, fill: alpha(tone, 0.6)) }
        if shine {
          let f = (time * 0.7) % 1.4
          clip(x + u, y + u, w - 2 * u, bh - 4 * u) {
            let sx = x - 40 + f * (w + 80)
            path([[sx, y], [sx + 18, y], [sx + 6, y + bh], [sx - 12, y + bh]], closed: true, fill: alpha("#ffffff", 0.35))
          }
        }
      }
      Text { text: label; align: center; font: mono; bold: true; fontSize: size; maxLines: 2; padding: [pad, 0]; offset: [0, -2]
        color: on ? "#071016" : dim ? "#5d687c" : "#eef3fa" }
    }
  }
  // HUD 卡片標題：實心的標籤，接一條細線
  component HudHead(tag, tone = "#5ef0ff", meta = "", w = 0) {
    Row {
      gap: 8
      align: center
      Text { text: tag; font: mono; bold: true; style: small; color: "#071016"; background: tone; padding: [8, 2]; width: w > 0 ? w : len(tag) * (latin ? 10 : 15) + 22 }
      Spacer { weight: 1; height: 2; background: alpha(tone, 0.35) }
      if meta != "" { Text { text: meta; font: mono; style: small; color: soft; width: 150; align: end; maxLines: 1 } }
    }
  }
  // 分段的量表，像遊戲的血條
  component PixelMeter(value, tone = "#5ef0ff", segs = 16, slot = "#1a2130") {
    Canvas {
      height: 12
      fill: width
      let gap = 3
      let sw = (width - gap * (segs - 1)) / segs
      let lit = round(clamp(value, 0, 1) * segs)
      for k in range(segs) {
        rect(k * (sw + gap), 0, sw, height, fill: k < lit ? tone : slot)
        if k < lit { rect(k * (sw + gap), 0, sw, 3, fill: alpha("#ffffff", 0.35)) }
      }
    }
  }
  // 配色色票：上半是天空（bg→c2），下半是對比色；選中的有亮框
  component Swatch(z, on) {
    Canvas {
      fill: true
      let u = 3
      rect(0, 0, width, height, fill: on ? z.ac : ink)
      rect(u, u, width - 2 * u, height - 2 * u, fill: ink)
      let iw = width - 4 * u
      let ih = height - 4 * u
      for k, i in [z.bg, z.c0, z.c1, z.c2] {
        rect(2 * u + i * iw / 4, 2 * u, iw / 4 + 0.5, ih * 0.62, fill: k)
      }
      rect(2 * u, 2 * u + ih * 0.62, iw, ih * 0.38, fill: z.ac)
    }
  }
  // ---------------------------------------------------------------- 角色層
  // 場景附的 <場景>.actors.json：美術（sprite 字母圖）＋ 每一幕（配色組）的演出。位置是畫面比例：
  // x 是角色中線、y 是腳底，[基準, 振幅, 頻率, 相位]。座標都對齊 shader 的像素格。
  component Actors(cw = 2) {
    Canvas {
      fill: true
      let A = cur.actors ?? {}
      let art = A.art ?? {}
      let tt = time * max(speed, 0)
      let live = (A.acts ?? []).filter(a => (a.zones ?? [zn]).indexOf(zn) >= 0 && get(art, a.toy, null) != null)
      let s1 = live.map(a => {a: a, g: get(art, a.toy, {}), cp: cw * (get(art, a.toy, {}).cell ?? 1)})
      let s2 = s1.map(o => {
        id: o.a.id, g: o.g, cp: o.cp, wire: o.a.wire == true, sink: o.a.sink ?? 0,
        cx: width * (o.a.x[0] + o.a.x[1] * sin(tt * o.a.x[2] + o.a.x[3])),
        by: height * (o.a.y[0] + o.a.y[1] * sin(tt * o.a.y[2] + o.a.y[3])),
        up: (o.a.hop != null ? abs(sin(tt * o.a.hop[1])) * o.a.hop[0] : 0) - (o.a.dip != null && tt % o.a.dip[0] > o.a.dip[1] && tt % o.a.dip[0] < o.a.dip[2] ? sin((tt % o.a.dip[0] - o.a.dip[1]) / (o.a.dip[2] - o.a.dip[1]) * 3.1416) * o.a.dip[3] : 0),
        fr: o.a.keys != null ? last(o.a.keys.filter(k => k[0] <= tt % o.a.cycle))[1] : o.a.seq[floor(tt * (o.a.fps ?? 0)) % len(o.a.seq)]
      })
      let P2 = s2.map(o => {
        id: o.id, g: o.g, cp: o.cp, wire: o.wire, fr: o.fr,
        x0: round(o.cx / o.cp - o.g.ox) * o.cp,
        y0: round(o.by / o.cp - (o.g.h - o.sink) - o.up) * o.cp
      })
      for o in P2 {
        // 片場感：飛的東西頭上都吊著一條鋼絲
        if o.wire { line(o.x0 + o.g.ox * o.cp, 0, o.x0 + o.g.ox * o.cp, o.y0, stroke: alpha("#e8e8f0", 0.4), width: 1) }
        sprite(o.g.frames[o.fr] ?? o.g.frames[0], o.x0, o.y0, o.cp, palette: o.g.pal)
      }
      for f in (A.fx ?? []).filter(f => (f.zones ?? [zn]).indexOf(zn) >= 0) {
        let ph = f.cycle != null ? tt % f.cycle : 0
        let ref = f.from ?? f.a ?? f.at
        let pa = P2.find(o => o.id == ref[0])
        if (f.on == null || ph >= f.on[0] && ph < f.on[1]) && pa != null {
          let u = f.on != null ? (ph - f.on[0]) / (f.on[1] - f.on[0]) : 0
          let ax = pa.x0 + ref[1] * pa.cp
          let ay = pa.y0 + ref[2] * pa.cp
          let w = (f.width ?? 2) * cw
          if f.type == "beam" {
            // 往天上掃的光線：外層彩色、芯是白的
            let ang = rad(f.angle[0] + f.angle[1] * sin((ph - f.on[0]) * f.angle[2]))
            let ex = ax + cos(ang) * height * f.len
            let ey = ay + sin(ang) * height * f.len
            line(ax, ay, ex, ey, stroke: f.color, width: w * 2)
            line(ax, ay, ex, ey, stroke: "#ffffff", width: w * 0.7)
            circle(ax, ay, w * 1.6, fill: f.color)
          }
          if f.type == "puffs" {
            // 揚沙、排氣：一串小方塊往後飄、變大、變淡
            for i in range(f.n ?? 4) {
              let pu = (tt / f.life + i / (f.n ?? 4)) % 1
              let sz = cw * (f.size ?? 1) * (1 + pu * 1.5)
              layer(1 - pu) { rect(round((ax + pu * f.life * f.dx * width) / cw) * cw, round((ay + pu * f.life * f.dy * height) / cw) * cw, sz, sz, fill: f.color) }
            }
          }
          if f.type == "glow" {
            // 一圈光暈，隨著時間微微脹縮
            layer((f.alpha ?? 0.4) * (0.85 + 0.15 * sin(tt * 3))) { circle(ax, ay, (f.r ?? 6) * cw * (0.95 + 0.05 * sin(tt * 5)), fill: f.color) }
          }
          if f.type == "cone" {
            // 往前打的光束：一個朝右張開的扇形
            let ln = width * f.len
            layer(f.alpha ?? 0.25) { path([[ax, ay], [ax + ln, ay - ln * f.spread], [ax + ln, ay + ln * f.spread]], closed: true, fill: f.color) }
          }
          if f.type == "sparks" {
            for i in range(5) {
              let a = i * 1.26 + tt * 2
              rect(round((ax + cos(a) * f.r * cw) / cw) * cw, round((ay + sin(a) * f.r * cw * 0.8) / cw) * cw, cw * 2, cw * 2, fill: i % 2 == 0 ? f.color : "#ffffff")
            }
          }
          if f.type == "link" || f.type == "clash" {
            let pb = P2.find(o => o.id == f.b[0])
            if pb != null {
              let bx = pb.x0 + f.b[1] * pb.cp
              let by = pb.y0 + f.b[2] * pb.cp
              if f.type == "link" {
                // 光彈：一小段沿著 a→b 飛過去
                line(lerp(ax, bx, u), lerp(ay, by, u), lerp(ax, bx, min(1, u + 0.12)), lerp(ay, by, min(1, u + 0.12)), stroke: f.color, width: w)
              } else {
                // 對轟：兩道光線在中間頂著，交會點來回推擠，最後被 b 推回 a
                let m = clamp(0.5 + 0.2 * sin(tt * 2.6) - 0.3 * clamp((u - 0.7) / 0.3, 0, 1), 0.1, 0.9)
                let mx = lerp(bx, ax, m)
                let my = lerp(by, ay, m)
                line(ax, ay, mx, my, stroke: f.color, width: w * 2)
                line(bx, by, mx, my, stroke: f.color2 ?? f.color, width: w * 1.6)
                line(ax, ay, mx, my, stroke: "#ffffff", width: w * 0.6)
                circle(mx, my, w * (2.2 + floor(tt * 6) % 2), fill: "#ffffff")
              }
            }
          }
        }
      }
    }
  }

  // 場景卡片：縮圖（pixbg thumbs 請手機畫的）、標籤、名稱條；選中的外框發光並標「遊玩中」
  component SceneCard(x, on) {
    Column {
      gap: 0
      border: 3
      radius: 0
      borderColor: on ? P.ac : ink
      background: ink
      Box {
        height: 112
        fill: width
        clip: true
        if x.thumb != null {
          Image { src: x.thumb; fill: true; fit: cover }
        } else {
          // 還沒有縮圖：用場景的配色畫幾條色帶
          Canvas {
            fill: true
            let zp = (x.pal ?? [])[0] ?? {}
            for k, i in [zp.bg ?? ink, zp.c0 ?? slab, zp.c1 ?? slab, zp.c2 ?? soft] {
              rect(0, i * height / 4, width, height / 4 + 1, fill: k)
            }
          }
          Text { text: T.noThumb ?? ""; style: small; color: soft; align: center; padding: [0, 44] }
        }
        Column {
          fill: true
          padding: 6
          if x.kind == "ai" {
            Row {
              Text { text: T.tag_ai ?? "Agent"; font: mono; style: small; bold: true; color: "#071016"; background: "#ff7ad9"; padding: [6, 1]; width: len(T.tag_ai ?? "Agent") * (match(T.tag_ai ?? "Agent", "^[ -~]+$") != null ? 9.5 : 14) + 14 }
              Spacer { weight: 1 }
            }
          }
          Spacer { weight: 1 }
          if on { Row { Text { text: T.playing; font: mono; style: small; bold: true; color: "#071016"; background: P.ac; padding: [6, 1]; width: len(T.playing ?? "") * (match(T.playing ?? "", "^[ -~]+$") != null ? 9.5 : 14) + 16 }  Spacer { weight: 1 } } }
        }
      }
      Text { text: "${x.kind == "ai" ? "✦ " : ""}${latin ? (x.en ?? x.name) : (x.zh ?? x.name)}"; font: mono; bold: true; style: small; maxLines: 1; padding: [8, 6]; fill: width; color: on ? "#071016" : "#eef3fa"; background: on ? P.ac : slab }
    }
  }

  // 卡片：深色玻璃，場景從後面透出來
  let cardEdge = alpha(P.ac, 0.35)

  onTap: { panel = true; screen(); run(probeStale ? "~/.local/bin/pixbg agents" : "true") }

  Box {
    fill: true
    Shader { fill: true; fallback: background; uniforms: { zone: zn, speed: speed, cellpx: 0 }; code: code }
    if cur.actors != null { Actors { cw: tileCell } }
    if tileClean { Column { fill: true; onTap: { tileClean = false; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") } } }
    Column {
      fill: true
      padding: pad
      gap: 6
      Row {
        gap: 6
        align: top
        if showClock {
          Column {
            weight: 1
            gap: 2
            PixelClock { px: clockPx }
            if rows >= 2 && !tiny { Text { text: dateShort; style: small; bold: true; color: P.fg ?? P.c2; padding: [clockPx, 0] } }
          }
        } else {
          Spacer { weight: 1 }
        }
        if !tiny && pet { Mascot { px: mascotPx } }
      }
      Spacer { weight: 1 }
      if tiny && pet {
        Row { Spacer { weight: 1 }  Mascot { px: mascotPx } }
      }
      if busy && !tileClean {
        ProgressPanel { compact: !big }
      } else if !tileClean {
        if doneMsg != "" && !tiny { Chip { label: doneMsg; tint: st.state == "error" ? red : green; lines: 2 } }
        if doneMsg == "" && !tiny && rows >= 3 {
          Row {
            Chip { label: nm; tint: P.ac; width: min(W - pad * 2, len(nm) * (latin ? 9 : 15) + 22) }
            Spacer { weight: 1 }
          }
        }
      }
      if big && !tileClean {
        Row {
          gap: 2
          Box { weight: 1; onTap: { sel = prevId; run(sound ? "paplay ~/.cache/pixbg/sfx/prev.wav" : "true") }; PixelBtn { label: "◀"; tone: P.ac; h: 46; size: 13; pad: 2 } }
          Box { weight: 1; onTap: { sel = nextId; run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true") }; PixelBtn { label: "▶"; tone: P.ac; h: 46; size: 13; pad: 2 } }
          Box { weight: 1; onTap: { zone = (zone + 1) % 5; run(sound ? "paplay ~/.cache/pixbg/sfx/zone.wav" : "true") }; PixelBtn { label: "${T.zone} ${zone + 1}"; tone: P.ac; h: 46; size: 12; pad: 2 } }
          Box { weight: 1; onTap: { tileClean = true; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true") }; PixelBtn { label: T.tileHide; tone: P.ac; h: 46; size: 12; pad: 2 } }
          Box { weight: 1; onTap: { panel = true; screen(); run(probeStale ? "~/.local/bin/pixbg agents" : "true") }; PixelBtn { label: T.gen; tone: P.ac; on: true; h: 46; size: 12; pad: 2 } }
        }
      }
    }
  }

  screen {
    title: ""
    Box {
      width: screenWidth ?? 400
      height: screenHeight ?? 720
      Shader { fill: true; fallback: background; uniforms: { zone: zn, speed: speed, cellpx: bleedCell }; code: code; scale: bk; offset: bleedOff }
      if cur.actors != null { Actors { cw: screenCell; scale: bk; offset: bleedOff } }
      if panel && !exporting {
        Column {
          fill: width
          height: screenHeight ?? 720
          scroll: true
          gap: 14
          padding: [16, 64, 16, 14]

          // ---------------------------------------------- HUD：場景、時鐘、吉祥物
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: "TRIP VIEW"; w: 104; tone: P.ac; meta: "${T.scene} ${curIdx + 1}/${total}" }
            Row {
              align: center
              gap: 8
              Column {
                weight: 1
                gap: 6
                Text { text: nm; style: title; bold: true; color: "#eef3fa"; maxLines: 2 }
                if showClock {
                  PixelClock { px: 7 }
                  Text { text: "${ymd[0]}/${dateShort}"; style: small; color: soft }
                }
              }
              if pet { Mascot { px: 7 } }
            }
            Row {
              gap: 8
              Box { weight: 1; onTap: { sel = prevId; run(sound ? "paplay ~/.cache/pixbg/sfx/prev.wav" : "true") }; PixelBtn { label: T.prev; tone: P.ac } }
              Box { weight: 1; onTap: { sel = nextId; run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true") }; PixelBtn { label: T.next; tone: P.ac } }
            }
            // 刪除放在場景名旁邊：只對目前這個 Agent 場景，按鈕寫明場景名；確認框只在 10 秒內、而且還是同一個場景時出現
            if cur.kind == "ai" {
              if !delAsking {
                Box { fill: width; onTap: { delId = cur.id; delAt = now; haptic() }; PixelBtn { label: replace(T.delThis ?? "{n}", "{n}", nm); tone: "#ff6a6a"; h: 46; size: 13 } }
              } else {
                Column {
                  fill: width; gap: 8; padding: [12, 10]; background: "#1a0a0e"; border: 2; radius: 0; borderColor: "#ff6a6a"
                  Text { text: replace(T.delAsk ?? "{n}", "{n}", nm); bold: true; color: "#ffb4b4"; maxLines: 2 }
                  Text { text: T.delWarn; style: small; color: soft; maxLines: 3 }
                  Row {
                    gap: 8
                    Box { weight: 1; onTap: { delId = "" }; PixelBtn { label: T.keep; tone: P.ac; h: 46; size: 13 } }
                    Box { weight: 1; onTap: { delId = ""; run(sound ? "paplay ~/.cache/pixbg/sfx/error.wav" : "true"); run("~/.local/bin/pixbg del ${sh(cur.id)}") }; PixelBtn { label: T.delYes; on: true; tone: "#ff6a6a"; h: 46; size: 13 } }
                  }
                }
              }
            }
            if fresh && st.job == "del" && st.state == "done" { Text { text: "✓ ${st.msg}"; style: small; color: good; maxLines: 1 } }
          }

          // ---------------------------------------------- Agent 生成動畫（醒目的大卡片）
          Column {
            fill: width; gap: 10; padding: [16, 14]; background: alpha("#0c111a", 0.92); border: 3; radius: 0
            borderColor: busy && st.job == "gen" ? mix(P.ac, "#ffffff", 0.5 + 0.5 * sin(now * 2)) : P.ac
            Text { text: T.aiTitle; style: title; bold: true; color: P.ac }
            Text { text: T.aiDesc; style: small; color: soft; maxLines: 3 }
            Row {
              gap: 8
              for a in [["codex", "Codex"], ["claude", "Claude"]] {
                let ai = (agents.list ?? []).find(x => x.id == a[0]) ?? {}
                let tag = ai.state == "ready" ? T.agentReady : ai.state == "login" ? T.agentLogin : ai.state == "missing" ? T.agentMissing : T.agentUnknown
                Column {
                  weight: 1; gap: 4
                  onTap: { run(busy ? "true" : "~/.local/bin/pixbg agent ${sh(a[0])}") }
                  PixelBtn { label: a[1]; on: agentId == a[0]; dim: busy || ai.ok == false; tone: P.ac; h: 44; size: 14 }
                  Text { text: ai.version != null && ai.version != "" && ai.ok ? "${tag} · v${ai.version}" : tag; font: mono; style: small; color: ai.ok ? good : ai.state == null ? soft : "#ffb04a"; align: center; fill: width; maxLines: 1 }
                }
              }
            }
            if fixCmd != "" {
              Column {
                fill: width; gap: 6; padding: [10, 8]; background: "#0a0e15"; border: 1; radius: 0; borderColor: alpha("#ffb04a", 0.6)
                Text { text: T.runThis; style: small; color: soft; maxLines: 2 }
                Row {
                  gap: 8
                  Text { text: "$ ${fixCmd}"; font: mono; style: small; color: "#ffd84a"; weight: 1; maxLines: 2 }
                  Box { width: 92; onTap: { copy(fixCmd); copiedAt = now; haptic() }; PixelBtn { label: now - copiedAt < 3 ? T.copied : T.copyCmd; tone: "#ffb04a"; h: 38; size: 12; pad: 4 } }
                }
                Box { fill: width; onTap: run("~/.local/bin/pixbg agents"); PixelBtn { label: T.recheck; tone: "#ffb04a"; h: 38; size: 12 } }
              }
            } else {
              Text { text: T.agentHelp; style: small; color: soft; maxLines: 3 }
            }

            Input { fill: width; height: 52; padding: [12, 0]; background: "#0a0e15"; border: 2; radius: 0; borderColor: alpha(P.ac, 0.7); placeholder: T.hint; text: wish; onChange: wish = value; onSubmit: { wish = value; run(sound && !busy ? "paplay ~/.cache/pixbg/sfx/gen.wav" : "true"); run(trim(value) == "" || busy ? "true" : "~/.local/bin/pixbg gen ${sh(trim(value))}") } }
            Text { text: T.ideas; font: mono; style: small; color: soft }
            Flow {
              gap: 6
              for idea in LP.ideas ?? [] {
                Text { text: idea; style: small; color: "#eef3fa"; background: slab; padding: [10, 6]; border: 1; radius: 0; borderColor: alpha(P.ac, 0.4); maxLines: 1; width: min((screenWidth ?? 400) - 64, len(idea) * (match(idea, "^[ -~]+$") != null ? 7.5 : 13.5) + 24); onTap: { wish = idea; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") } }
              }
            }
            Box {
              fill: width
              onTap: { run(sound && trim(wish) != "" && !busy ? "paplay ~/.cache/pixbg/sfx/gen.wav" : "true"); run(trim(wish) == "" || busy ? "true" : "~/.local/bin/pixbg gen ${sh(trim(wish))}") }
              PixelBtn { label: busy && st.job == "gen" ? "${T.generating} ${round(pct * 100)}%" : T.genNew; on: !busy; dim: busy; shine: trim(wish) != "" && !busy; tone: P.ac; h: 64; size: 17 }
            }
            if busy && st.job == "gen" {
              PixelMeter { value: pct; tone: P.ac }
              Row {
                Text { text: st.msg; style: small; color: "#eef3fa"; weight: 1; maxLines: 2 }
                Text { text: fmtDuration(elapsed); font: mono; style: small; color: soft; width: 70; align: end }
              }
              Box { fill: width; onTap: run("~/.local/bin/pixbg cancel"); PixelBtn { label: T.cancel; tone: "#ff6a6a"; h: 40; size: 12 } }
            }
            if stalled || (genErr && fixCmd == "") {
              Row {
                gap: 8
                Text { text: stalled ? T.stalled : "✕ ${st.msg}"; style: small; color: "#ff6a6a"; weight: 1; maxLines: 3 }
                Box { width: 120; onTap: { wish = st.wish ?? wish; run("~/.local/bin/pixbg gen ${sh(st.wish ?? trim(wish))}") }; PixelBtn { label: T.retryGen; tone: P.ac; h: 40; size: 12; pad: 4 } }
              }
            } else if genErr && fixCmd != "" {
              Text { text: "✕ ${st.msg}"; style: small; color: "#ff6a6a"; maxLines: 3 }
            }
            if !busy && !genErr && !stalled && st.job == "gen" && doneMsg != "" { Text { text: doneMsg; style: small; color: st.state == "error" ? "#ff6a6a" : good; maxLines: 3 } }
            if cur.kind == "ai" && cur.prompt != null { Text { text: replace(T.thisScene ?? "{p}", "{p}", cur.prompt); style: small; color: soft; maxLines: 2 } }
          }

          // ---------------------------------------------- 場景卡片
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.scenes; tone: P.ac; meta: "${T.builtin} ${len(list.filter(x => x.kind != "ai"))} · Agent ${len(list.filter(x => x.kind == "ai"))}" }
            Grid {
              columns: 2
              gap: 8
              for x in list key x.id {
                Box { onTap: { sel = x.id; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true") }; SceneCard { x: x; on: x.id == cur.id } }
              }
            }
          }

          // ---------------------------------------------- 配色與速度
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.zone; tone: P.ac; meta: replace(T.setN ?? "{n}", "{n}", "${zone + 1}") }
            Row {
              gap: 8
              height: 54
              for z, i in cur.pal ?? [] {
                Box { weight: 1; fill: height; onTap: { zone = i; run(sound ? "paplay ~/.cache/pixbg/sfx/zone.wav" : "true") }; Swatch { z: z; on: zone == i } }
              }
            }
            HudHead { tag: T.speed; tone: P.ac; meta: speed < 0.75 ? T.drift : speed > 1.5 ? T.boost : T.normal }
            Row {
              gap: 6
              for o in [[0.5, T.slow], [1, T.mid], [2, T.fast]] {
                Box { weight: 1; onTap: { speed = o[0]; run(sound ? "paplay ~/.cache/pixbg/sfx/speed.wav" : "true") }; PixelBtn { label: o[1]; on: speed == o[0]; tone: P.ac; h: 50; size: 14 } }
              }
            }
          }

          // ---------------------------------------------- 桌布與相簿
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.wall; tone: good; meta: "~/Pictures/pixbg" }
            Box {
              fill: width
              onTap: { run(sound && !busy ? "paplay ~/.cache/pixbg/sfx/wall.wav" : "true"); run(busy ? "true" : "~/.local/bin/pixbg wall ${sh(cur.id ?? sel)}") }
              PixelBtn { label: busy && st.job == "wall" ? "${T.applying}… ${round(pct * 100)}%" : T.freeze; on: !busy; dim: busy; shine: !busy; tone: good; h: 60; size: 16 }
            }
            if busy && st.job == "wall" {
              PixelMeter { value: pct; tone: good }
              Text { text: st.msg; style: small; color: "#eef3fa" }
            }
            if len(walls ?? []) > 0 {
              Text { text: replace(T.albumN ?? "{n}", "{n}", "${len(walls)}"); style: small; color: soft }
              Grid {
                columns: 4
                gap: 6
                for w in (walls ?? []).take(12) key w.file {
                  Column {
                    gap: 2
                    onTap: { run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true"); run("~/.local/bin/pixbg setwall ${sh(w.file)}") }
                    Image { src: w.thumb; height: 130; fill: width; fit: cover; border: 3; radius: 0; borderColor: w.active ? good : ink }
                    Text { text: w.active ? T.inUse : w.label; font: mono; style: small; color: w.active ? good : soft; align: center; maxLines: 1 }
                  }
                }
              }
            }
          }

          // ---------------------------------------------- 開關（兩欄，字才放得下）
          Grid {
            columns: 2
            gap: 6
            Box { onTap: { panel = false; hiddenAt = now; run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true") }; PixelBtn { label: T.hide; tone: P.ac; h: 54; size: 15 } }
            Box { onTap: { showClock = !showClock; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: showClock ? T.clockOn : T.clockOff; on: showClock; tone: P.ac; h: 54; size: 15 } }
            Box { onTap: { sound = !sound; run(!sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: sound ? T.sfxOn : T.sfxOff; on: sound; tone: P.ac; h: 54; size: 15 } }
            Box { onTap: { pet = !pet; haptic(); run(sound ? (mascot == "ufo" ? "paplay ~/.cache/pixbg/sfx/beam.wav" : "paplay ~/.cache/pixbg/sfx/boing.wav") : "true") }; PixelBtn { label: pet ? T.petOn : T.petOff; on: pet; tone: P.ac; h: 54; size: 15 } }
          }

          // ---------------------------------------------- 語言（最下面）
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.language; tone: P.ac; meta: LP.name ?? "" }
            Grid {
              columns: 3
              gap: 6
              for l in ui.langs ?? [] key l.code {
                Box { onTap: { langCode = l.code; langOpen = false; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true"); run("~/.local/bin/pixbg lang ${sh(l.code)}") }; PixelBtn { label: l.name; on: l.code == lc && !langOpen; tone: P.ac; h: 50; size: 13; pad: 4 } }
              }
              Box { onTap: { langOpen = !langOpen; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: T.custom; on: langOpen; tone: "#ffd84a"; h: 50; size: 13; pad: 4 } }
            }
            if langOpen {
              Text { text: T.customHelp; style: small; color: soft; maxLines: 3 }
              Input { fill: width; height: 46; padding: [10, 0]; background: "#0a0e15"; border: 2; radius: 0; borderColor: alpha("#ffd84a", 0.5); placeholder: T.customHint; text: langWish; onChange: langWish = value }
              Text { text: langPrompt; font: mono; style: small; color: "#cfd8e6"; maxLines: 7; padding: [10, 8]; background: "#0a0e15"; fill: width }
              Row {
                gap: 6
                Box { weight: 2; onTap: { copy(langPrompt); copiedAt = now; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/done.wav" : "true") }; PixelBtn { label: now - copiedAt < 3 ? T.copied : T.copyPrompt; on: true; shine: now - copiedAt >= 3; tone: "#ffd84a"; h: 54; size: 14 } }
                Box { weight: 1; onTap: share(langPrompt); PixelBtn { label: T.share; tone: "#ffd84a"; h: 54; size: 14 } }
              }
            }
          }
          Spacer { height: 40 }
        }
        // 滿版的背景蓋住了啟動器的 ✕，自己放一顆像素關閉鈕在右上角
        Row {
          fill: width
          padding: 0
          Spacer { weight: 1 }
          Box { width: 60; height: 52; onTap: { run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true"); close() }; PixelBtn { label: "✕"; tone: "#ff6a6a"; h: 52; size: 20; pad: 0 } }
        }
      } else {
        if !exporting {
          // 隱藏介面時：點畫面任何地方叫回來；剛隱藏的幾秒底部有提示；右上角留一顆淡淡的 ✕
          Column {
            fill: true
            onTap: { panel = true; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }
            Row {
              fill: width
              padding: 0
              Spacer { weight: 1 }
              Box { width: 60; height: 52; opacity: 0.55; onTap: { run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true"); close() }; PixelBtn { label: "✕"; tone: "#ff6a6a"; h: 52; size: 20; pad: 0 } }
            }
            Spacer { weight: 1 }
            if now - hiddenAt < 5 {
              Row { Spacer { weight: 1 }  Text { text: T.tapToShow; style: small; color: "#eef3fa"; background: alpha("#0c111a", 0.8); padding: [12, 6]; width: len(T.tapToShow ?? "") * (latin ? 7.5 : 14) + 28 }  Spacer { weight: 1 } }
              Spacer { height: 48 }
            }
          }
        }
      }
    }
  }
}
