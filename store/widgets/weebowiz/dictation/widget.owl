 source voice = file("~/.cache/oma-voice/state.json") json
 source latest = file("~/.cache/oma-speak/latest.txt")
 source refined = file("~/.cache/oma-speak/refined.txt")
 source refineStatus = file("~/.cache/oma-speak/refine-status.json") json
 source sendStatus = file("~/.cache/oma-speak/send-status.json") json
 source queued = file("~/.cache/oma-voice/queued.json") json
 let sendMessage = sendStatus.phase == "sending" ? (uiLanguage == "zh" ? "正在送出…" : uiLanguage == "es" ? "Enviando…" : uiLanguage == "de" ? "Sende…" : uiLanguage == "fr" ? "Envoi…" : uiLanguage == "ja" ? "送信中…" : uiLanguage == "ko" ? "전송 중…" : "Sending…") : sendStatus.phase == "sent" ? (sendStatus.status_ui ?? (uiLanguage == "zh" ? "已送到目前目標佇列" : uiLanguage == "es" ? "En cola para el destino actual" : uiLanguage == "de" ? "Für das aktuelle Ziel eingereiht" : uiLanguage == "fr" ? "En file pour la cible actuelle" : uiLanguage == "ja" ? "現在の送信先のキューに追加しました" : uiLanguage == "ko" ? "현재 대상 대기열에 추가됨" : "Queued for current target")) : sendStatus.phase == "failed" ? (sendStatus.error_ui ?? sendStatus.error ?? (uiLanguage == "zh" ? "送出失敗" : uiLanguage == "es" ? "Error al enviar" : uiLanguage == "de" ? "Senden fehlgeschlagen" : uiLanguage == "fr" ? "Échec de l’envoi" : uiLanguage == "ja" ? "送信に失敗しました" : uiLanguage == "ko" ? "전송 실패" : "Send failed")) : sendStatus.phase == "saved" ? (uiLanguage == "zh" ? "已保存到首頁" : uiLanguage == "es" ? "Guardado en inicio" : uiLanguage == "de" ? "Auf Start gespeichert" : uiLanguage == "fr" ? "Enregistré sur l’accueil" : uiLanguage == "ja" ? "ホームに保存しました" : uiLanguage == "ko" ? "홈에 저장됨" : "Saved to home") : (uiLanguage == "zh" ? "保存後可送出" : uiLanguage == "es" ? "Guarda y luego envía" : uiLanguage == "de" ? "Speichern, dann senden" : uiLanguage == "fr" ? "Enregistrez, puis envoyez" : uiLanguage == "ja" ? "保存してから送信" : uiLanguage == "ko" ? "저장한 뒤 전송" : "Save, then send")
 let refineMessage = refineStatus.phase == "refining" ? (uiLanguage == "zh" ? "正在整理…" : uiLanguage == "es" ? "Organizando…" : uiLanguage == "de" ? "Wird überarbeitet…" : uiLanguage == "fr" ? "Révision en cours…" : uiLanguage == "ja" ? "整理中…" : uiLanguage == "ko" ? "정리 중…" : "Refining…") : refineStatus.phase == "ready" ? (uiLanguage == "zh" ? "整理稿已完成，請檢查" : uiLanguage == "es" ? "Versión revisada lista; revísala" : uiLanguage == "de" ? "Überarbeitete Fassung prüfen" : uiLanguage == "fr" ? "Version révisée prête ; relisez-la" : uiLanguage == "ja" ? "整理稿が完成しました。確認してください" : uiLanguage == "ko" ? "정리한 글이 준비되었습니다. 확인하세요" : "Refined draft ready") : refineStatus.phase == "failed" ? (refineStatus.error ?? (uiLanguage == "zh" ? "整理失敗，仍可送出原文" : uiLanguage == "es" ? "Error al organizar; puedes enviar el original" : uiLanguage == "de" ? "Überarbeitung fehlgeschlagen; Original verfügbar" : uiLanguage == "fr" ? "Échec de la révision ; original disponible" : uiLanguage == "ja" ? "整理に失敗しました。原文は送信できます" : uiLanguage == "ko" ? "정리 실패. 원문은 보낼 수 있습니다" : "Refining failed; original is available")) : (uiLanguage == "zh" ? "可用 Agent 整理已保存文字" : uiLanguage == "es" ? "Organiza el texto guardado con Agent" : uiLanguage == "de" ? "Gespeicherten Text mit Agent überarbeiten" : uiLanguage == "fr" ? "Réviser le texte enregistré avec Agent" : uiLanguage == "ja" ? "保存した文章を Agent で整理できます" : uiLanguage == "ko" ? "저장한 글을 Agent로 정리할 수 있습니다" : "Refine the saved text with Agent")
 state actionKind = ""
 state actionPending = ""
 state actionResult = ""
 state copyState = ""
 on actionResult { actionPending = "" }
 let actionMessage = actionPending != "" ? (uiLanguage == "zh" ? "處理中…" : uiLanguage == "es" ? "Procesando…" : uiLanguage == "de" ? "Wird verarbeitet…" : uiLanguage == "fr" ? "Traitement…" : uiLanguage == "ja" ? "処理中…" : uiLanguage == "ko" ? "처리 중…" : "Working…") : actionResult != "" ? (parseJson(actionResult).ok ? (parseJson(actionResult).status_ui ?? (actionKind == "open" ? (uiLanguage == "zh" ? "語音輸入已開啟" : uiLanguage == "es" ? "Dictado abierto" : uiLanguage == "de" ? "Diktat geöffnet" : uiLanguage == "fr" ? "Dictée ouverte" : uiLanguage == "ja" ? "音声入力を開きました" : uiLanguage == "ko" ? "받아쓰기를 열었습니다" : "Dictation opened") : (uiLanguage == "zh" ? "完成" : uiLanguage == "es" ? "Listo" : uiLanguage == "de" ? "Fertig" : uiLanguage == "fr" ? "Terminé" : uiLanguage == "ja" ? "完了" : uiLanguage == "ko" ? "완료" : "Done"))) : (parseJson(actionResult).error_ui ?? parseJson(actionResult).error ?? (uiLanguage == "zh" ? "操作失敗" : uiLanguage == "es" ? "La acción falló" : uiLanguage == "de" ? "Aktion fehlgeschlagen" : uiLanguage == "fr" ? "Échec de l’action" : uiLanguage == "ja" ? "操作に失敗しました" : uiLanguage == "ko" ? "작업 실패" : "Action failed"))) : ""
 let actionFailed = actionPending == "" && actionResult != "" && parseJson(actionResult).ok != true
 let copyNotice = copyState == "copied" ? (uiLanguage == "zh" ? "已複製" : uiLanguage == "es" ? "Copiado" : uiLanguage == "de" ? "Kopiert" : uiLanguage == "fr" ? "Copié" : uiLanguage == "ja" ? "コピーしました" : uiLanguage == "ko" ? "복사됨" : "Copied") : copyState == "empty" ? (uiLanguage == "zh" ? "尚無保存的文字" : uiLanguage == "es" ? "Aún no hay texto guardado" : uiLanguage == "de" ? "Noch kein Text gespeichert" : uiLanguage == "fr" ? "Aucun texte enregistré" : uiLanguage == "ja" ? "保存した文章はまだありません" : uiLanguage == "ko" ? "저장된 글이 없습니다" : "No saved text") : ""
 onTap: screen()
 Column {
  fill: true
  gap: 5
  if !ready {
   Text { text: (uiLanguage == "zh" ? "語音輸入" : uiLanguage == "es" ? "DICTADO" : uiLanguage == "de" ? "DIKTAT" : uiLanguage == "fr" ? "DICTÉE" : uiLanguage == "ja" ? "音声入力" : uiLanguage == "ko" ? "받아쓰기" : "DICTATION"); style: label; color: accent }
   Text { text: setupText; style: small; maxLines: 8; weight: 1; color: setupState == "failed" ? red : muted }
   Button { fill: width; height: 36; text: installed == "" ? (uiLanguage == "zh" ? "安裝" : uiLanguage == "es" ? "Instalar" : uiLanguage == "de" ? "Einrichten" : uiLanguage == "fr" ? "Installer" : uiLanguage == "ja" ? "インストール" : uiLanguage == "ko" ? "설치" : "Set up") : (uiLanguage == "zh" ? "更新" : uiLanguage == "es" ? "Actualizar" : uiLanguage == "de" ? "Aktualisieren" : uiLanguage == "fr" ? "Mettre à jour" : uiLanguage == "ja" ? "更新" : uiLanguage == "ko" ? "업데이트" : "Update"); onTap: run("""
# Writes the voice and dictation programs kept in this widget into ~/.local, then
# makes a Python environment for edge-tts (online speech). Log: ~/.cache/oma-voice/setup.log
set -u
umask 077
share="$HOME/.local/share"
cache="$HOME/.cache/oma-voice"
mkdir -p "$share/oma-voice" "$share/oma-speak" "$HOME/.local/bin" "$cache"
exec >>"$cache/setup.log" 2>&1
say() { printf '%s' "$1" > "$cache/setup-state"; }
# Written beside the old file and moved over it, so a running copy is never half written.
put() { cat > "$1.new" && mv -f "$1.new" "$1" || { say failed; exit 1; }; }
say installing
# English became the default in 3.3: an earlier install that never chose a language stays Chinese.
language="$HOME/.config/omalauncher/voice-ui-language"
earlier=no
case "$(cut -d- -f1 "$HOME/.local/share/oma-voice/store-version" 2>/dev/null)" in
  3.0|3.1|3.2) earlier=yes ;;
  "") [ -f "$share/oma-voice/oma_voice.py" ] && earlier=yes ;;
esac
[ "$earlier" = yes ] && [ ! -f "$language" ] && mkdir -p "$HOME/.config/omalauncher" && printf zh > "$language"
# A previously installed newer widget must keep its newer shared programs.
current_version="$(cut -d- -f1 "$HOME/.local/share/oma-voice/store-version" 2>/dev/null || true)"
payload_newer=no
if [ -n "$current_version" ] && [ "$current_version" != "3.5.6" ] &&
   [ "$(printf '%s\n%s\n' "3.5.6" "$current_version" | sort -V | tail -n 1)" = "$current_version" ]; then payload_newer=yes; fi
if [ "$payload_newer" = no ]; then
put "$HOME/.local/share/oma-voice/codex_queue.py" <<'OMA_VOICE_FILE_0_END'
'''The one dictation waiting in a Codex chat's queue. Codex reloads its SQLite queue when a row
changes, so a newer dictation replaces the waiting one instead of piling up behind it.'''
from contextlib import contextmanager
import json
import os
from pathlib import Path
import sqlite3
import uuid

HOME = Path.home()
DB = Path(os.environ.get('CODEX_HOME') or HOME/'.codex')/'queue_1.sqlite'
PENDING = HOME/'.cache/oma-voice/queued.json'


@contextmanager
def _connect():
    if not DB.exists():
        raise OSError('no Codex queue')
    connection = sqlite3.connect(str(DB), timeout=3)
    try:
        with connection:
            yield connection
    finally:
        connection.close()


def _text(payload):
    try:
        content = json.loads(payload)['UserInput']['content']
        return ''.join(part.get('text', '') for part in content if part.get('type') == 'text')
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def items(thread):
    '''(id, text) of every message waiting in this chat, oldest first.'''
    with _connect() as connection:
        rows = connection.execute('SELECT id, payload_json FROM queued_items WHERE thread_id = ? ORDER BY queue_order',
                                  (thread,)).fetchall()
    return [(row[0], _text(row[1])) for row in rows]


def remove(thread, ids):
    if not ids:
        return 0
    with _connect() as connection:
        return sum(connection.execute('DELETE FROM queued_items WHERE thread_id = ? AND id = ?',
                                      (thread, item)).rowcount for item in ids)


def pending():
    '''The waiting dictation message, or None once Codex has taken it or it was removed.'''
    try:
        value = json.loads(PENDING.read_text())
    except (OSError, ValueError):
        return None
    try:
        waiting = any(item == value.get('id') for item, _ in items(value.get('thread', '')))
    except (OSError, sqlite3.Error):
        return value
    if not waiting:
        PENDING.unlink(missing_ok=True)
        return None
    return value


def forget(thread, text):
    '''Before queueing text: drop the earlier waiting dictation and copies of this text.'''
    ids = []
    earlier = pending()
    if earlier and earlier.get('thread') == thread:
        ids.append(earlier['id'])
    try:
        ids += [item for item, queued in items(thread) if queued == text and item not in ids]
        removed = remove(thread, ids)
    except (OSError, sqlite3.Error):
        removed = 0
    PENDING.unlink(missing_ok=True)
    return removed


def remember(thread, text):
    '''After `codex queue`: note the newest matching row, if it is still waiting.'''
    try:
        found = [item for item, queued in items(thread) if queued == text]
    except (OSError, sqlite3.Error):
        found = []
    if not found:
        return None
    value = {'thread': thread, 'id': found[-1], 'text': text}
    PENDING.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = PENDING.with_name(PENDING.name+'.'+uuid.uuid4().hex+'.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False))
    temporary.chmod(0o600)
    temporary.replace(PENDING)
    return value


def cancel():
    value = pending()
    if value is None:
        return None
    remove(value['thread'], [value['id']])
    PENDING.unlink(missing_ok=True)
    return value
OMA_VOICE_FILE_0_END
put "$HOME/.local/share/oma-voice/language.py" <<'OMA_VOICE_FILE_1_END'
'''Interface languages, the text shown in them, and which language a text should be spoken in.'''
from pathlib import Path
import re

# The first is the default. The tile's language button goes through them in this order.
LANGUAGES = ('en', 'zh', 'es', 'de', 'fr', 'ja', 'ko')
CHOICE = Path.home() / '.config/omalauncher/voice-ui-language'


def chosen():
    try:
        value = CHOICE.read_text().strip()
    except OSError:
        value = ''
    return value if value in LANGUAGES else LANGUAGES[0]


def changed_at():
    '''When the choice was last written, however it was: a tile, the dictation page or by hand.'''
    try:
        return CHOICE.stat().st_mtime_ns
    except OSError:
        return 0


# The programs write Chinese; these are the same messages in (en, es, de, fr, ja, ko).
MESSAGES = {
