widget "Dictation" {
 page: 1
 order: 7
 size: 3x4
 minSize: 3x3
 meta { owl: 6; description: "Dictate by voice and send the text to a Codex chat or a tmux terminal running Claude or any CLI. English, Chinese, Spanish, German, French, Japanese, Korean."; version: "3.4"; license: "MIT"; category: "productivity" }
 requires { pacman: ["python", "espeak-ng", "libpulse", "mpg123", "tmux", "curl", "util-linux"] }
 source uiLanguage = file("~/.config/omalauncher/voice-ui-language")
 source installed = file("~/.local/share/oma-voice/store-version")
 source setupState = file("~/.cache/oma-voice/setup-state")
 let ready = installed == "3.4-1acdf3a4"
 let setupText = setupState == "installing" && !ready ? (uiLanguage == "zh" ? "安裝中，約需一分鐘…" : uiLanguage == "es" ? "Instalando, cerca de un minuto…" : uiLanguage == "de" ? "Installation läuft, etwa eine Minute…" : uiLanguage == "fr" ? "Installation, environ une minute…" : uiLanguage == "ja" ? "インストール中、約1分…" : uiLanguage == "ko" ? "설치 중, 약 1분…" : "Installing, about a minute…") : setupState == "failed" ? (uiLanguage == "zh" ? "安裝失敗，請查看 ~/.cache/oma-voice/setup.log" : uiLanguage == "es" ? "La instalación falló: consulta ~/.cache/oma-voice/setup.log" : uiLanguage == "de" ? "Installation fehlgeschlagen: siehe ~/.cache/oma-voice/setup.log" : uiLanguage == "fr" ? "Échec de l’installation : voir ~/.cache/oma-voice/setup.log" : uiLanguage == "ja" ? "インストール失敗：~/.cache/oma-voice/setup.log を確認" : uiLanguage == "ko" ? "설치 실패: ~/.cache/oma-voice/setup.log 확인" : "Setup failed: see ~/.cache/oma-voice/setup.log") : installed == "" ? (uiLanguage == "zh" ? "首次使用：把播報與聽寫程式寫入 ~/.local，並下載 edge-tts 線上語音。" : uiLanguage == "es" ? "Primer uso: escribe los programas de voz y dictado en ~/.local y descarga edge-tts para la voz en línea." : uiLanguage == "de" ? "Erste Nutzung: schreibt die Programme für Sprachausgabe und Diktat nach ~/.local und lädt edge-tts für die Online-Stimme." : uiLanguage == "fr" ? "Première utilisation : écrit les programmes de voix et de dictée dans ~/.local et télécharge edge-tts pour la voix en ligne." : uiLanguage == "ja" ? "初回：読み上げと音声入力のプログラムを ~/.local に書き込み、オンライン音声用の edge-tts をダウンロードします。" : uiLanguage == "ko" ? "처음 사용: 음성 읽기와 받아쓰기 프로그램을 ~/.local 에 쓰고 온라인 음성용 edge-tts 를 내려받습니다." : "First use: writes the voice and dictation programs to ~/.local and downloads edge-tts for online speech.") : (uiLanguage == "zh" ? "程式有新版，更新後才能使用。" : uiLanguage == "es" ? "Hay una actualización de los programas; instálala para continuar." : uiLanguage == "de" ? "Für die Programme gibt es ein Update; zum Fortfahren installieren." : uiLanguage == "fr" ? "Les programmes ont une mise à jour ; installez-la pour continuer." : uiLanguage == "ja" ? "プログラムの更新があります。続けるには更新してください。" : uiLanguage == "ko" ? "프로그램 업데이트가 있습니다. 계속하려면 설치하세요." : "The programs have an update; install it to continue.")
 source voice = file("~/.cache/oma-voice/state.json") json
 source latest = file("~/.cache/oma-speak/latest.txt")
 state result = ""
 state sending = false
 on result { sending = false }
 onTap: screen()
 Column {
  fill: true
  gap: 5
  if !ready {
   Text { text: (uiLanguage == "zh" ? "語音輸入" : uiLanguage == "es" ? "DICTADO" : uiLanguage == "de" ? "DIKTAT" : uiLanguage == "fr" ? "DICTÉE" : uiLanguage == "ja" ? "音声入力" : uiLanguage == "ko" ? "받아쓰기" : "DICTATION"); style: label; color: accent }
   Text { text: setupText; style: small; maxLines: 8; weight: 1; color: setupState == "failed" ? red : muted }
   Button { fill: width; height: 36; text: installed == "" ? (uiLanguage == "zh" ? "安裝" : uiLanguage == "es" ? "Instalar" : uiLanguage == "de" ? "Einrichten" : uiLanguage == "fr" ? "Installer" : uiLanguage == "ja" ? "インストール" : uiLanguage == "ko" ? "설치" : "Set up") : (uiLanguage == "zh" ? "更新" : uiLanguage == "es" ? "Actualizar" : uiLanguage == "de" ? "Aktualisieren" : uiLanguage == "fr" ? "Mettre à jour" : uiLanguage == "ja" ? "更新" : uiLanguage == "ko" ? "업데이트" : "Update"); onTap: run("""
# Writes the voice and dictation programs kept in this widget into ~/.local, then
# makes a Python environment for edge-tts (online speech). Log: ~/.cache/oma-voice/setup.log
set -u
umask 077
share="$HOME/.local/share"
cache="$HOME/.cache/oma-voice"
mkdir -p "$share/oma-voice" "$share/oma-speak" "$HOME/.local/bin" "$cache"
exec >>"$cache/setup.log" 2>&1
say() { printf '%s' "$1" > "$cache/setup-state"; }
# Written beside the old file and moved over it, so a running copy is never half written.
put() { cat > "$1.new" && mv -f "$1.new" "$1" || { say failed; exit 1; }; }
say installing
# English became the default in 3.3: an earlier install that never chose a language stays Chinese.
language="$HOME/.config/omalauncher/voice-ui-language"
earlier=no
case "$(cut -d- -f1 "$HOME/.local/share/oma-voice/store-version" 2>/dev/null)" in
  3.0|3.1|3.2) earlier=yes ;;
  "") [ -f "$share/oma-voice/oma_voice.py" ] && earlier=yes ;;
esac
[ "$earlier" = yes ] && [ ! -f "$language" ] && mkdir -p "$HOME/.config/omalauncher" && printf zh > "$language"
put "$HOME/.local/share/oma-voice/language.py" <<'OMA_VOICE_FILE_0_END'
'''Interface languages, the text shown in them, and which language a text should be spoken in.'''
from pathlib import Path
import re

# The first is the default. The tile's language button goes through them in this order.
LANGUAGES = ('en', 'zh', 'es', 'de', 'fr', 'ja', 'ko')
CHOICE = Path.home() / '.config/omalauncher/voice-ui-language'


def chosen():
    try:
        value = CHOICE.read_text().strip()
    except OSError:
        value = ''
    return value if value in LANGUAGES else LANGUAGES[0]


def changed_at():
    '''When the choice was last written, however it was: a tile, the dictation page or by hand.'''
    try:
        return CHOICE.stat().st_mtime_ns
    except OSError:
        return 0


# The programs write Chinese; these are the same messages in (en, es, de, fr, ja, ko).
