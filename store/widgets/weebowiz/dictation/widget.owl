}

# Common words that tell the four Latin-script languages apart.
WORDS = {
    'en': 'the and is are of to that this with for you not it was have be on as at by from or an will can',
    'es': 'el la los las que de y en es un una por con para no se lo como más pero sus le ya o fue este sí porque',
    'de': 'der die das und ist nicht ein eine mit für auf den zu von ich sie es dem des im auch sich als wird noch',
    'fr': 'le la les des est et un une pour dans que qui pas sur avec ce il au du en ne se plus par je sont cette',
}
WORDS = {code: set(words.split()) for code, words in WORDS.items()}


def spoken(text, interface=None):
    '''The language to read a text in: by its script, then by its words, then the interface language.'''
    interface = interface or chosen()
    han = sum('㐀' <= c <= '鿿' for c in text)
    kana = sum('぀' <= c <= 'ヿ' for c in text)
    hangul = sum('가' <= c <= '힣' for c in text)
    if kana and kana * 10 >= han:
        return 'ja'
    if hangul and hangul >= han:
        return 'ko'
    if han:
        return 'zh'
    found = re.findall(r"[^\W\d_]+", text.lower())
    counts = {code: sum(word in words for word in found) for code, words in WORDS.items()}
    best = max(counts, key=counts.get)
    ahead = sorted(counts.values())[-1] - sorted(counts.values())[-2]
    if counts[best] >= 3 and ahead >= 2:
        return best
    return interface if interface in WORDS else 'en'
OMA_VOICE_FILE_0_END
put "$HOME/.local/share/oma-voice/oma_voice.py" <<'OMA_VOICE_FILE_1_END'
#!/usr/bin/env python3
'''Voice reader and dictation bridge for Codex logs or a tmux terminal.'''
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import select
import shutil
import socket
import subprocess
import sys
import threading
import time
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent))
from language import CHOICE, LANGUAGES, SPOKEN, changed_at, chosen, local, spoken


def english(text):
    return local(text, 'en')


HOME = Path.home()
CACHE = HOME / '.cache/oma-voice'
SOCKET = CACHE / 'control.sock'
CONFIG = HOME / '.config/omalauncher/voice.json'
SESSIONS = HOME / '.codex/sessions'
TMUX_SESSION = 'oma-voice'
# ensure() touches this. The service quits once neither it nor the Codex log has changed
# for the 'pause_minutes' setting (0 = never), and ensure() starts it again.
ALIVE = CACHE / 'alive'
PAUSE_MINUTES = 10
# Seconds between looks for a Codex session or tmux pane while there is none.
RETRY = 15


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
    tmp.write_text(json.dumps(value, ensure_ascii=False))
    tmp.chmod(0o600)
    tmp.replace(path)


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def chinese(text):
    return any('㐀' <= c <= '鿿' for c in text)


def clean_text(text):
    # Spoken notes are in the language of the reply, or the wrong voice would be picked for it.
    notes = SPOKEN[spoken(text)]
    text = re.sub(r'```.*?```', notes[2], text, flags=re.S)
    text = re.sub(r'!?\[([^\]]+)\]\([^)]*\)', r'\1', text)
    text = re.sub(r'https?://\S+', notes[3], text)
    text = re.sub(r'(?m)^\s*(?:#{1,6}\s+|[-*+]\s+|\d+[.)]\s+|>\s*)', '', text)
    text = text.replace('`', '').replace('**', '').replace('__', '')
    return ''.join(c for c in text if c in '\n\t' or (ord(c) >= 32 and ord(c) != 127)).strip()


def summarize(text, limit=360):
    '''Extract sentences verbatim; retain an explicit failure/limitation if present.'''
    text = clean_text(text)
    if len(text) <= limit:
        return text
    sentences = [s.strip() for s in re.split(r'(?<=[。！？.!?])\s*|\n+', text) if s.strip()]
    selected = []
    important = re.compile(r'未完成|尚未|無法|不能|失敗|限制|需要你|待.*確認|未.*驗證|未.*測試|not tested|failed|unable|cannot|limitation', re.I)
    warning = next((s for s in sentences if important.search(s)), '')
    # Reserve room for a caveat even when it appears at the end of a long answer.
    budget = limit - min(len(warning), limit // 2) - (8 if warning else 0)
    used = 0
    for s in sentences:
        if s == warning:
            continue
        if used + len(s) > budget:
            if not selected:
                selected.append(s[:budget].rstrip() + '…')
            break
        selected.append(s)
        used += len(s) + 1
    if warning:
        selected.append(warning[:limit // 2])
    notes = SPOKEN[spoken(text)]
    return notes[0] + ' '.join(selected) + notes[1]


def completed_reply(event):
    '''Ignore commentary, tool output, subagent logs and aborted turns.'''
    if event.get('type') != 'event_msg':
        return None
    payload = event.get('payload', {})
    if payload.get('type') != 'task_complete':
        return None
    text = payload.get('last_agent_message')
    if not isinstance(text, str) or not text.strip():
        return None
    return payload.get('turn_id') or payload.get('root_turn_id') or event.get('timestamp'), text


def find_session(thread):
    # Session IDs are data, never shell expressions or path components.
    thread = str(uuid.UUID(thread))
    return next(SESSIONS.rglob('*' + thread + '.jsonl'), None)


def latest_session():
    files = list(SESSIONS.rglob('*.jsonl'))
    if not files:
        raise ValueError('找不到 Codex 會話')
    path = max(files, key=lambda p: p.stat().st_mtime)
    with path.open() as f:
        meta = json.loads(f.readline()).get('payload', {})
    return str(uuid.UUID(meta.get('id') or meta.get('session_id')))


def terminal_snapshot():
    '''Read only the current pane of the dedicated, user-entered tmux session.'''
    if not shutil.which('tmux'):
        raise ValueError('需要 tmux / tmux is required')
    pane = subprocess.run(['tmux', 'display-message', '-p', '-t', TMUX_SESSION, '#{pane_id}'],
                          capture_output=True, text=True, timeout=3)
    if pane.returncode or not re.fullmatch(r'%[0-9]+', pane.stdout.strip()):
        raise ValueError('請在現有終端執行 tmux new -A -s oma-voice')
    pane_id = pane.stdout.strip()
    command = subprocess.run(['tmux', 'display-message', '-p', '-t', pane_id, '#{pane_current_command}'],
                             capture_output=True, text=True, timeout=3).stdout.strip()
    output = subprocess.run(['tmux', 'capture-pane', '-p', '-t', pane_id, '-S', '-80'],
                            capture_output=True, text=True, timeout=3)
    if output.returncode:
        raise ValueError('無法讀取終端畫面')
    clean = ''.join(ch for ch in output.stdout if ch in '\n\t' or ord(ch) >= 32)
    clean = '\n'.join(line.rstrip() for line in clean.splitlines()).strip()
    label = 'Claude' if 'claude' in command.lower() else 'Codex' if 'codex' in command.lower() else (command or 'Terminal')
    return pane_id, label, clean[-6000:]


def terminal_send(pane_id, text):
    '''Submit one explicit user action to the already selected tmux pane.'''
    if not re.fullmatch(r'%[0-9]+', pane_id):
        raise ValueError('無效的終端窗格')
    text = ' '.join(text.splitlines()).strip()
    for keys in (['-l', text], ['Enter']):
        result = subprocess.run(['tmux', 'send-keys', '-t', pane_id, *keys],
                                capture_output=True, text=True, timeout=5)
        if result.returncode:
            raise ValueError(result.stderr.strip() or '終端輸入失敗')


class Reader:
    def __init__(self):
        self.config = read_json(CONFIG, {})
        self.config.setdefault('auto', True)
        self.config.setdefault('mode', 'summary')
        self.config.setdefault('language', 'cmn')
        self.config.setdefault('rate', 175)
        self.config.setdefault('engine', 'online')
        if not self.config.get('thread'):
            try:
                self.config['thread'] = latest_session()
            except ValueError:
                self.config['thread'] = None
        self.config.setdefault('follow_latest', True)
        self.config.setdefault('source', 'codex')
        self.config.setdefault('pause_minutes', PAUSE_MINUTES)
        self.term_last = None
        self.checked_session = 0
        self.next_terminal = 0
        self.retry_at = 0
        self.saved = None
        atomic_json(CONFIG, self.config)
        self.state = read_json(CACHE / 'state.json', {})
        self.state.update(status='已連接，等待回覆', playing=False, error='')
        self.process = None
        self.player_lock = threading.RLock()
        self.generation = 0
        self.path = None
        self.offset = 0
        self.pending = b''
        self.last_turn = None
        self.save()

    def save(self):
        # The tiles show these; 'status' and 'error' stay as written, for the next change of language.
        language = chosen()
        self.language_at = changed_at()
        self.state['status_ui'] = local(self.state.get('status', ''), language)
        self.state['error_ui'] = local(self.state.get('error', ''), language)
        for old in ('status_en', 'error_en', 'checked_at'):
            self.state.pop(old, None)
        stamp = self.state.get('reply_at')
        if isinstance(stamp, str):
            try:
                self.state['reply_at'] = datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp()
            except ValueError:
                self.state['reply_at'] = None
        self.state.update(auto=self.config['auto'], mode=self.config['mode'], thread=self.config['thread'], engine=self.config['engine'], follow_latest=self.config['follow_latest'], source=self.config['source'], pause_minutes=self.config['pause_minutes'], source_name=self.state.get('source_name','Codex'))
        # The tiles redraw on every write, so write only what changed.
        if self.state != self.saved:
            atomic_json(CACHE / 'state.json', self.state)
            self.saved = dict(self.state)

    def bind(self, thread):
        path = find_session(thread)
        if path is None:
            raise ValueError('找不到指定會話')
        self.config['thread'] = str(uuid.UUID(thread))
        self.path = path
        # Seed replay, but never automatically speak historical answers on startup.
        self.pending = b''
        self.last_turn = None
        self.state.update(full='', summary='', last_turn='', reply_at=None, awaiting=False, status='已連接，等待回覆')
        with path.open('rb') as f:
            for line in f:
                try:
                    event = json.loads(line)
                    reply = completed_reply(event)
                    kind = event.get('payload', {}).get('type')
                    if kind == 'task_started':
                        self.state['awaiting'] = True
                    elif kind in ('task_complete', 'turn_aborted'):
                        self.state['awaiting'] = False
                except ValueError:
                    continue
                if reply:
                    self.last_turn, full = reply
                    self.state.update(full=full, summary=summarize(full), last_turn=self.last_turn, reply_at=event.get('timestamp'))
            self.offset = f.tell()
        self.state['status'] = 'Codex 正在回覆…' if self.state['awaiting'] else ('已同步最近回覆' if self.state['full'] else '已連接，等待回覆')
        atomic_json(CONFIG, self.config)
        self.save()

    def poll(self):
        if self.config['source'] == 'terminal':
            return self.poll_terminal()
        if not self.config['thread']:
            self.config['thread'] = latest_session()
        if time.monotonic() - self.checked_session >= RETRY:
            self.checked_session = time.monotonic()
            if self.config['follow_latest']:
                thread = latest_session()
                if thread != self.config['thread']:
                    self.stop()
                    self.bind(thread)
        if self.path is None:
            self.bind(self.config['thread'])
        size = self.path.stat().st_size
        if size == self.offset:
            return
        if size < self.offset:
            self.bind(self.config['thread'])
        with self.path.open('rb') as f:
            f.seek(self.offset)
            data = f.read(4 * 1024 * 1024)
            self.offset = f.tell()
        lines = (self.pending + data).split(b'\n')
        self.pending = lines.pop()
        for line in lines:
            try:
                event = json.loads(line)
                reply = completed_reply(event)
                kind = event.get('payload', {}).get('type')
                if kind == 'task_started':
                    self.state.update(awaiting=True, status='Codex 正在回覆…', error='')
                    self.save()
                elif kind in ('task_complete', 'turn_aborted'):
                    self.state['awaiting'] = False
            except (ValueError, UnicodeError):
                continue
            if not reply or reply[0] == self.last_turn:
                continue
            self.last_turn, full = reply
            self.state.update(full=full, summary=summarize(full), last_turn=self.last_turn,
                              status='收到新回覆', error='', awaiting=False, reply_at=event.get('timestamp'))
            self.save()
            if self.config['auto']:
                self.play(self.state[self.config['mode']])

    def poll_terminal(self):
        if time.monotonic() < self.next_terminal:
            return
        self.next_terminal = time.monotonic() + 3
        try:
            pane, label, full = terminal_snapshot()
        except ValueError as exc:
            self.next_terminal = time.monotonic() + RETRY
            self.state.update(source_name='Terminal', term_pane='', status=str(exc),
                              full='', summary='', error='', reply_at=None, awaiting=False)
            self.save()
            return
        self.state.update(source_name=label, term_pane=pane, status='已連接終端 · 點播放讀取畫面',
                          error='', awaiting=False)
        if full != self.term_last:
            self.term_last = full
            self.state.update(full=full, summary=clean_text(full)[-360:], reply_at=time.time() if full else None)
        self.save()

    def idle(self):
        '''Nothing is being spoken, and no tile, command or Codex activity for the chosen time.'''
        limit = self.config['pause_minutes'] * 60
        if not limit or self.state.get('playing'):
            return False
        # Codex still writing its log counts, so a long task is read aloud with the screen off.
        seen = [ALIVE] + ([self.path] if self.path and self.config['source'] == 'codex' else [])
        try:
            return time.time() - max(path.stat().st_mtime for path in seen) >= limit
        except OSError:
            return False

    def stop(self):
        with self.player_lock:
            self.generation += 1
            if self.process is not None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait()
                self.process = None
            self.state.update(playing=False, status='已停止')
            self.save()

    def play(self, text):
        if not text.strip():
            raise ValueError('還沒有可播放的回覆')
        self.stop()
        with self.player_lock:
            generation = self.generation
            self.state.update(playing=True, status='正在播放', error='')
            self.save()

        def worker():
            wav = CACHE / ('speech-' + uuid.uuid4().hex + '.wav')
            try:
                with self.player_lock:
                    if generation != self.generation:
                        return
                if not shutil.which('espeak-ng') or not shutil.which('paplay'):
                    raise ValueError('需要 espeak-ng 和 paplay')
                commands = [
                    ([str(Path(__file__).parent / 'venv/bin/python'),
                      str(Path(__file__).parent / 'synthesize.py'), str(wav)], clean_text(text).encode()),
                    (['paplay', str(wav)], None),
                ]
                for args, data in commands:
                    if data is None:
                        with self.player_lock:
                            if generation == self.generation:
                                backend = Path(str(wav) + '.backend')
                                self.state['status'] = '正在播放 · ' + (backend.read_text() if backend.exists() else '語音')
                                self.save()
                    with self.player_lock:
                        if generation != self.generation:
                            return
                        proc = subprocess.Popen(args, stdin=subprocess.PIPE if data else subprocess.DEVNULL,
                                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                        self.process = proc
                    try:
                        _, err = proc.communicate(data, timeout=300)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.communicate()
                        raise ValueError('播放逾時')
                    if proc.returncode and generation == self.generation:
                        raise ValueError(err.decode(errors='replace')[-400:] or '播放失敗')
                with self.player_lock:
                    if generation == self.generation:
                        self.process = None
                        # Keep the reason on screen when the natural voice was not the one heard.
                        used = Path(str(wav) + '.backend')
                        used = used.read_text() if used.exists() else ''
                        self.state.update(playing=False, status='播放完成 · '+used if '離線' in used and '（' in used else '播放完成')
                        self.save()
            except Exception as exc:
                with self.player_lock:
                    if generation == self.generation:
                        self.state.update(playing=False, status='播放失敗', error=str(exc))
                        self.save()
            finally:
                wav.unlink(missing_ok=True)
                Path(str(wav) + '.backend').unlink(missing_ok=True)
        threading.Thread(target=worker, daemon=True).start()

    def command(self, request):
        action = request.get('action')
        if action != 'status':
            self.retry_at = 0
        if action in ('replay', 'send'):
            if self.config['source'] == 'terminal':
                self.next_terminal = 0
            self.poll()
        if action == 'status':
            # Also how a change of interface language reaches the tiles: save() writes only what changed.
            self.save()
            return self.state
        if action == 'replay':
            self.play(self.state.get('full' if request.get('full') else 'summary', ''))
        elif action == 'test':
            self.play(SPOKEN[chosen()][4])
        elif action == 'stop':
            self.stop()
        elif action == 'auto':
            value = request.get('value', 'toggle')
            self.config['auto'] = not self.config['auto'] if value == 'toggle' else value == 'on'
            if not self.config['auto']:
                self.stop()
            self.state['status'] = '自動播報已開啟' if self.config['auto'] else '自動播報已關閉'
            atomic_json(CONFIG, self.config)
            self.save()
        elif action == 'engine':
            value = request.get('value', 'toggle')
            if value == 'toggle':
                value = 'offline' if self.config['engine'] == 'online' else 'online'
            if value not in ('online', 'offline'):
                raise ValueError('請選 online 或 offline')
            self.stop()
            self.config['engine'] = value
            atomic_json(CONFIG, self.config)
            self.state['status'] = '已切換線上自然語音' if value == 'online' else '已切換離線神經語音'
            self.save()
        elif action == 'pause':
            value = str(request.get('value', 'toggle')).strip().lower()
            if value == 'toggle':
                value = '0' if self.config['pause_minutes'] else str(PAUSE_MINUTES)
            if value == 'off':
                value = '0'
            if not value.isascii() or not value.isdigit() or int(value) > 1440:
                raise ValueError('請輸入 1 到 1440 的分鐘數，或 off')
            self.config['pause_minutes'] = int(value)
            atomic_json(CONFIG, self.config)
            self.state['status'] = '已更新閒置暫停時間' if int(value) else '閒置後不再暫停'
            self.save()
        elif action == 'refresh':
            self.stop()
            if self.config['source'] == 'terminal':
                self.next_terminal = 0
                self.poll_terminal()
            else:
                self.bind(latest_session() if self.config['follow_latest'] else self.config['thread'])
        elif action == 'source':
            value = request.get('value')
            if value not in ('codex', 'terminal'):
                raise ValueError('請選 Codex 或 Terminal')
            self.stop()
            self.config['source'] = value
            self.state.update(full='', summary='', reply_at=None, source_name='Codex' if value == 'codex' else 'Terminal')
            atomic_json(CONFIG, self.config)
            if value == 'terminal':
                self.next_terminal = 0
                self.term_last = None
                self.poll_terminal()
            else:
                self.bind(latest_session() if self.config['follow_latest'] else self.config['thread'])
        elif action == 'follow':
            self.config['follow_latest'] = not self.config['follow_latest']
            if self.config['follow_latest']:
                self.stop()
                self.bind(latest_session())
            atomic_json(CONFIG, self.config)
            self.save()
        elif action == 'bind':
            self.stop()
            self.config['follow_latest'] = False
            self.bind(request['thread'])
        elif action == 'send':
            text = request.get('text', '').strip()
            if not text or len(text) > 16000:
                raise ValueError('請先輸入內容（最多 16000 字）')
            if any(ord(c) < 32 and c not in '\n\t' for c in text):
                raise ValueError('文字含有控制字元')
            self.stop()
            if self.config['source'] == 'terminal':
                pane, label, _ = terminal_snapshot()
                terminal_send(pane, text)
                self.state.update(status='已送到終端 · '+label, error='')
            else:
                result = subprocess.run(['codex', 'queue', '--thread', self.config['thread'], '--message', text],
                                        capture_output=True, text=True, timeout=20)
                if result.returncode:
                    raise ValueError(result.stderr[-500:] or result.stdout[-500:] or '送出失敗')
                self.state.update(status='已送到這個 Codex 會話的佇列', error='')
            self.save()
        else:
            raise ValueError('未知命令')
        return {'ok': True, 'status': self.state['status']}


def serve():
    CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (CACHE / 'daemon.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        ALIVE.touch()
        reader = Reader()
        if reader.config['source'] == 'terminal':
            reader.poll_terminal()
        elif reader.config['thread']:
            reader.bind(reader.config['thread'])
        SOCKET.unlink(missing_ok=True)
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(SOCKET))
            SOCKET.chmod(0o600)
            server.listen(4)
            while not reader.idle():
                # The dictation page and the setup screen write the language without telling the service.
                if changed_at() != reader.language_at:
                    reader.save()
                if time.monotonic() >= reader.retry_at:
                    try:
                        reader.poll()
                    except (OSError, ValueError) as exc:
                        reader.state.update(status='等待會話記錄', error=str(exc))
                        reader.save()
                        reader.retry_at = time.monotonic() + RETRY
                if not select.select([server], [], [], 0.5)[0]:
                    continue
                conn, _ = server.accept()
                with conn:
                    conn.settimeout(5)
                    try:
                        data = b''
                        while b'\n' not in data and len(data) <= 70000:
                            part = conn.recv(8192)
                            if not part:
                                break
                            data += part
                        if len(data) > 70000:
                            raise ValueError('請求太大')
                        response = reader.command(json.loads(data))
                    except Exception as exc:
                        response = {'ok': False, 'error': str(exc), 'error_ui': local(str(exc))}
                    try:
                        conn.sendall((json.dumps(response, ensure_ascii=False) + '\n').encode())
                    except OSError:
                        pass


def request(value):
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(25)
        client.connect(str(SOCKET))
        client.sendall((json.dumps(value, ensure_ascii=False) + '\n').encode())
        data = b''
        while b'\n' not in data:
            part = client.recv(8192)
            if not part:
                break
            data += part
        return json.loads(data)


def ensure():
    CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
    ALIVE.touch()
    try:
        request({'action': 'status'})
        return
    except (OSError, ValueError):
        pass
    with (CACHE / 'daemon.log').open('ab') as log:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'daemon'],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(30):
        try:
            request({'action': 'status'})
            return
        except (OSError, ValueError):
            time.sleep(0.1)
    raise ValueError('語音服務未啟動，請查看 ~/.cache/oma-voice/daemon.log')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['daemon', 'ensure', 'status', 'replay', 'stop', 'auto', 'bind', 'send', 'test', 'engine', 'refresh', 'follow', 'language', 'source', 'pause'])
    parser.add_argument('value', nargs='?')
    parser.add_argument('--text')
    parser.add_argument('--full', action='store_true')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    if args.action == 'language':
        if args.value not in LANGUAGES:
            raise ValueError(local('請選擇介面語言：')+' '.join(LANGUAGES))
        path = CHOICE
        path.parent.mkdir(parents=True, exist_ok=True)
        temp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
        temp.write_text(args.value)
        temp.chmod(0o600)
        temp.replace(path)
        try:
            request({'action': 'status'})
        except (OSError, ValueError):
            pass
        return
    if args.action == 'daemon':
        serve()
        return
    ensure()
    if args.action == 'ensure':
        return
    result = request({'action': args.action, 'value': args.value or 'toggle',
                      'thread': args.value, 'text': args.text or '', 'full': args.full})
    result['request_id'] = uuid.uuid4().hex
    if result.get('ok') is not False and 'status' in result:
        result['status_ui'] = local(result['status'])
    print(json.dumps(result, ensure_ascii=False) if args.action == 'status' or args.json else
          result.get('error_ui') or local(result.get('status', '完成')))
    if result.get('ok') is False:
        sys.exit(1)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        print(local(str(error)), file=sys.stderr)
        sys.exit(1)
OMA_VOICE_FILE_1_END
put "$HOME/.local/share/oma-voice/synthesize.py" <<'OMA_VOICE_FILE_2_END'
'''Edge TTS without API keys; local Piper/Sherpa fallback. Reads text on stdin.'''
import asyncio
import json
import os
import re
import subprocess
import shutil
from pathlib import Path
import sys

ROOT = Path(__file__).parent
sys.path.insert(0, str(ROOT))
from language import spoken

# The voice for each language a text can be spoken in: (Microsoft Edge online, espeak-ng offline).
SPEAKERS = {
    'en': ('en-US-AriaNeural', 'en-us'), 'zh': ('zh-CN-XiaoxiaoNeural', 'cmn'), 'es': ('es-ES-ElviraNeural', 'es'),
    'de': ('de-DE-KatjaNeural', 'de'), 'fr': ('fr-FR-DeniseNeural', 'fr'), 'ja': ('ja-JP-NanamiNeural', 'ja'),
    'ko': ('ko-KR-SunHiNeural', 'ko'),
}

# Why online speech was skipped, shown beside the offline voice's name.
NOT_INSTALLED = '線上語音未安裝'
NO_MPG123 = '缺少 mpg123'
UNREACHABLE = '線上語音無回應'

def offline(text, output, reason=''):
    note = '（'+reason+'）' if reason else ''
    runtime = ROOT / 'tts/sherpa-onnx-v1.13.8-linux-aarch64-shared-cpu/bin/sherpa-onnx-offline-tts'
    model = ROOT / 'tts/vits-piper-zh_CN-huayan-medium'
    if spoken(text) == 'zh' and runtime.exists() and (model / 'zh_CN-huayan-medium.onnx').exists():
        Path(str(output)+'.backend').write_text('離線神經語音'+note)
        os.execv(str(runtime), [str(runtime), '--vits-model='+str(model/'zh_CN-huayan-medium.onnx'),
                 '--vits-tokens='+str(model/'tokens.txt'), '--vits-data-dir='+str(model/'espeak-ng-data'),
                 '--num-threads=2', '--output-filename='+str(output), '--', text])
    Path(str(output)+'.backend').write_text('離線基本語音'+note)
    os.execvp('espeak-ng', ['espeak-ng', '-v', SPEAKERS[spoken(text)][1], '-s', '175', '-w', str(output), '--', text])

def pieces(text, limit=1200):
    # One request per piece: a long reply in one request ran past the time limit and fell back to espeak-ng.
    parts, current = [], ''
    for sentence in re.findall(r'[^。！？!?；;\n]*[。！？!?；;\n]+|[^。！？!?；;\n]+', text):
        while len(sentence) > limit:
            parts.append(current+sentence[:limit-len(current)])
            sentence, current = sentence[limit-len(current):], ''
        if len(current)+len(sentence) > limit:
            parts.append(current)
            current = ''
        current += sentence
    return [part for part in parts+[current] if part.strip()]

async def fetch(edge_tts, text, voice):
    audio = b''
    async for chunk in edge_tts.Communicate(text, voice=voice, rate='-5%').stream():
        if chunk['type'] == 'audio':
            audio += chunk['data']
    if not audio:
        raise RuntimeError('no audio')
    return audio

async def online(text, output):
    import edge_tts
    if not shutil.which('mpg123'):
        raise FileNotFoundError('mpg123')
    mp3 = output.with_suffix('.mp3')
    try:
        voice = SPEAKERS[spoken(text)][0]
        with mp3.open('wb') as audio:
            for part in pieces(text):
                for attempt in range(3):
                    try:
                        audio.write(await asyncio.wait_for(fetch(edge_tts, part, voice), timeout=30))
                        break
                    except Exception:
                        # A dropped connection is common on a phone; espeak-ng is the last resort.
                        if attempt == 2:
                            raise
                        await asyncio.sleep(1)
        subprocess.run(['mpg123', '-q', '-w', str(output), str(mp3)], check=True, timeout=120)
        Path(str(output)+'.backend').write_text('自然語音（線上）')
    finally:
        mp3.unlink(missing_ok=True)

if __name__ == '__main__':
    output = Path(sys.argv[1])
    text = sys.stdin.read().strip()
    if not text:
        raise SystemExit('沒有可播放的文字')
    config = json.loads((Path.home()/'.config/omalauncher/voice.json').read_text())
    reason = ''
    if config.get('engine') != 'offline':
        try:
            asyncio.run(online(text, output))
            raise SystemExit(0)
        except Exception as error:
            reason = NOT_INSTALLED if isinstance(error, ImportError) else NO_MPG123 if isinstance(error, FileNotFoundError) else UNREACHABLE
            print('線上語音不可用，改用離線：'+type(error).__name__+' '+str(error)[:200], file=sys.stderr)
            output.unlink(missing_ok=True)
    offline(text, output, reason)
OMA_VOICE_FILE_2_END
put "$HOME/.local/share/oma-speak/bash.sh" <<'OMA_VOICE_FILE_3_END'
# Insert at the cursor, preserving any existing input. Never press Enter.
_oma_speak_insert() {
  local dictated
  [[ -f $HOME/.cache/oma-speak/latest.txt ]] || return 0
  dictated=$(< "$HOME/.cache/oma-speak/latest.txt")
  READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}${dictated}${READLINE_LINE:READLINE_POINT}"
  READLINE_POINT=$((READLINE_POINT + ${#dictated}))
}
bind -x '"\C-g":_oma_speak_insert'
OMA_VOICE_FILE_3_END
put "$HOME/.local/share/oma-speak/index.html" <<'OMA_VOICE_FILE_4_END'
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0e17">
<title>語音輸入</title>
<style>
:root{color-scheme:dark;--bg:#0b0e17;--fg:#d9edf4;--accent:#78ffa2;--muted:#989db7;--line:#30364c;--panel:#111522}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 ui-monospace,"SFMono-Regular",Consolas,"Liberation Mono",monospace}
main{width:min(100%,640px);margin:auto;padding:28px 20px max(24px,env(safe-area-inset-bottom))}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:22px;border-bottom:1px solid var(--line)}
h1{font-size:26px;line-height:1.25;letter-spacing:.02em;color:var(--accent);margin:0;font-weight:500}
button,select,textarea{font:inherit;border-radius:4px}
button,select{min-height:46px;border:1px solid var(--line);background:transparent;color:var(--fg);padding:10px 14px}
button{cursor:pointer;touch-action:manipulation}
button:disabled{opacity:.35;cursor:default}
button:not(:disabled):hover{border-color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
select{max-width:100%;min-width:0;background:var(--panel)}
#ui-language{width:120px;font-size:14px}
.speech-language{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:22px 0 14px}
label,.editor-label{font-size:13px;color:var(--muted)}
#language{flex:1;max-width:260px}
.record-controls{display:grid;grid-template-columns:2fr 1fr;gap:10px}
.primary{border-color:var(--accent);background:var(--accent);color:var(--bg);font-weight:600}
#start{display:flex;align-items:center;justify-content:center;gap:10px}
.mic{width:16px;height:20px;flex:none}
.status-line{display:flex;align-items:baseline;gap:9px;margin:14px 0 24px;min-height:24px}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--muted);flex:none;align-self:flex-start;margin-top:9px}
body[data-listening="true"] .status-dot{background:var(--accent);box-shadow:0 0 0 4px #78ffa215}
#status{font-size:13px;color:var(--muted);margin:0;overflow-wrap:anywhere}
body[data-listening="true"] #status{color:var(--accent)}
.editor-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
.editor-actions{display:flex;gap:16px}
.editor-actions button{min-height:40px;padding:5px 0;font-size:13px;border:0;color:var(--muted);border-radius:0}
.editor-actions button:not(:disabled):hover{color:var(--accent)}
textarea{display:block;resize:vertical;width:100%;height:clamp(210px,34dvh,360px);min-height:160px;padding:16px;border:1px solid var(--line);background:var(--panel);color:var(--fg);line-height:1.7;caret-color:var(--accent)}
textarea::placeholder{color:#737b97}
#alternatives:empty{display:none}
#alternatives{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
#alternatives small{flex-basis:100%;color:var(--muted)}
#alternatives button{font-size:13px;text-align:left;overflow-wrap:anywhere;max-width:100%}
#save{width:100%;margin-top:16px}
.send-note{font-size:12px;color:var(--muted);margin:10px 0 0;text-align:center}
details{border-top:1px solid var(--line);margin-top:24px;padding-top:14px;color:var(--muted);font-size:12px}
summary{cursor:pointer;width:fit-content}details p{line-height:1.7;margin:10px 0 0}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:360px){main{padding:20px 16px}h1{font-size:23px}#ui-language{width:104px}.speech-language{gap:10px}#language{max-width:210px}}
@media(prefers-reduced-motion:no-preference){button{transition:background .15s,border-color .15s,color .15s}}
</style>
</head>
<body>
<main>
<header>
<h1>語音輸入</h1>
<label for="ui-language" class="sr-only">介面語言</label>
<select id="ui-language"><option value="en">English</option><option value="zh">中文</option><option value="es">Español</option><option value="de">Deutsch</option><option value="fr">Français</option><option value="ja">日本語</option><option value="ko">한국어</option></select>
</header>
<div class="speech-language">
<label for="language">辨識語言</label>
<select id="language"><option value="zh-TW">中文（台灣）</option><option value="zh-CN">中文（普通話）</option><option value="en-US">English</option><option value="es-ES">Español</option><option value="de-DE">Deutsch</option><option value="fr-FR">Français</option><option value="ja-JP">日本語</option><option value="ko-KR">한국어</option><option value="th-TH">ไทย</option></select>
</div>
<div class="record-controls">
<button id="start" class="primary"><svg class="mic" viewBox="0 0 16 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="1" width="6" height="11" rx="3"/><path d="M2 8v2a6 6 0 0 0 12 0V8M8 16v3M5 19h6"/></svg><span>開始聽寫</span></button>
<button id="stop" disabled>停止</button>
</div>
<div class="status-line"><span class="status-dot" aria-hidden="true"></span><p id="status" role="status" aria-live="polite">準備就緒</p></div>
<div class="editor-bar"><label for="text">文字</label><div class="editor-actions"><button id="copy">複製</button><button id="clear">清空</button></div></div>
<textarea id="text" maxlength="16000" placeholder="說話或在這裡輸入…" spellcheck="true"></textarea>
<div id="alternatives"></div>
<button id="save" class="primary">保存到首頁</button>
<p class="send-note">保存後，回首頁工具送出。</p>
<details><summary>關於語音辨識</summary><p>辨識使用瀏覽器的語音服務，可能將音訊傳給服務供應商。文字不會自動送到目前目標。</p></details>
</main>
<script>
const $=id=>document.getElementById(id),status=$('status'),text=$('text');
const token=location.hash.slice(1);history.replaceState(null,'',location.pathname);

// Chinese is what the page is written in; the other interface languages are looked up here.
const UI_STRINGS = {"語音輸入": {"en": "Dictation", "es": "Dictado", "de": "Diktat", "fr": "Dictée", "ja": "音声入力", "ko": "받아쓰기"}, "停止": {"en": "Stop", "es": "Parar", "de": "Stopp", "fr": "Arrêter", "ja": "停止", "ko": "정지"}, "保存到首頁": {"en": "Save to home", "es": "Guardar en inicio", "de": "Auf Start speichern", "fr": "Enregistrer sur l’accueil", "ja": "ホームに保存", "ko": "홈에 저장"}, "清空": {"en": "Clear", "es": "Borrar", "de": "Leeren", "fr": "Effacer", "ja": "クリア", "ko": "지우기"}, "辨識使用瀏覽器的語音服務，可能將音訊傳給服務供應商。文字不會自動送到目前目標。": {"en": "Browser speech recognition may send audio to its provider. Saving does not automatically send text to the selected target.", "es": "El reconocimiento de voz del navegador puede enviar audio al proveedor del servicio. Guardar no envía el texto al destino.", "de": "Die Spracherkennung des Browsers kann Audio an ihren Anbieter senden. Speichern sendet den Text nicht an das Ziel.", "fr": "La reconnaissance vocale du navigateur peut envoyer l’audio à son fournisseur. Enregistrer n’envoie pas le texte à la cible.", "ja": "ブラウザの音声認識は音声を提供元に送ることがあります。保存しただけでは送信先に送られません。", "ko": "브라우저 음성 인식은 오디오를 제공업체로 보낼 수 있습니다. 저장만으로는 대상에 전송되지 않습니다."}, "已停止，可保存文字。": {"en": "Stopped. You can save the text.", "es": "Detenido. Puedes guardar el texto.", "de": "Gestoppt. Der Text kann gespeichert werden.", "fr": "Arrêté. Vous pouvez enregistrer le texte.", "ja": "停止しました。テキストを保存できます。", "ko": "정지됨. 텍스트를 저장할 수 있습니다."}, "已清空。": {"en": "Cleared.", "es": "Borrado.", "de": "Geleert.", "fr": "Effacé.", "ja": "クリアしました。", "ko": "지웠습니다."}, "正在停止…": {"en": "Stopping…", "es": "Parando…", "de": "Stoppe…", "fr": "Arrêt…", "ja": "停止中…", "ko": "정지하는 중…"}, "保存失敗：": {"en": "Save failed: ", "es": "Error al guardar: ", "de": "Speichern fehlgeschlagen: ", "fr": "Échec de l’enregistrement : ", "ja": "保存に失敗：", "ko": "저장 실패: "}, "已複製。": {"en": "Copied.", "es": "Copiado.", "de": "Kopiert.", "fr": "Copié.", "ja": "コピーしました。", "ko": "복사했습니다."}, "請長按選取的文字並複製。": {"en": "Long-press the selected text to copy it.", "es": "Mantén pulsado el texto seleccionado para copiarlo.", "de": "Markierten Text lange drücken, um ihn zu kopieren.", "fr": "Appuyez longuement sur le texte sélectionné pour le copier.", "ja": "選択したテキストを長押ししてコピーしてください。", "ko": "선택한 텍스트를 길게 눌러 복사하세요."}, "此瀏覽器不支援語音辨識，請使用 Chrome 開啟。": {"en": "This browser does not support speech recognition. Open in Chrome.", "es": "Este navegador no admite el reconocimiento de voz. Ábrelo en Chrome.", "de": "Dieser Browser unterstützt keine Spracherkennung. In Chrome öffnen.", "fr": "Ce navigateur ne prend pas en charge la reconnaissance vocale. Ouvrez dans Chrome.", "ja": "このブラウザは音声認識に対応していません。Chrome で開いてください。", "ko": "이 브라우저는 음성 인식을 지원하지 않습니다. Chrome 에서 여세요."}, "麥克風權限被拒絕。請到 Android 設定 → 應用程式 → 目前瀏覽器 → 權限 → 麥克風，並在瀏覽器的本站設定允許麥克風。給 omalauncher 權限不會同時授權瀏覽器。": {"en": "Microphone denied. Allow the browser microphone permission in Android settings and browser site settings.", "es": "Micrófono denegado. Permite el micrófono al navegador en los ajustes de Android y en los ajustes del sitio.", "de": "Mikrofon verweigert. Dem Browser das Mikrofon in den Android-Einstellungen und den Website-Einstellungen erlauben.", "fr": "Micro refusé. Autorisez le micro pour le navigateur dans les réglages Android et les réglages du site.", "ja": "マイクが拒否されました。Android の設定とブラウザのサイト設定でマイクを許可してください。", "ko": "마이크가 거부되었습니다. Android 설정과 브라우저 사이트 설정에서 마이크를 허용하세요."}, "瀏覽器不允許此語音服務，請用 Chrome 開啟。": {"en": "Speech service blocked. Try Chrome.", "es": "Servicio de voz bloqueado. Prueba con Chrome.", "de": "Sprachdienst blockiert. Chrome versuchen.", "fr": "Service vocal bloqué. Essayez Chrome.", "ja": "音声サービスがブロックされました。Chrome をお試しください。", "ko": "음성 서비스가 차단되었습니다. Chrome 을 써 보세요."}, "無法取得麥克風。請確認瀏覽器權限，並關閉其他正在錄音的程式。": {"en": "Microphone unavailable. Check browser permissions and close other recording apps.", "es": "Micrófono no disponible. Revisa los permisos del navegador y cierra otras apps que graben.", "de": "Mikrofon nicht verfügbar. Browser-Berechtigungen prüfen und andere Aufnahme-Apps schließen.", "fr": "Micro indisponible. Vérifiez les autorisations du navigateur et fermez les autres applis qui enregistrent.", "ja": "マイクを使用できません。ブラウザの権限を確認し、録音中の他のアプリを閉じてください。", "ko": "마이크를 쓸 수 없습니다. 브라우저 권한을 확인하고 녹음 중인 다른 앱을 닫으세요."}, "語音服務連線失敗，請檢查網路後重試。": {"en": "Speech service network error. Check connection and retry.", "es": "Error de red del servicio de voz. Revisa la conexión y reintenta.", "de": "Netzwerkfehler beim Sprachdienst. Verbindung prüfen und erneut versuchen.", "fr": "Erreur réseau du service vocal. Vérifiez la connexion et réessayez.", "ja": "音声サービスのネットワークエラー。接続を確認して再試行してください。", "ko": "음성 서비스 네트워크 오류. 연결을 확인하고 다시 시도하세요."}, "沒聽到聲音，請按開始重試。": {"en": "No speech heard. Tap Start to retry.", "es": "No se oyó nada. Toca Iniciar para reintentar.", "de": "Nichts gehört. Starten antippen, um es erneut zu versuchen.", "fr": "Rien entendu. Touchez Démarrer pour réessayer.", "ja": "音声が聞こえませんでした。開始をタップして再試行してください。", "ko": "소리가 들리지 않았습니다. 시작을 눌러 다시 시도하세요."}, "此語音服務不支援所選語言，請切換語言。": {"en": "This speech service does not support the selected language.", "es": "Este servicio de voz no admite el idioma elegido.", "de": "Dieser Sprachdienst unterstützt die gewählte Sprache nicht.", "fr": "Ce service vocal ne prend pas en charge la langue choisie.", "ja": "この音声サービスは選択した言語に対応していません。", "ko": "이 음성 서비스는 선택한 언어를 지원하지 않습니다."}, "語音已停止。": {"en": "Speech stopped.", "es": "Voz detenida.", "de": "Sprache gestoppt.", "fr": "Voix arrêtée.", "ja": "音声を停止しました。", "ko": "음성이 멈췄습니다."}, "先按停止，再選候選文字。": {"en": "Tap Stop before choosing another transcript.", "es": "Toca Parar antes de elegir otra transcripción.", "de": "Vor der Wahl einer anderen Fassung Stopp antippen.", "fr": "Touchez Arrêter avant de choisir une autre transcription.", "ja": "別の候補を選ぶ前に停止をタップしてください。", "ko": "다른 후보를 고르기 전에 정지를 누르세요."}, "這句已修改，請直接編輯文字。": {"en": "This sentence was edited; change it directly.", "es": "Esta frase fue editada; cámbiala directamente.", "de": "Dieser Satz wurde bearbeitet; bitte direkt ändern.", "fr": "Cette phrase a été modifiée ; changez-la directement.", "ja": "この文は編集済みです。直接修正してください。", "ko": "이 문장은 수정되었습니다. 직접 고치세요."}, "請從首頁「語音輸入」重新開啟。": {"en": "Reopen from the Dictation widget.", "es": "Vuelve a abrir desde el widget Dictado.", "de": "Über das Diktat-Widget erneut öffnen.", "fr": "Rouvrez depuis le widget Dictée.", "ja": "音声入力ウィジェットから開き直してください。", "ko": "받아쓰기 위젯에서 다시 여세요."}, "辨識錯誤：": {"en": "Recognition error: ", "es": "Error de reconocimiento: ", "de": "Erkennungsfehler: ", "fr": "Erreur de reconnaissance : ", "ja": "認識エラー：", "ko": "인식 오류: "}, "無法開始：": {"en": "Could not start: ", "es": "No se pudo iniciar: ", "de": "Start nicht möglich: ", "fr": "Impossible de démarrer : ", "ja": "開始できません：", "ko": "시작할 수 없음: "}, "開始聽寫": {"en": "Start dictation", "es": "Iniciar dictado", "de": "Diktat starten", "fr": "Dicter", "ja": "音声入力を開始", "ko": "받아쓰기 시작"}, "準備就緒": {"en": "Ready", "es": "Listo", "de": "Bereit", "fr": "Prêt", "ja": "準備完了", "ko": "준비됨"}, "說話或在這裡輸入…": {"en": "Speak or type here…", "es": "Habla o escribe aquí…", "de": "Hier sprechen oder tippen…", "fr": "Parlez ou écrivez ici…", "ja": "話すか、ここに入力…", "ko": "말하거나 여기에 입력하세요…"}, "複製": {"en": "Copy", "es": "Copiar", "de": "Kopieren", "fr": "Copier", "ja": "コピー", "ko": "복사"}, "正在聽…": {"en": "Listening…", "es": "Escuchando…", "de": "Höre zu…", "fr": "Écoute…", "ja": "聞き取り中…", "ko": "듣는 중…"}, "已停止，可編輯文字。": {"en": "Stopped. Edit your text.", "es": "Detenido. Edita el texto.", "de": "Gestoppt. Text bearbeiten.", "fr": "Arrêté. Modifiez le texte.", "ja": "停止しました。編集できます。", "ko": "정지됨. 텍스트를 수정하세요."}, "已暫停，可編輯文字。": {"en": "Paused for editing.", "es": "En pausa para editar.", "de": "Zum Bearbeiten pausiert.", "fr": "En pause pour modifier.", "ja": "編集のため一時停止中。", "ko": "수정을 위해 일시정지됨."}, "已保存至首頁": {"en": "Saved to home", "es": "Guardado en inicio", "de": "Auf Start gespeichert", "fr": "Enregistré sur l’accueil", "ja": "ホームに保存しました", "ko": "홈에 저장됨"}, "其他辨識結果": {"en": "Alternatives", "es": "Alternativas", "de": "Alternativen", "fr": "Autres résultats", "ja": "他の候補", "ko": "다른 인식 결과"}, "介面語言": {"en": "Interface language", "es": "Idioma de interfaz", "de": "Anzeigesprache", "fr": "Langue de l’interface", "ja": "表示言語", "ko": "인터페이스 언어"}, "辨識語言": {"en": "Speech language", "es": "Idioma de voz", "de": "Gesprochene Sprache", "fr": "Langue parlée", "ja": "認識言語", "ko": "음성 언어"}, "文字": {"en": "Text", "es": "Texto", "de": "Text", "fr": "Texte", "ja": "テキスト", "ko": "텍스트"}, "保存後，回首頁工具送出。": {"en": "Save, then send from the home widget.", "es": "Guarda y envía desde el widget.", "de": "Speichern, dann im Widget senden.", "fr": "Enregistrez, puis envoyez depuis le widget.", "ja": "保存後、ホームのウィジェットから送信。", "ko": "저장 후 홈 위젯에서 보내세요."}, "關於語音辨識": {"en": "About speech recognition", "es": "Sobre el reconocimiento de voz", "de": "Über Spracherkennung", "fr": "À propos de la reconnaissance vocale", "ja": "音声認識について", "ko": "음성 인식 안내"}, "保存中…": {"en": "Saving…", "es": "Guardando…", "de": "Speichern…", "fr": "Enregistrement…", "ja": "保存中…", "ko": "저장 중…"}};
let uiLanguage='zh';
// The language spoken by default for each interface language.
const SPEECH={en:'en-US',zh:'zh-TW',es:'es-ES',de:'de-DE',fr:'fr-FR',ja:'ja-JP',ko:'ko-KR'};
const originalNodes=[];
const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
while(walker.nextNode()){const node=walker.currentNode;if(UI_STRINGS[node.textContent.trim()])originalNodes.push([node,node.textContent.trim()]);}
const originalPlaceholder=$('text').getAttribute('placeholder');
let updatingStatus=false;
function localize(value){if(uiLanguage==='zh')return value;for(const [zh,texts] of Object.entries(UI_STRINGS)){const text=texts[uiLanguage]||texts.en;if(value===zh)return text;if(value.startsWith(zh) && zh.endsWith('：'))return text+value.slice(zh.length);}return value;}
function applyLanguage(){
 document.documentElement.lang=uiLanguage==='zh'?'zh-Hant':uiLanguage;
 for(const [node,zh] of originalNodes)node.textContent=localize(zh);
 $('text').placeholder=localize(originalPlaceholder);
 $('ui-language').value=uiLanguage;
 document.title=localize('語音輸入');
 const raw=status.dataset.original || status.textContent;status.textContent=localize(raw);
}
const statusObserver=new MutationObserver(()=>{if(updatingStatus)return;updatingStatus=true;let v=status.textContent;const old=status.dataset.original;if(v!==localize(old||'')){status.dataset.original=v;const translated=localize(v);if(translated!==v)status.textContent=translated;}updatingStatus=false;});
statusObserver.observe(status,{childList:true,characterData:true,subtree:true});
$('ui-language').onchange=async()=>{
 const value=$('ui-language').value;
 try{const response=await fetch('/language',{method:'POST',headers:{'Content-Type':'application/json','X-Speak-Token':token},body:JSON.stringify({language:value})});if(!response.ok)throw Error(await response.text());uiLanguage=value;applyLanguage();}
 catch(error){$('ui-language').value=uiLanguage;status.textContent='Language change failed: '+error.message;}
};
fetch('/language').then(r=>r.text()).then(value=>{uiLanguage=SPEECH[value.trim()]?value.trim():'en';applyLanguage();if(!localStorage.getItem('oma-speak-language'))$('language').value=SPEECH[uiLanguage];}).catch(()=>{});

const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
let recognition=null,wanted=false,timer=null,failures=0,committed='',interim='',afterStop=null;
text.value=localStorage.getItem('oma-speak-draft')||'';
$('language').value=localStorage.getItem('oma-speak-language')||'zh-TW';
function persist(){localStorage.setItem('oma-speak-draft',text.value);}
text.oninput=persist;
function controls(){ document.body.dataset.listening=String(wanted||!!recognition); $('start').disabled=wanted||!!recognition||!Speech;$('stop').disabled=!wanted&&!recognition;$('language').disabled=wanted||!!recognition;text.readOnly=false; }
function halt(message){wanted=false;clearTimeout(timer);status.textContent=message;controls();}
function startSession(){
 if(!wanted||recognition)return;
 const r=new Speech();recognition=r;const base=text.value;committed=base;interim='';
 r.lang=$('language').value;r.interimResults=true;r.continuous=false;r.maxAlternatives=3;let endedByError=false;
 r.onstart=()=>{status.textContent='正在聽…';controls();};
 r.onresult=e=>{
  if(recognition!==r)return;
  // Results are a session snapshot, not new append-only sentences.
  let rendered=base;
  for(let i=0;i<e.results.length;i++){
   const result=e.results[i],words=result[0].transcript;
   const prefix=rendered+(rendered&&!/[\s\n]$/.test(rendered)?' ':'');
   if(result.isFinal)showAlternatives(result,prefix);
   rendered=prefix+words;
  }
  text.value=rendered;persist();
 };
 r.onerror=e=>{if(recognition!==r)return;endedByError=true;failures++;const errors={'not-allowed':'麥克風權限被拒絕。請到 Android 設定 → 應用程式 → 目前瀏覽器 → 權限 → 麥克風，並在瀏覽器的本站設定允許麥克風。給 omalauncher 權限不會同時授權瀏覽器。','service-not-allowed':'瀏覽器不允許此語音服務，請用 Chrome 開啟。','audio-capture':'無法取得麥克風。請確認瀏覽器權限，並關閉其他正在錄音的程式。','network':'語音服務連線失敗，請檢查網路後重試。','no-speech':'沒聽到聲音，請按開始重試。','language-not-supported':'此語音服務不支援所選語言，請切換語言。','aborted':'語音已停止。'};
 status.textContent=errors[e.error]||'辨識錯誤：'+e.error;
 halt(status.textContent);};
 r.onend=()=>{
  if(recognition!==r)return;
  recognition=null;wanted=false;persist();controls();
  if(afterStop){const f=afterStop;afterStop=null;f();}
  else if(!endedByError)status.textContent='已停止，可編輯文字。';
 };
 try{r.start();controls();}catch(e){recognition=null;halt('無法開始：'+e.message);}
}
function stopForEditing(){
 const r=recognition;recognition=null;wanted=false;clearTimeout(timer);afterStop=null;
 if(r)r.abort();controls();persist();
}
text.onfocus=()=>{if(recognition){stopForEditing();status.textContent='已暫停，可編輯文字。';}};
text.oninput=()=>{if(recognition)stopForEditing();persist();};
$('language').onchange=()=>localStorage.setItem('oma-speak-language',$('language').value);
function showAlternatives(result,prefix){
 const box=$('alternatives');box.replaceChildren();
 if(result.length<2)return;
 const label=document.createElement('small');label.textContent='其他辨識結果';box.append(label);
 for(let j=0;j<result.length;j++){
  const b=document.createElement('button');b.textContent=result[j].transcript;
  const original=prefix+result[0].transcript,candidate=prefix+result[j].transcript;
  b.onclick=()=>{if(recognition||wanted){status.textContent='先按停止，再選候選文字。';return;}if(!text.value.startsWith(original)){status.textContent='這句已修改，請直接編輯文字。';return;}text.value=candidate+text.value.slice(original.length);persist();box.replaceChildren();};box.append(b);
 }
}

$('start').onclick=()=>{failures=0;wanted=true;startSession();};
$('stop').onclick=()=>{halt('正在停止…');if(recognition)recognition.stop();else status.textContent='已停止，可保存文字。';};
async function save(){try{if(!token)throw Error('請從首頁「語音輸入」重新開啟。');const r=await fetch('/text',{method:'POST',headers:{'Content-Type':'application/json','X-Speak-Token':token},body:JSON.stringify({text:text.value}),signal:AbortSignal.timeout(10000)});const msg=await r.text();if(!r.ok)throw Error(msg);status.textContent='已保存至首頁';}catch(e){status.textContent='保存失敗：'+e.message;}}
$('save').onclick=()=>{wanted=false;clearTimeout(timer);if(recognition){afterStop=save;recognition.stop();}else save();controls();};
$('copy').onclick=async()=>{try{await navigator.clipboard.writeText(text.value);status.textContent='已複製。';}catch(e){text.focus();text.select();status.textContent='請長按選取的文字並複製。';}};
$('clear').onclick=()=>{halt('已清空。');afterStop=null;if(recognition){recognition.onresult=null;recognition.abort();}text.value='';committed='';interim='';$('alternatives').replaceChildren();persist();};
document.addEventListener('visibilitychange',()=>{if(document.hidden){wanted=false;clearTimeout(timer);if(recognition)recognition.stop();persist();}});
if(!Speech)status.textContent='此瀏覽器不支援語音辨識，請使用 Chrome 開啟。';controls();
</script>
</body>
</html>
OMA_VOICE_FILE_4_END
put "$HOME/.local/share/oma-speak/server.py" <<'OMA_VOICE_FILE_5_END'
import hmac
import json
import os
from pathlib import Path
import secrets
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CACHE = Path.home() / '.cache/oma-speak'
CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
TOKEN = secrets.token_urlsafe(32)
PORT = 18763
ORIGIN = f'http://127.0.0.1:{PORT}'
PAGE_PATH = Path(__file__).with_name('index.html')
LANG_PATH = Path.home() / '.config/omalauncher/voice-ui-language'
LANGUAGES = ('en', 'zh', 'es', 'de', 'fr', 'ja', 'ko')

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, data, kind='text/plain; charset=utf-8'):
        data = data.encode()
        self.send_response(code)
        self.send_header('Content-Type', kind)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Frame-Options', 'DENY')
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.headers.get('Host') != f'127.0.0.1:{PORT}':
            return self.reply(403, 'Invalid host')
        if self.path == '/language':
            value = LANG_PATH.read_text().strip() if LANG_PATH.exists() else ''
            return self.reply(200, value if value in LANGUAGES else LANGUAGES[0])
        if self.path == '/health':
            return self.reply(200, 'oma-speak-v1')
        if self.path != '/':
            return self.reply(404, 'Not found')
        self.reply(200, PAGE_PATH.read_text(), 'text/html; charset=utf-8')

    def do_POST(self):
        if (self.path not in ('/text', '/language') or self.headers.get('Origin') != ORIGIN
                or not hmac.compare_digest(self.headers.get('X-Speak-Token', ''), TOKEN)):
            return self.reply(403, 'Forbidden')
        try:
            size = int(self.headers.get('Content-Length', '0'))
            if not 0 < size <= 65536:
                return self.reply(413, 'Text too long')
            body = json.loads(self.rfile.read(size))
            if self.path == '/language':
                value = body.get('language')
                if value not in LANGUAGES:
                    raise ValueError()
                LANG_PATH.parent.mkdir(parents=True, exist_ok=True)
                temp = LANG_PATH.with_name(LANG_PATH.name+'.tmp')
                temp.write_text(value)
                os.chmod(temp, 0o600)
                temp.replace(LANG_PATH)
                return self.reply(200, 'Language saved')
            text = body['text']
            if not isinstance(text, str) or len(text) > 16000:
                raise ValueError()
            # Keep terminal escape/control sequences out of Bash insertion.
            text = ''.join(c for c in text if c >= ' ' and c != '\x7f').strip()
            tmp = CACHE / 'latest.tmp'
            tmp.write_text(text)
            os.chmod(tmp, 0o600)
            tmp.replace(CACHE / 'latest.txt')
            self.reply(200, 'Saved. Return to the launcher and tap Send to target.')
        except (ValueError, KeyError, TypeError, UnicodeError):
            self.reply(400, 'Invalid text')

if __name__ == '__main__':
    server = ThreadingHTTPServer(('127.0.0.1', PORT), Handler)
    server.daemon_threads = True
    tokenfile = CACHE / 'token'
    tokenfile.write_text(TOKEN)
    os.chmod(tokenfile, 0o600)
    server.serve_forever()
OMA_VOICE_FILE_5_END
put "$HOME/.local/bin/oma-send-dictation" <<'OMA_VOICE_FILE_6_END'
#!/usr/bin/python
import pathlib, subprocess, json, sys
home = pathlib.Path.home()
sys.path.insert(0, str(home/'.local/share/oma-voice'))
from language import local
try:
    text = home.joinpath('.cache/oma-speak/latest.txt').read_text().strip()
    if not text:
        raise ValueError()
    subprocess.run([str(home/'.local/bin/oma-voice'), 'send', '--json', '--text', text], check=False)
except (OSError, ValueError):
    message = '請先開始語音輸入，停止後保存。'
    print(json.dumps({'ok': False, 'error': message, 'error_ui': local(message)}, ensure_ascii=False))
OMA_VOICE_FILE_6_END
put "$HOME/.local/bin/oma-voice" <<'OMA_VOICE_FILE_7_END'
#!/bin/sh
exec python "$HOME/.local/share/oma-voice/oma_voice.py" "$@"
OMA_VOICE_FILE_7_END
put "$HOME/.local/bin/speak" <<'OMA_VOICE_FILE_8_END'
#!/bin/bash
set -eu
cache="$HOME/.cache/oma-speak"
case "${1:-}" in
  --text) cat "$cache/latest.txt" 2>/dev/null || true; exit ;;
  --help) echo 'speak: open voice input; speak --text: print latest dictation. Bash Ctrl+G inserts it.'; exit ;;
  '') ;;
  *) echo 'Usage: speak [--text|--help]' >&2; exit 2 ;;
esac
mkdir -p "$cache"
exec 9>"$cache/start.lock"
flock 9
if ! curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then
  nohup python "$HOME/.local/share/oma-speak/server.py" >"$cache/server.log" 2>&1 < /dev/null 9>&- &
  for ((i=0;i<40;i++)); do
    if curl --noproxy '*' -fsS --max-time 1 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then break; fi
    sleep .1
  done
fi
if ! curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then
  echo "Could not start voice input. See $cache/server.log" >&2; exit 1
fi
token=$(cat "$cache/token")
flock -u 9
xdg-open "http://127.0.0.1:18763/#$token"
OMA_VOICE_FILE_8_END
chmod u+x "$HOME/.local/bin/oma-send-dictation" "$HOME/.local/bin/oma-voice" "$HOME/.local/bin/speak"
venv="$share/oma-voice/venv"
[ -x "$venv/bin/python" ] || python -m venv "$venv" || { say failed; exit 1; }
# Without the network this fails and speech stays offline (espeak-ng) until the next setup.
"$venv/bin/python" -m pip install --quiet --disable-pip-version-check edge-tts==7.2.8 || echo "edge-tts was not installed"
# Stop the old voice service and dictation page; the widget starts the new ones.
pkill -f '^[^ ]*python[0-9.]* .*/oma_voice\.py daemon$' || true
pkill -f '^[^ ]*python[0-9.]* .*/oma-speak/server\.py$' || true
printf '%s' '3.4-1acdf3a4' > "$HOME/.local/share/oma-voice/store-version"
say done
""") }
   Button { fill: width; height: 36; text: (uiLanguage == "zh" ? "詳情" : uiLanguage == "es" ? "Detalles" : uiLanguage == "de" ? "Details" : uiLanguage == "fr" ? "Détails" : uiLanguage == "ja" ? "詳細" : uiLanguage == "ko" ? "상세" : "Details"); onTap: screen() }
  } else {
  Text { text: (uiLanguage == "zh" ? "語音輸入" : uiLanguage == "es" ? "DICTADO" : uiLanguage == "de" ? "DIKTAT" : uiLanguage == "fr" ? "DICTÉE" : uiLanguage == "ja" ? "音声入力" : uiLanguage == "ko" ? "받아쓰기" : "DICTATION"); style: label; color: accent }
  Button { fill: width; height: 36; text: (uiLanguage == "zh" ? "開始語音輸入" : uiLanguage == "es" ? "Iniciar dictado" : uiLanguage == "de" ? "Diktat starten" : uiLanguage == "fr" ? "Démarrer la dictée" : uiLanguage == "ja" ? "音声入力を開始" : uiLanguage == "ko" ? "받아쓰기 시작" : "Start dictation"); onTap: run("bash ~/.local/bin/speak") }
  Text { text: (uiLanguage == "zh" ? "送入：${voice.source == 'terminal' ? (voice.source_name ?? '終端') : 'Codex 會話'}" : uiLanguage == "es" ? "Enviar a: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'chat de Codex'}" : uiLanguage == "de" ? "Senden an: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'Codex-Chat'}" : uiLanguage == "fr" ? "Envoyer à : ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'chat Codex'}" : uiLanguage == "ja" ? "送信先：${voice.source == 'terminal' ? (voice.source_name ?? 'ターミナル') : 'Codex チャット'}" : uiLanguage == "ko" ? "보낼 곳: ${voice.source == 'terminal' ? (voice.source_name ?? '터미널') : 'Codex 채팅'}" : "Send to: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'Codex chat'}"); style: small; color: accent; maxLines: 2 }
  Text { text: latest == "" || latest == null ? (uiLanguage == "zh" ? "開始 → 說話 → 停止並保存" : uiLanguage == "es" ? "Iniciar → hablar → parar y guardar" : uiLanguage == "de" ? "Starten → sprechen → stoppen und speichern" : uiLanguage == "fr" ? "Démarrer → parler → arrêter et enregistrer" : uiLanguage == "ja" ? "開始 → 話す → 停止して保存" : uiLanguage == "ko" ? "시작 → 말하기 → 정지 후 저장" : "Start → speak → stop and save") : latest; style: small; maxLines: 3; weight: 1 }
  Text { text: result == "" ? (uiLanguage == "zh" ? "保存後可送出" : uiLanguage == "es" ? "Guarda y luego envía" : uiLanguage == "de" ? "Speichern, dann senden" : uiLanguage == "fr" ? "Enregistrez, puis envoyez" : uiLanguage == "ja" ? "保存してから送信" : uiLanguage == "ko" ? "저장한 뒤 전송" : "Save, then send") : parseJson(result).ok ? (uiLanguage == "zh" ? "已送到目前目標" : uiLanguage == "es" ? "Enviado al destino actual" : uiLanguage == "de" ? "An das aktuelle Ziel gesendet" : uiLanguage == "fr" ? "Envoyé à la cible actuelle" : uiLanguage == "ja" ? "現在の送信先に送りました" : uiLanguage == "ko" ? "현재 대상으로 보냈습니다" : "Sent to current target") : parseJson(result).error_ui ?? (uiLanguage == "zh" ? "送出完成" : uiLanguage == "es" ? "Solicitud completada" : uiLanguage == "de" ? "Anfrage abgeschlossen" : uiLanguage == "fr" ? "Demande terminée" : uiLanguage == "ja" ? "送信が完了しました" : uiLanguage == "ko" ? "요청 완료" : "Request completed"); style: small; maxLines: 2 }
  Row {
   gap: 4
   if sending { Text { text: (uiLanguage == "zh" ? "正在送出…" : uiLanguage == "es" ? "Enviando…" : uiLanguage == "de" ? "Sende…" : uiLanguage == "fr" ? "Envoi…" : uiLanguage == "ja" ? "送信中…" : uiLanguage == "ko" ? "전송 중…" : "Sending…"); style: small; color: accent; weight: 1 } }
   else { Button { height: 36; weight: 1; text: (uiLanguage == "zh" ? "送出" : uiLanguage == "es" ? "Enviar" : uiLanguage == "de" ? "Senden" : uiLanguage == "fr" ? "Envoyer" : uiLanguage == "ja" ? "送信" : uiLanguage == "ko" ? "보내기" : "Send"); onTap: { sending = true; result = run("python ~/.local/bin/oma-send-dictation") } } }
   Button { height: 36; weight: 1; text: (uiLanguage == "zh" ? "詳情" : uiLanguage == "es" ? "Detalles" : uiLanguage == "de" ? "Details" : uiLanguage == "fr" ? "Détails" : uiLanguage == "ja" ? "詳細" : uiLanguage == "ko" ? "상세" : "Details"); onTap: screen() }
  }
  }
 }
 screen {
  title: (uiLanguage == "zh" ? "語音輸入" : uiLanguage == "es" ? "DICTADO" : uiLanguage == "de" ? "DIKTAT" : uiLanguage == "fr" ? "DICTÉE" : uiLanguage == "ja" ? "音声入力" : uiLanguage == "ko" ? "받아쓰기" : "DICTATION")
  Column {
   fill: true
   height: screenHeight
   gap: 10
   Button { fill: width; height: 44; text: (uiLanguage == "zh" ? "返回" : uiLanguage == "es" ? "Volver" : uiLanguage == "de" ? "Zurück" : uiLanguage == "fr" ? "Retour" : uiLanguage == "ja" ? "戻る" : uiLanguage == "ko" ? "뒤로" : "Back"); onTap: close() }
   Column {
    fill: width
    scroll: true
    height: max(1, screenHeight - 54)
    gap: 12
    if !ready { Text { text: (uiLanguage == "zh" ? "尚未安裝或需要更新：請返回首頁，在此小工具上按「安裝」。" : uiLanguage == "es" ? "Aún sin instalar: vuelve y toca Instalar en el widget." : uiLanguage == "de" ? "Noch nicht eingerichtet: zurückgehen und im Widget Einrichten antippen." : uiLanguage == "fr" ? "Pas encore installé : revenez et touchez Installer sur le widget." : uiLanguage == "ja" ? "未インストール：戻ってウィジェットの「インストール」をタップしてください。" : uiLanguage == "ko" ? "아직 설치되지 않았습니다. 돌아가서 위젯의 설치를 누르세요." : "Not set up yet: go back and tap Set up on the tile."); color: yellow; maxLines: 3 } }
    Button { fill: width; height: 44; text: (uiLanguage == "zh" ? "開始語音輸入" : uiLanguage == "es" ? "Iniciar dictado" : uiLanguage == "de" ? "Diktat starten" : uiLanguage == "fr" ? "Démarrer la dictée" : uiLanguage == "ja" ? "音声入力を開始" : uiLanguage == "ko" ? "받아쓰기 시작" : "Start dictation"); onTap: run("bash ~/.local/bin/speak") }
    Text { text: (uiLanguage == "zh" ? "送入：${voice.source == 'terminal' ? (voice.source_name ?? '終端') : 'Codex 會話'}" : uiLanguage == "es" ? "Enviar a: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'chat de Codex'}" : uiLanguage == "de" ? "Senden an: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'Codex-Chat'}" : uiLanguage == "fr" ? "Envoyer à : ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'chat Codex'}" : uiLanguage == "ja" ? "送信先：${voice.source == 'terminal' ? (voice.source_name ?? 'ターミナル') : 'Codex チャット'}" : uiLanguage == "ko" ? "보낼 곳: ${voice.source == 'terminal' ? (voice.source_name ?? '터미널') : 'Codex 채팅'}" : "Send to: ${voice.source == 'terminal' ? (voice.source_name ?? 'Terminal') : 'Codex chat'}"); color: accent; maxLines: 2 }
    Text { text: latest == "" || latest == null ? (uiLanguage == "zh" ? "開始 → 說話 → 停止並保存" : uiLanguage == "es" ? "Iniciar → hablar → parar y guardar" : uiLanguage == "de" ? "Starten → sprechen → stoppen und speichern" : uiLanguage == "fr" ? "Démarrer → parler → arrêter et enregistrer" : uiLanguage == "ja" ? "開始 → 話す → 停止して保存" : uiLanguage == "ko" ? "시작 → 말하기 → 정지 후 저장" : "Start → speak → stop and save") : latest; maxLines: 160 }
    Text { text: result == "" ? (uiLanguage == "zh" ? "保存後可送出" : uiLanguage == "es" ? "Guarda y luego envía" : uiLanguage == "de" ? "Speichern, dann senden" : uiLanguage == "fr" ? "Enregistrez, puis envoyez" : uiLanguage == "ja" ? "保存してから送信" : uiLanguage == "ko" ? "저장한 뒤 전송" : "Save, then send") : parseJson(result).ok ? (uiLanguage == "zh" ? "已送到目前目標" : uiLanguage == "es" ? "Enviado al destino actual" : uiLanguage == "de" ? "An das aktuelle Ziel gesendet" : uiLanguage == "fr" ? "Envoyé à la cible actuelle" : uiLanguage == "ja" ? "現在の送信先に送りました" : uiLanguage == "ko" ? "현재 대상으로 보냈습니다" : "Sent to current target") : parseJson(result).error_ui ?? (uiLanguage == "zh" ? "送出完成" : uiLanguage == "es" ? "Solicitud completada" : uiLanguage == "de" ? "Anfrage abgeschlossen" : uiLanguage == "fr" ? "Demande terminée" : uiLanguage == "ja" ? "送信が完了しました" : uiLanguage == "ko" ? "요청 완료" : "Request completed"); style: small; maxLines: 3 }
    Row {
     gap: 4
     if sending { Text { text: (uiLanguage == "zh" ? "正在送出…" : uiLanguage == "es" ? "Enviando…" : uiLanguage == "de" ? "Sende…" : uiLanguage == "fr" ? "Envoi…" : uiLanguage == "ja" ? "送信中…" : uiLanguage == "ko" ? "전송 중…" : "Sending…"); color: accent; weight: 1 } }
     else { Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "送到目前目標" : uiLanguage == "es" ? "Enviar al destino" : uiLanguage == "de" ? "An Ziel senden" : uiLanguage == "fr" ? "Envoyer à la cible" : uiLanguage == "ja" ? "送信先に送る" : uiLanguage == "ko" ? "대상으로 보내기" : "Send to target"); onTap: { sending = true; result = run("python ~/.local/bin/oma-send-dictation") } } }
     Button { weight: 1; height: 44; text: (uiLanguage == "zh" ? "複製內容" : uiLanguage == "es" ? "Copiar texto" : uiLanguage == "de" ? "Text kopieren" : uiLanguage == "fr" ? "Copier le texte" : uiLanguage == "ja" ? "テキストをコピー" : uiLanguage == "ko" ? "텍스트 복사" : "Copy text"); onTap: copy(latest) }
    }
    Text { text: (uiLanguage == "zh" ? "介面語言" : uiLanguage == "es" ? "Idioma de la interfaz" : uiLanguage == "de" ? "Sprache der Oberfläche" : uiLanguage == "fr" ? "Langue de l’interface" : uiLanguage == "ja" ? "表示言語" : uiLanguage == "ko" ? "표시 언어" : "Interface language"); color: accent; bold: true }
    Grid {
     columns: 2
     gap: 8
     Button { fill: width; height: 44; text: "English"; onTap: run("mkdir -p ~/.config/omalauncher && printf en > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "中文"; onTap: run("mkdir -p ~/.config/omalauncher && printf zh > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "Español"; onTap: run("mkdir -p ~/.config/omalauncher && printf es > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "Deutsch"; onTap: run("mkdir -p ~/.config/omalauncher && printf de > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "Français"; onTap: run("mkdir -p ~/.config/omalauncher && printf fr > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "日本語"; onTap: run("mkdir -p ~/.config/omalauncher && printf ja > ~/.config/omalauncher/voice-ui-language") }
     Button { fill: width; height: 44; text: "한국어"; onTap: run("mkdir -p ~/.config/omalauncher && printf ko > ~/.config/omalauncher/voice-ui-language") }
    }
   }
  }
 }
