# Messages that end in a detail: 'prefix' + what follows.
PREFIXES = {
    '正在播放 · ': ('Playing · ', 'Leyendo · ', 'Wiedergabe · ', 'Lecture · ', '再生中 · ', '재생 중 · '),
    '播放完成 · ': ('Finished · ', 'Terminado · ', 'Beendet · ', 'Terminé · ', '完了 · ', '완료 · '),
