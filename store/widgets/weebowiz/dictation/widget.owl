put "$HOME/.local/share/oma-voice/oma_voice.py" <<'OMA_VOICE_FILE_2_END'
#!/usr/bin/env python3
'''Voice reader and dictation bridge for Codex logs or a tmux terminal.'''
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import select
import shutil
import socket
import subprocess
import sys
import threading
import time
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent))
from language import CHOICE, LANGUAGES, SPOKEN, changed_at, chosen, local, spoken
import codex_queue


HOME = Path.home()
CACHE = HOME / '.cache/oma-voice'
SOCKET = CACHE / 'control.sock'
CONFIG = HOME / '.config/omalauncher/voice.json'
SESSIONS = HOME / '.codex/sessions'
# Claude Code keeps one transcript per conversation here, whatever terminal it runs in.
CLAUDE_PROJECTS = HOME / '.claude/projects'
SOURCES = ('codex', 'claude', 'terminal')
TMUX_SESSION = 'oma-voice'
# ensure() touches this. The service quits once neither it nor the Codex log has changed
# for the 'pause_minutes' setting (0 = never), and ensure() starts it again.
ALIVE = CACHE / 'alive'
PAUSE_MINUTES = 10
# Seconds between looks for a Codex session or tmux pane while there is none.
RETRY = 15


def sweep(keep=''):
    '''Remove audio from earlier readings. Some Android file systems refuse to delete a file the
    player still holds, so what one reading leaves behind goes when the next one starts.'''
    for old in CACHE.glob('speech-*'):
        if keep and old.name.startswith(keep):
            continue
        try:
            old.unlink()
        except OSError:
            pass


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
    tmp.write_text(json.dumps(value, ensure_ascii=False))
    tmp.chmod(0o600)
    tmp.replace(path)


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def clean_text(text):
    # Spoken notes are in the language of the reply, or the wrong voice would be picked for it.
    notes = SPOKEN[spoken(text)]
    text = re.sub(r'```.*?```', notes[2], text, flags=re.S)
    text = re.sub(r'!?\[([^\]]+)\]\([^)]*\)', r'\1', text)
    text = re.sub(r'https?://\S+', notes[3], text)
    text = re.sub(r'(?m)^\s*(?:#{1,6}\s+|[-*+]\s+|\d+[.)]\s+|>\s*)', '', text)
    text = text.replace('`', '').replace('**', '').replace('__', '')
    return ''.join(c for c in text if c in '\n\t' or (ord(c) >= 32 and ord(c) != 127)).strip()


def readable(text):
    '''The reply as the detail page shows it: Markdown marks taken out, code and links kept.'''
    text = re.sub(r'(?m)^\s*```.*$', '', text or '')
    text = re.sub(r'!?\[([^\]]+)\]\(([^)]*)\)', r'\1 (\2)', text)
    text = re.sub(r'(?m)^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$\n?', '', text)
    text = re.sub(r'(?m)^\s*\|(.*)\|\s*$', lambda m: ' · '.join(c.strip() for c in m.group(1).split('|') if c.strip()), text)
    text = re.sub(r'(?m)^(\s*)#{1,6}\s+', r'\1', text)
    text = re.sub(r'(?m)^(\s*)[-*+]\s+', r'\1• ', text)
    text = re.sub(r'(?m)^>\s?', '', text)
    text = text.replace('**', '').replace('__', '').replace('`', '')
    return re.sub(r'\n{3,}', '\n\n', text).strip()


def summarize(text, limit=360):
    '''Extract sentences verbatim; retain an explicit failure/limitation if present.'''
    text = clean_text(text)
    if len(text) <= limit:
        return text
    sentences = [s.strip() for s in re.split(r'(?<=[。！？.!?])\s*|\n+', text) if s.strip()]
    selected = []
    important = re.compile(r'未完成|尚未|無法|不能|失敗|限制|需要你|待.*確認|未.*驗證|未.*測試|not tested|failed|unable|cannot|limitation', re.I)
    warning = next((s for s in sentences if important.search(s)), '')
    # Reserve room for a caveat even when it appears at the end of a long answer.
    budget = limit - min(len(warning), limit // 2) - (8 if warning else 0)
    used = 0
    for s in sentences:
        if s == warning:
            continue
        if used + len(s) > budget:
            if not selected:
                selected.append(s[:budget].rstrip() + '…')
            break
        selected.append(s)
        used += len(s) + 1
    if warning:
        selected.append(warning[:limit // 2])
    notes = SPOKEN[spoken(text)]
    return notes[0] + ' '.join(selected) + notes[1]


def codex_event(event):
    '''('start'|'end', None) or ('reply', (turn, text)); commentary, tool output and subagents are skipped.'''
    payload = event.get('payload')
    if event.get('type') != 'event_msg' or not isinstance(payload, dict):
        return None
    kind = payload.get('type')
    text = payload.get('last_agent_message')
    if kind == 'task_complete' and isinstance(text, str) and text.strip():
        return 'reply', (payload.get('turn_id') or payload.get('root_turn_id') or event.get('timestamp'), text)
    if kind == 'task_started':
        return 'start', None
    if kind in ('task_complete', 'turn_aborted'):
        return 'end', None
    return None


def claude_event(event):
    '''('start', None) when the user asks Claude something, ('reply', (id, text)) for its final answer.'''
    if event.get('isSidechain'):
        return None
    message = event.get('message')
    if not isinstance(message, dict):
        return None
    content = message.get('content')
    if event.get('type') == 'user':
        # Tool results come back as user entries too; only typed prompts start a turn.
        if isinstance(content, str) or (isinstance(content, list) and any(
                isinstance(part, dict) and part.get('type') == 'text' for part in content)):
            return 'start', None
        return None
    if event.get('type') != 'assistant' or message.get('stop_reason') != 'end_turn' or not isinstance(content, list):
        return None
    text = '\n\n'.join(part.get('text', '') for part in content
                         if isinstance(part, dict) and part.get('type') == 'text').strip()
    if not text:
        return None
    return 'reply', (event.get('requestId') or message.get('id') or event.get('uuid'), text)


def latest_claude():
    files = list(CLAUDE_PROJECTS.glob('*/*.jsonl'))
    if not files:
        raise ValueError('找不到 Claude 會話')
    return max(files, key=lambda p: p.stat().st_mtime)


def claude_pane():
    '''The oma-voice tmux pane, only if Claude runs in it: the one place a Claude chat can be typed into.'''
    try:
        pane, label, _ = terminal_snapshot()
    except ValueError:
        return None
    return pane if label == 'Claude' else None


def find_session(thread):
    # Session IDs are data, never shell expressions or path components.
    thread = str(uuid.UUID(thread))
    return next(SESSIONS.rglob('*' + thread + '.jsonl'), None)


def latest_session():
    files = list(SESSIONS.rglob('*.jsonl'))
    if not files:
        raise ValueError('找不到 Codex 會話')
    path = max(files, key=lambda p: p.stat().st_mtime)
    with path.open() as f:
        meta = json.loads(f.readline()).get('payload', {})
    return str(uuid.UUID(meta.get('id') or meta.get('session_id')))


def terminal_snapshot():
    '''Read only the current pane of the dedicated, user-entered tmux session.'''
    if not shutil.which('tmux'):
        raise ValueError('需要 tmux / tmux is required')
    pane = subprocess.run(['tmux', 'display-message', '-p', '-t', TMUX_SESSION, '#{pane_id}'],
                          capture_output=True, text=True, timeout=3)
    if pane.returncode or not re.fullmatch(r'%[0-9]+', pane.stdout.strip()):
        raise ValueError('請在現有終端執行 tmux new -A -s oma-voice')
    pane_id = pane.stdout.strip()
    command = subprocess.run(['tmux', 'display-message', '-p', '-t', pane_id, '#{pane_current_command}'],
                             capture_output=True, text=True, timeout=3).stdout.strip()
    output = subprocess.run(['tmux', 'capture-pane', '-p', '-t', pane_id, '-S', '-80'],
                            capture_output=True, text=True, timeout=3)
    if output.returncode:
        raise ValueError('無法讀取終端畫面')
    clean = ''.join(ch for ch in output.stdout if ch in '\n\t' or ord(ch) >= 32)
    clean = '\n'.join(line.rstrip() for line in clean.splitlines()).strip()
    label = 'Claude' if 'claude' in command.lower() else 'Codex' if 'codex' in command.lower() else (command or 'Terminal')
    return pane_id, label, clean[-6000:]


def terminal_send(pane_id, text):
    '''Submit one explicit user action to the already selected tmux pane.'''
    if not re.fullmatch(r'%[0-9]+', pane_id):
        raise ValueError('無效的終端窗格')
    text = ' '.join(text.splitlines()).strip()
    for keys in (['-l', text], ['Enter']):
        if keys == ['Enter']:
            # Codex and Claude read an Enter right after fast typing as part of a paste: a newline, not submit.
            time.sleep(0.5)
        result = subprocess.run(['tmux', 'send-keys', '-t', pane_id, *keys],
                                capture_output=True, text=True, timeout=5)
        if result.returncode:
            raise ValueError(result.stderr.strip() or '終端輸入失敗')


class Reader:
    def __init__(self):
        self.config = read_json(CONFIG, {})
        self.config.setdefault('auto', True)
        self.config.setdefault('mode', 'summary')
        self.config.setdefault('language', 'cmn')
        self.config.setdefault('rate', 175)
        self.config.setdefault('engine', 'online')
        if not self.config.get('thread'):
            try:
                self.config['thread'] = latest_session()
            except ValueError:
                self.config['thread'] = None
        self.config.setdefault('follow_latest', True)
        self.config.setdefault('source', 'codex')
        self.config.setdefault('pause_minutes', PAUSE_MINUTES)
        self.term_last = None
        self.checked_session = 0
        self.next_terminal = 0
        self.retry_at = 0
        self.saved = None
        atomic_json(CONFIG, self.config)
        self.state = read_json(CACHE / 'state.json', {})
        self.state.update(status='已連接，等待回覆', playing=False, error='')
        self.process = None
        self.player_lock = threading.RLock()
        self.generation = 0
        self.path = None
        self.offset = 0
        self.pending = b''
        self.last_turn = None
        self.save()

    def save(self):
        # The tiles show these; 'status' and 'error' stay as written, for the next change of language.
        language = chosen()
        self.language_at = changed_at()
        self.state['status_ui'] = local(self.state.get('status', ''), language)
        self.state['error_ui'] = local(self.state.get('error', ''), language)
        self.state['full_view'] = readable(self.state.get('full') or '')
        for old in ('status_en', 'error_en', 'checked_at'):
            self.state.pop(old, None)
        stamp = self.state.get('reply_at')
        if isinstance(stamp, str):
            try:
                self.state['reply_at'] = datetime.datetime.fromisoformat(stamp.replace('Z', '+00:00')).timestamp()
            except ValueError:
                self.state['reply_at'] = None
        self.state.update(auto=self.config['auto'], mode=self.config['mode'], thread=self.config['thread'], engine=self.config['engine'], follow_latest=self.config['follow_latest'], source=self.config['source'], pause_minutes=self.config['pause_minutes'], source_name=self.state.get('source_name','Codex'))
        # The tiles redraw on every write, so write only what changed.
        if self.state != self.saved:
            atomic_json(CACHE / 'state.json', self.state)
            self.saved = dict(self.state)

    def open_log(self, path):
        '''Follow a chat log from its end; older answers are shown, never read aloud.'''
        self.path, self.pending, self.last_turn = path, b'', None
        self.state.update(full='', summary='', last_turn='', reply_at=None, awaiting=False)
        with path.open('rb') as f:
            for line in f:
                self.take(line, live=False)
            self.offset = f.tell()
        name = 'Claude' if self.config['source'] == 'claude' else 'Codex'
        self.state['status'] = name+' 正在回覆…' if self.state['awaiting'] else ('已同步最近回覆' if self.state['full'] else '已連接，等待回覆')
        self.save()

    def take(self, line, live):
        try:
            event = json.loads(line)
        except (ValueError, UnicodeError):
            return
        found = (claude_event if self.config['source'] == 'claude' else codex_event)(event)
        if not found:
            return
        kind, reply = found
        if kind != 'reply':
            self.state['awaiting'] = kind == 'start'
            if live and kind == 'start':
                self.state.update(status=('Claude' if self.config['source'] == 'claude' else 'Codex')+' 正在回覆…', error='')
                self.save()
            return
        if reply[0] == self.last_turn:
            return
        self.last_turn, full = reply
        self.state.update(full=full, summary=summarize(full), last_turn=self.last_turn, awaiting=False, reply_at=event.get('timestamp'))
        if live:
            self.state.update(status='收到新回覆', error='')
            self.save()
            if self.config['auto']:
                self.play(self.state[self.config['mode']])

    def bind(self, thread):
        path = find_session(thread)
        if path is None:
            raise ValueError('找不到指定會話')
        self.config['thread'] = str(uuid.UUID(thread))
        self.open_log(path)
        atomic_json(CONFIG, self.config)

    def poll(self):
        source = self.config['source']
        if source == 'terminal':
            return self.poll_terminal()
        if time.monotonic() - self.checked_session >= RETRY or self.path is None:
            self.checked_session = time.monotonic()
            if source == 'claude':
                self.state['term_pane'] = claude_pane() or ''
                latest = latest_claude()
                if latest != self.path:
                    self.stop()
                    self.open_log(latest)
                self.save()
            else:
                if not self.config['thread']:
                    self.config['thread'] = latest_session()
                if self.config['follow_latest'] and latest_session() != self.config['thread']:
                    self.stop()
                    self.bind(latest_session())
                elif self.path is None:
                    self.bind(self.config['thread'])
        size = self.path.stat().st_size
        if size < self.offset:
            return self.open_log(self.path)
        if size == self.offset:
            return
        with self.path.open('rb') as f:
            f.seek(self.offset)
            data = f.read(4 * 1024 * 1024)
            self.offset = f.tell()
        lines = (self.pending + data).split(b'\n')
        self.pending = lines.pop()
        for line in lines:
            self.take(line, live=True)

    def poll_terminal(self):
        if time.monotonic() < self.next_terminal:
            return
        self.next_terminal = time.monotonic() + 3
        try:
            pane, label, full = terminal_snapshot()
        except ValueError as exc:
            self.next_terminal = time.monotonic() + RETRY
            self.state.update(source_name='Terminal', term_pane='', status=str(exc),
                              full='', summary='', error='', reply_at=None, awaiting=False)
            self.save()
            return
        self.state.update(source_name=label, term_pane=pane, status='已連接終端 · 點播放讀取畫面',
                          error='', awaiting=False)
        if full != self.term_last:
            self.term_last = full
            self.state.update(full=full, summary=clean_text(full)[-360:], reply_at=time.time() if full else None)
        self.save()

    def idle(self):
        '''Nothing is being spoken, and no tile, command or Codex activity for the chosen time.'''
        limit = self.config['pause_minutes'] * 60
        if not limit or self.state.get('playing'):
            return False
        # Codex still writing its log counts, so a long task is read aloud with the screen off.
        seen = [ALIVE] + ([self.path] if self.path and self.config['source'] != 'terminal' else [])
        try:
            return time.time() - max(path.stat().st_mtime for path in seen) >= limit
        except OSError:
            return False

    def stop(self):
        with self.player_lock:
            self.generation += 1
            if self.process is not None:
                self.process.terminate()
                try:
                    self.process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait()
                self.process = None
            self.state.update(playing=False, status='已停止')
            self.save()

    def play(self, text):
        if not text.strip():
            raise ValueError('還沒有可播放的回覆')
        self.stop()
        with self.player_lock:
            generation = self.generation
            self.state.update(playing=True, status='正在播放', error='')
            self.save()

        def worker():
            wav = CACHE / ('speech-' + uuid.uuid4().hex + '.wav')
            sweep(keep=wav.stem)
            try:
                with self.player_lock:
                    if generation != self.generation:
                        return
                if not shutil.which('espeak-ng') or not shutil.which('paplay'):
                    raise ValueError('需要 espeak-ng 和 paplay')
                commands = [
                    ([str(Path(__file__).parent / 'venv/bin/python'),
                      str(Path(__file__).parent / 'synthesize.py'), str(wav)], clean_text(text).encode()),
                    (['paplay', str(wav)], None),
                ]
                for args, data in commands:
                    if data is None:
                        with self.player_lock:
                            if generation == self.generation:
                                backend = Path(str(wav) + '.backend')
                                self.state['status'] = '正在播放 · ' + (backend.read_text() if backend.exists() else '語音')
                                self.save()
                    with self.player_lock:
                        if generation != self.generation:
                            return
                        proc = subprocess.Popen(args, stdin=subprocess.PIPE if data else subprocess.DEVNULL,
                                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                        self.process = proc
                    try:
                        _, err = proc.communicate(data, timeout=300)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.communicate()
                        raise ValueError('播放逾時')
                    if proc.returncode and generation == self.generation:
                        raise ValueError(err.decode(errors='replace')[-400:] or '播放失敗')
                with self.player_lock:
                    if generation == self.generation:
                        self.process = None
                        # Keep the reason on screen when the natural voice was not the one heard.
                        used = Path(str(wav) + '.backend')
                        used = used.read_text() if used.exists() else ''
                        self.state.update(playing=False, status='播放完成 · '+used if '離線' in used and '（' in used else '播放完成')
                        self.save()
            except Exception as exc:
                with self.player_lock:
                    if generation == self.generation:
                        self.state.update(playing=False, status='播放失敗', error=str(exc))
                        self.save()
            finally:
                # Only this reading's files: a newer reading may already be writing its own.
                for own in CACHE.glob(wav.stem + '*'):
                    try:
                        own.unlink()
                    except OSError:
                        pass
        threading.Thread(target=worker, daemon=True).start()

    def command(self, request):
        action = request.get('action')
        if action != 'status':
            self.retry_at = 0
        if action in ('replay', 'send'):
            if self.config['source'] == 'terminal':
                self.next_terminal = 0
            self.poll()
        if action == 'status':
            # Also how a change of interface language reaches the tiles: save() writes only what changed.
            self.save()
            return self.state
        if action == 'replay':
            self.play(self.state.get('full' if request.get('full') else 'summary', ''))
        elif action == 'test':
            self.play(SPOKEN[chosen()][4])
        elif action == 'stop':
            self.stop()
        elif action == 'auto':
            value = request.get('value', 'toggle')
            self.config['auto'] = not self.config['auto'] if value == 'toggle' else value == 'on'
            if not self.config['auto']:
                self.stop()
            self.state['status'] = '自動播報已開啟' if self.config['auto'] else '自動播報已關閉'
            atomic_json(CONFIG, self.config)
            self.save()
        elif action == 'engine':
            value = request.get('value', 'toggle')
            if value == 'toggle':
                value = 'offline' if self.config['engine'] == 'online' else 'online'
            if value not in ('online', 'offline'):
                raise ValueError('請選 online 或 offline')
            self.stop()
            self.config['engine'] = value
            atomic_json(CONFIG, self.config)
            self.state['status'] = '已切換線上自然語音' if value == 'online' else '已切換離線神經語音'
            self.save()
        elif action == 'pause':
            value = str(request.get('value', 'toggle')).strip().lower()
            if value == 'toggle':
                value = '0' if self.config['pause_minutes'] else str(PAUSE_MINUTES)
            if value == 'off':
                value = '0'
            if not value.isascii() or not value.isdigit() or int(value) > 1440:
                raise ValueError('請輸入 1 到 1440 的分鐘數，或 off')
            self.config['pause_minutes'] = int(value)
            atomic_json(CONFIG, self.config)
            self.state['status'] = '已更新閒置暫停時間' if int(value) else '閒置後不再暫停'
            self.save()
        elif action == 'refresh':
            self.stop()
            if self.config['source'] == 'terminal':
                self.next_terminal = 0
                self.poll_terminal()
            elif self.config['source'] == 'claude':
                self.open_log(latest_claude())
            else:
                self.bind(latest_session() if self.config['follow_latest'] else self.config['thread'])
        elif action == 'source':
            value = request.get('value')
            if value not in SOURCES:
                raise ValueError('請選 Codex、Claude 或 Terminal')
            self.stop()
            self.config['source'] = value
            self.path = None
            # The last send result belongs to the old target; the dictation tile must not keep showing it.
            (HOME/'.cache/oma-speak/send-status.json').unlink(missing_ok=True)
            self.state.update(full='', summary='', reply_at=None, term_pane='',
                              source_name={'codex': 'Codex', 'claude': 'Claude'}.get(value, 'Terminal'))
            atomic_json(CONFIG, self.config)
            if value == 'claude':
                self.state['term_pane'] = claude_pane() or ''
                self.open_log(latest_claude())
            elif value == 'terminal':
                self.next_terminal = 0
                self.term_last = None
                self.poll_terminal()
            else:
                self.bind(latest_session() if self.config['follow_latest'] else self.config['thread'])
        elif action == 'follow':
            self.config['follow_latest'] = not self.config['follow_latest']
            if self.config['follow_latest']:
                self.stop()
                self.bind(latest_session())
            atomic_json(CONFIG, self.config)
            self.save()
        elif action == 'bind':
            self.stop()
            self.config['follow_latest'] = False
            self.bind(request['thread'])
        elif action == 'send':
            text = request.get('text', '').strip()
            if not text or len(text) > 16000:
                raise ValueError('請先輸入內容（最多 16000 字）')
            if any(ord(c) < 32 and c not in '\n\t' for c in text):
                raise ValueError('文字含有控制字元')
            # A new chat may have appeared during the 15-second background backoff.
            # An explicit Send must use the current target immediately.
            if self.config['source'] == 'codex' and self.config['follow_latest']:
                latest = latest_session()
                if latest != self.config['thread']:
                    self.bind(latest)
            self.stop()
            if self.config['source'] == 'claude':
                pane = claude_pane()
                if pane is None:
                    raise ValueError('Claude 不在 oma-voice tmux 中，無法送出；請點「在 tmux 開啟 Claude」')
                terminal_send(pane, text)
                self.state.update(status='已送到終端 · Claude', error='', term_pane=pane)
            elif self.config['source'] == 'terminal':
                pane, label, _ = terminal_snapshot()
                terminal_send(pane, text)
                self.state.update(status='已送到終端 · '+label, error='')
            else:
                thread = self.config['thread']
                # Only the newest dictation may wait for the agent: replace, never pile up.
                replaced = codex_queue.forget(thread, text)
                result = subprocess.run(['codex', 'queue', '--thread', thread, '--message', text],
                                        capture_output=True, text=True, timeout=20)
                if result.returncode:
                    raise ValueError(result.stderr[-500:] or result.stdout[-500:] or '送出失敗')
                # An idle chat takes the message at once; a busy one keeps it until its turn ends.
                waiting = None
                for _ in range(6):
                    time.sleep(0.25)
                    waiting = codex_queue.remember(thread, text)
                    if waiting is None:
                        break
                status = '已送到 Codex 會話' if waiting is None else '已取代排隊中的上一則' if replaced else '排隊中：Codex 回覆完成後送出'
                self.state.update(status=status, error='')
                self.save()
                return {'ok': True, 'status': status, 'queued': waiting is not None, 'replaced': bool(replaced)}
            self.save()
        elif action == 'unqueue':
            cancelled = codex_queue.cancel()
            self.state.update(status='已取消排隊中的訊息' if cancelled else '沒有排隊中的訊息', error='')
            self.save()
            return {'ok': True, 'status': self.state['status'], 'text': cancelled and cancelled.get('text')}
        else:
            raise ValueError('未知命令')
        return {'ok': True, 'status': self.state['status']}


def serve():
    CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (CACHE / 'daemon.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        ALIVE.touch()
        sweep()
        reader = Reader()
        if reader.config['source'] == 'terminal':
            reader.poll_terminal()
        elif reader.config['source'] == 'claude':
            try:
                reader.poll()
            except (OSError, ValueError) as exc:
                reader.state.update(status='等待會話記錄', error=str(exc))
        elif reader.config['thread']:
            reader.bind(reader.config['thread'])
        SOCKET.unlink(missing_ok=True)
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(SOCKET))
            SOCKET.chmod(0o600)
            server.listen(4)
            while not reader.idle():
                # The dictation page and the setup screen write the language without telling the service.
                if changed_at() != reader.language_at:
                    reader.save()
                if time.monotonic() >= reader.retry_at:
                    try:
                        reader.poll()
                    except (OSError, ValueError) as exc:
                        reader.state.update(status='等待會話記錄', error=str(exc))
                        reader.save()
                        reader.retry_at = time.monotonic() + RETRY
                if not select.select([server], [], [], 0.5)[0]:
                    continue
                conn, _ = server.accept()
                with conn:
                    conn.settimeout(5)
                    try:
                        data = b''
                        while b'\n' not in data and len(data) <= 70000:
                            part = conn.recv(8192)
                            if not part:
                                break
                            data += part
                        if len(data) > 70000:
                            raise ValueError('請求太大')
                        response = reader.command(json.loads(data))
                    except Exception as exc:
                        response = {'ok': False, 'error': str(exc), 'error_ui': local(str(exc))}
                    try:
                        conn.sendall((json.dumps(response, ensure_ascii=False) + '\n').encode())
                    except OSError:
                        pass


def request(value):
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(25)
        client.connect(str(SOCKET))
        client.sendall((json.dumps(value, ensure_ascii=False) + '\n').encode())
        data = b''
        while b'\n' not in data:
            part = client.recv(8192)
            if not part:
                break
            data += part
        return json.loads(data)


def ensure():
    CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
    ALIVE.touch()
    try:
        request({'action': 'status'})
        return
    except (OSError, ValueError):
        pass
    with (CACHE / 'daemon.log').open('ab') as log:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'daemon'],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(30):
        try:
            request({'action': 'status'})
            return
        except (OSError, ValueError):
            time.sleep(0.1)
    raise ValueError('語音服務未啟動，請查看 ~/.cache/oma-voice/daemon.log')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['daemon', 'ensure', 'status', 'replay', 'stop', 'auto', 'bind', 'send', 'test', 'engine', 'refresh', 'follow', 'language', 'source', 'pause', 'unqueue'])
    parser.add_argument('value', nargs='?')
    parser.add_argument('--text')
    parser.add_argument('--full', action='store_true')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    if args.action == 'language':
        if args.value not in LANGUAGES:
            raise ValueError(local('請選擇介面語言：')+' '.join(LANGUAGES))
        path = CHOICE
        path.parent.mkdir(parents=True, exist_ok=True)
        temp = path.with_name(path.name + '.' + uuid.uuid4().hex + '.tmp')
        temp.write_text(args.value)
        temp.chmod(0o600)
        temp.replace(path)
        try:
            request({'action': 'status'})
        except (OSError, ValueError):
            pass
        return
    if args.action == 'daemon':
        serve()
        return
    ensure()
    if args.action == 'ensure':
        return
    result = request({'action': args.action, 'value': args.value or 'toggle',
                      'thread': args.value, 'text': args.text or '', 'full': args.full})
    result['request_id'] = uuid.uuid4().hex
    if result.get('ok') is not False and 'status' in result:
        result['status_ui'] = local(result['status'])
    print(json.dumps(result, ensure_ascii=False) if args.action == 'status' or args.json else
          result.get('error_ui') or local(result.get('status', '完成')))
    if result.get('ok') is False:
        sys.exit(1)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        print(local(str(error)), file=sys.stderr)
        sys.exit(1)
OMA_VOICE_FILE_2_END
put "$HOME/.local/share/oma-voice/synthesize.py" <<'OMA_VOICE_FILE_3_END'
'''Edge TTS without API keys; local Piper/Sherpa fallback. Reads text on stdin.'''
import asyncio
import json
import os
import re
import subprocess
import shutil
from pathlib import Path
import sys

ROOT = Path(__file__).parent
sys.path.insert(0, str(ROOT))
from language import spoken

# The voice for each language a text can be spoken in: (Microsoft Edge online, espeak-ng offline).
SPEAKERS = {
    'en': ('en-US-AriaNeural', 'en-us'), 'zh': ('zh-CN-XiaoxiaoNeural', 'cmn'), 'es': ('es-ES-ElviraNeural', 'es'),
    'de': ('de-DE-KatjaNeural', 'de'), 'fr': ('fr-FR-DeniseNeural', 'fr'), 'ja': ('ja-JP-NanamiNeural', 'ja'),
    'ko': ('ko-KR-SunHiNeural', 'ko'),
}

# Why online speech was skipped, shown beside the offline voice's name.
NOT_INSTALLED = '線上語音未安裝'
NO_MPG123 = '缺少 mpg123'
UNREACHABLE = '線上語音無回應'

def offline(text, output, reason=''):
    note = '（'+reason+'）' if reason else ''
    runtime = ROOT / 'tts/sherpa-onnx-v1.13.8-linux-aarch64-shared-cpu/bin/sherpa-onnx-offline-tts'
    model = ROOT / 'tts/vits-piper-zh_CN-huayan-medium'
    if spoken(text) == 'zh' and runtime.exists() and (model / 'zh_CN-huayan-medium.onnx').exists():
        Path(str(output)+'.backend').write_text('離線神經語音'+note)
        os.execv(str(runtime), [str(runtime), '--vits-model='+str(model/'zh_CN-huayan-medium.onnx'),
                 '--vits-tokens='+str(model/'tokens.txt'), '--vits-data-dir='+str(model/'espeak-ng-data'),
                 '--num-threads=2', '--output-filename='+str(output), '--', text])
    Path(str(output)+'.backend').write_text('離線基本語音'+note)
    os.execvp('espeak-ng', ['espeak-ng', '-v', SPEAKERS[spoken(text)][1], '-s', '175', '-w', str(output), '--', text])

def pieces(text, limit=1200):
    # One request per piece: a long reply in one request ran past the time limit and fell back to espeak-ng.
    parts, current = [], ''
    for sentence in re.findall(r'[^。！？!?；;\n]*[。！？!?；;\n]+|[^。！？!?；;\n]+', text):
        while len(sentence) > limit:
            parts.append(current+sentence[:limit-len(current)])
            sentence, current = sentence[limit-len(current):], ''
        if len(current)+len(sentence) > limit:
            parts.append(current)
            current = ''
        current += sentence
    return [part for part in parts+[current] if part.strip()]

async def fetch(edge_tts, text, voice):
    audio = b''
    async for chunk in edge_tts.Communicate(text, voice=voice, rate='-5%').stream():
        if chunk['type'] == 'audio':
            audio += chunk['data']
    if not audio:
        raise RuntimeError('no audio')
    return audio

async def online(text, output):
    import edge_tts
    if not shutil.which('mpg123'):
        raise FileNotFoundError('mpg123')
    mp3 = output.with_suffix('.mp3')
    try:
        voice = SPEAKERS[spoken(text)][0]
        with mp3.open('wb') as audio:
            for part in pieces(text):
                for attempt in range(3):
                    try:
                        audio.write(await asyncio.wait_for(fetch(edge_tts, part, voice), timeout=30))
                        break
                    except Exception:
                        # A dropped connection is common on a phone; espeak-ng is the last resort.
                        if attempt == 2:
                            raise
                        await asyncio.sleep(1)
        subprocess.run(['mpg123', '-q', '-w', str(output), str(mp3)], check=True, timeout=120)
        Path(str(output)+'.backend').write_text('自然語音（線上）')
    finally:
        mp3.unlink(missing_ok=True)

if __name__ == '__main__':
    output = Path(sys.argv[1])
    text = sys.stdin.read().strip()
    if not text:
        raise SystemExit('沒有可播放的文字')
    config = json.loads((Path.home()/'.config/omalauncher/voice.json').read_text())
    reason = ''
    if config.get('engine') != 'offline':
        try:
            asyncio.run(online(text, output))
            raise SystemExit(0)
        except Exception as error:
            reason = NOT_INSTALLED if isinstance(error, ImportError) else NO_MPG123 if isinstance(error, FileNotFoundError) else UNREACHABLE
            print('線上語音不可用，改用離線：'+type(error).__name__+' '+str(error)[:200], file=sys.stderr)
            output.unlink(missing_ok=True)
    offline(text, output, reason)
OMA_VOICE_FILE_3_END
put "$HOME/.local/share/oma-speak/bash.sh" <<'OMA_VOICE_FILE_4_END'
# Insert at the cursor, preserving any existing input. Never press Enter.
_oma_speak_insert() {
  local dictated
  [[ -f $HOME/.cache/oma-speak/latest.txt ]] || return 0
  dictated=$(< "$HOME/.cache/oma-speak/latest.txt")
  READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}${dictated}${READLINE_LINE:READLINE_POINT}"
  READLINE_POINT=$((READLINE_POINT + ${#dictated}))
}
bind -x '"\C-g":_oma_speak_insert'
OMA_VOICE_FILE_4_END
put "$HOME/.local/share/oma-speak/index.html" <<'OMA_VOICE_FILE_5_END'
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0e17">
<title>語音輸入</title>
<style>
:root{color-scheme:dark;--bg:#0b0e17;--fg:#d9edf4;--accent:#78ffa2;--muted:#989db7;--line:#30364c;--panel:#111522;--warn:#ffd36e;--bad:#ff8484}
*{box-sizing:border-box}
body{margin:0;min-height:100dvh;display:flex;flex-direction:column;background:var(--bg);color:var(--fg);font:16px/1.5 ui-monospace,"SFMono-Regular",Consolas,"Liberation Mono",monospace}
main,.dock-inner{width:min(100%,640px);margin:0 auto;padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right))}
main{flex:1;padding-top:20px;padding-bottom:16px;display:flex;flex-direction:column;gap:14px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px}
h1{font-size:22px;line-height:1.25;color:var(--accent);margin:0;font-weight:500}
button,select,textarea{font:inherit;border-radius:6px;color:var(--fg)}
button,select{min-height:44px;border:1px solid var(--line);background:transparent;padding:8px 14px}
button{cursor:pointer;touch-action:manipulation}
button:disabled{opacity:.35;cursor:default}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
select{max-width:100%;min-width:0;background:var(--panel);font-size:14px}
.quiet{border:0;min-height:40px;padding:6px 4px;font-size:14px;color:var(--muted)}
.quiet:not(:disabled):hover{color:var(--accent)}
.editor-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}
header select{min-height:40px;padding:4px 8px;max-width:100%}
.lang{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);min-width:0;max-width:62%}.lang>span{flex:none}
.agent{width:100%;margin-top:12px;min-height:48px;display:flex;align-items:center;justify-content:center;gap:8px;border-color:var(--accent);color:var(--accent);background:#78ffa212;font-weight:600}
.agent svg{width:18px;height:18px;flex:none}
.agent:not(:disabled):hover{background:#78ffa222}
.editor-actions{display:flex;gap:12px;flex:none}
textarea{display:block;resize:none;width:100%;height:clamp(180px,38dvh,420px);padding:14px;border:1px solid var(--line);background:var(--panel);line-height:1.7;caret-color:var(--accent)}
textarea::placeholder{color:#737b97}
#alternatives:empty{display:none}
#alternatives{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
#alternatives small{flex-basis:100%;color:var(--muted);font-size:12px}
#alternatives button{min-height:36px;font-size:13px;text-align:left;overflow-wrap:anywhere;max-width:100%}
.card{border:1px solid var(--line);border-left:3px solid var(--accent);background:var(--panel);padding:12px 14px;border-radius:6px}
.card[hidden]{display:none}
#queue-panel{border-left-color:var(--warn)}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
.card h2{font-size:14px;margin:0;font-weight:600;color:var(--accent)}
#queue-panel h2{color:var(--warn)}
.card p{margin:6px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.6}
.card .hint{font-size:12px;color:var(--muted);white-space:normal}
#queue-text{max-height:6.4em;overflow:auto;font-size:14px}
.card-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}
.card-actions button,.card-head button{min-height:38px;padding:4px 14px;font-size:14px}
.accent-outline{border-color:var(--accent);color:var(--accent)}
details{color:var(--muted);font-size:12px;margin-top:auto}
summary{cursor:pointer;width:fit-content;padding:6px 0}details p{line-height:1.7;margin:6px 0 0}
.dock{position:sticky;bottom:0;background:var(--bg);border-top:1px solid var(--line);padding-bottom:max(12px,env(safe-area-inset-bottom))}
.dock-inner{padding-top:10px}
.dock-info{display:flex;align-items:center;gap:10px;min-height:38px}
.status-dot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex:none}
body[data-listening="true"] .status-dot{background:var(--accent);box-shadow:0 0 0 4px #78ffa225}
#status{flex:1;min-width:0;font-size:13px;color:var(--muted);margin:0;overflow-wrap:anywhere;line-height:1.4}
#status[data-tone="ok"],body[data-listening="true"] #status{color:var(--accent)}
#status[data-tone="bad"]{color:var(--bad)}
.target{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);flex:none}
.target select{min-height:34px;padding:2px 6px;font-size:13px;max-width:150px}
.dock-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
.dock-actions button{min-height:52px;white-space:nowrap;display:flex;align-items:center;justify-content:center;gap:10px;font-weight:600}
#mic svg,#send svg{width:18px;height:18px;flex:none}
body[data-listening="true"] #mic{border-color:var(--accent);color:var(--accent)}
#send{border-color:var(--accent);background:var(--accent);color:var(--bg)}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:360px){.target>span{display:none}.editor-actions{gap:8px}}
@media(prefers-reduced-motion:no-preference){button{transition:background .15s,border-color .15s,color .15s}}
</style>
</head>
<body>
<main>
<header>
<h1>語音輸入</h1>
<label class="lang"><span>輸入語言</span><select id="language"><option value="zh-TW">中文（台灣）</option><option value="zh-CN">中文（普通話）</option><option value="en-US">English</option><option value="es-ES">Español</option><option value="de-DE">Deutsch</option><option value="fr-FR">Français</option><option value="ja-JP">日本語</option><option value="ko-KR">한국어</option></select></label>
</header>
<section>
<div class="editor-bar">
<span></span><div class="editor-actions"><button id="copy" class="quiet">複製</button><button id="clear" class="quiet">清空</button></div>
</div>
<label for="text" class="sr-only">文字</label>
<textarea id="text" maxlength="16000" placeholder="說話或在這裡輸入…" spellcheck="true"></textarea>
<div id="alternatives"></div>
<button id="refine" class="agent"><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1l1.8 5.2L17 8l-5.2 1.8L10 15l-1.8-5.2L3 8l5.2-1.8zM16 13l.8 2.2L19 16l-2.2.8L16 19l-.8-2.2L13 16l2.2-.8z"/></svg><span id="refine-label">Agent 整理</span></button>
</section>
<section id="refined-panel" class="card" hidden>
<h2>整理稿</h2>
<p id="refined-text"></p>
<div class="card-actions"><button id="refine-discard">捨棄</button><button id="refine-apply" class="accent-outline">採用</button></div>
</section>
<section id="queue-panel" class="card" hidden>
<div class="card-head"><h2>排隊中</h2><button id="unqueue">取消</button></div>
<p id="queue-text"></p>
<p class="hint">Codex 回覆完成後送出這一則；再次送出會取代它。</p>
</section>
<details><summary>關於語音辨識</summary><p>辨識使用瀏覽器的語音服務，可能將音訊傳給服務供應商。文字會自動保存到首頁，按「送出」才會傳給目標。</p><p>整理用目前來源的便宜模型（Claude Haiku／Codex 最便宜模型），不會送到目標。</p></details>
</main>
<footer class="dock">
<div class="dock-inner">
<div class="dock-info"><span class="status-dot" aria-hidden="true"></span><p id="status" role="status" aria-live="polite">準備就緒</p><label class="target"><span>送到</span><select id="target-select"><option value="codex">Codex 會話</option><option value="claude">Claude 會話</option><option value="terminal">tmux 終端</option></select></label></div>
<div class="dock-actions">
<button id="mic"><svg viewBox="0 0 16 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="1" width="6" height="11" rx="3"/><path d="M2 8v2a6 6 0 0 0 12 0V8M8 16v3M5 19h6"/></svg><span id="mic-label">聽寫</span></button>
<button id="send"><span id="send-label">送出</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 10h13M11 4l6 6-6 6"/></svg></button>
</div>
</div>
</footer>
<script>
const $=id=>document.getElementById(id),status=$('status'),text=$('text');
const launchToken=location.hash.slice(1);
let token=launchToken;
try{if(launchToken)sessionStorage.setItem('oma-speak-token',launchToken);else token=sessionStorage.getItem('oma-speak-token')||'';}catch(e){}
history.replaceState(null,'',location.pathname);

// The page is written in Chinese and shown in English for every other interface language.
const UI_STRINGS = {"語音輸入":{"en":"Dictation"},"輸入語言":{"en":"Input language"},"停止":{"en":"Stop"},"保存到首頁":{"en":"Save to home"},"清空":{"en":"Clear"},"已清空。":{"en":"Cleared."},"正在停止…":{"en":"Stopping…"},"保存失敗：":{"en":"Save failed: "},"已複製。":{"en":"Copied."},"請長按選取的文字並複製。":{"en":"Long-press the selected text to copy it."},"此瀏覽器不支援語音辨識，請使用 Chrome 開啟。":{"en":"This browser does not support speech recognition. Open in Chrome."},"麥克風權限被拒絕。請到 Android 設定 → 應用程式 → 目前瀏覽器 → 權限 → 麥克風，並在瀏覽器的本站設定允許麥克風。給 omalauncher 權限不會同時授權瀏覽器。":{"en":"Microphone denied. Allow the browser microphone permission in Android settings and browser site settings."},"瀏覽器不允許此語音服務，請用 Chrome 開啟。":{"en":"Speech service blocked. Try Chrome."},"無法取得麥克風。請確認瀏覽器權限，並關閉其他正在錄音的程式。":{"en":"Microphone unavailable. Check browser permissions and close other recording apps."},"語音服務連線失敗，請檢查網路後重試。":{"en":"Speech service network error. Check connection and retry."},"沒聽到聲音，請按開始重試。":{"en":"No speech heard. Tap Start to retry."},"此語音服務不支援所選語言，請切換語言。":{"en":"This speech service does not support the selected language."},"語音已停止。":{"en":"Speech stopped."},"先按停止，再選候選文字。":{"en":"Tap Stop before choosing another transcript."},"這句已修改，請直接編輯文字。":{"en":"This sentence was edited; change it directly."},"請從首頁「語音輸入」重新開啟。":{"en":"Reopen from the Dictation widget."},"辨識錯誤：":{"en":"Recognition error: "},"無法開始：":{"en":"Could not start: "},"準備就緒":{"en":"Ready"},"說話或在這裡輸入…":{"en":"Speak or type here…"},"複製":{"en":"Copy"},"正在聽…":{"en":"Listening…"},"已停止，可編輯文字。":{"en":"Stopped. Edit your text."},"已暫停，可編輯文字。":{"en":"Paused for editing."},"其他辨識結果":{"en":"Alternatives"},"文字":{"en":"Text"},"關於語音辨識":{"en":"About speech recognition"}};
Object.assign(UI_STRINGS, {
 '複製給 Claude': {en:'Copy for Claude'},
 '已複製，請到 Claude 貼上送出。': {en:'Copied. Paste it into Claude and send.'},
 '已找到 Claude。它不在 tmux 裡：按「複製給 Claude」後到 Claude 貼上送出。': {en:'Claude found. It is not in tmux: tap Copy for Claude, then paste it into Claude.'},
 '沒有找到執行中的 Claude。': {en:'No running Claude found.'},
 '聽寫': {en:'Dictate'},
 'Agent 整理': {en:'Refine with Agent'},
 '語言': {en:'Language'},
 'Claude 會話': {en:'Claude chat'},
 'tmux 終端': {en:'tmux terminal'},
 '整理': {en:'Refine'},
 '整理中…': {en:'Refining…'},
 '整理稿': {en:'Refined draft'},
 '採用': {en:'Use it'},
 '捨棄': {en:'Discard'},
 '已採用整理稿，可再編輯後送出。': {en:'Draft applied. Edit or send it.'},
 '正在整理…': {en:'Refining…'},
 '整理完成，請檢查內容。': {en:'Draft ready. Review it before sending.'},
 '整理失敗，原文仍可送出。': {en:'Refining failed. You can still send the original.'},
 '請先輸入文字。': {en:'Enter some text first.'},
 '原文已變更，請重新整理。': {en:'Text changed. Refine it again.'},
 '送出': {en:'Send'},
 '送出中…': {en:'Sending…'},
 '送到': {en:'To'},
 '已送出。': {en:'Sent.'},
 '送出失敗：': {en:'Send failed: '},
 '排隊中': {en:'Waiting'},
 '取消': {en:'Cancel'},
 'Codex 回覆完成後送出這一則；再次送出會取代它。': {en:'Sent when Codex finishes its reply. Sending again replaces it.'},
 'Codex 已收到排隊的訊息。': {en:'Codex picked up the waiting message.'},
 '已取消，文字已放回編輯區。': {en:'Cancelled. The text is back in the editor.'},
 '取消失敗：': {en:'Cancel failed: '},
 '保存失敗：': {en:'Save failed: '},
 'Codex 會話': {en:'Codex chat'},
 '正在切換送出目標…': {en:'Switching target…'},
 '送出目標已切換。': {en:'Target changed.'},
 '切換目標失敗：': {en:'Could not change target: '},
 '終端尚未連接；請先執行 tmux new -A -s oma-voice。': {en:'Terminal disconnected. Run tmux new -A -s oma-voice first.'},
 '辨識使用瀏覽器的語音服務，可能將音訊傳給服務供應商。文字會自動保存到首頁，按「送出」才會傳給目標。': {en:'Browser speech recognition may send audio to its provider. Text is saved to the home widget automatically and only goes to the target when you tap Send.'},
 '整理用目前來源的便宜模型（Claude Haiku／Codex 最便宜模型），不會送到目標。': {en:'Refining uses a cheap model of the current source (Claude Haiku / the cheapest Codex model) and does not send to the target.'},
});
let uiLanguage='zh';
// The language spoken by default for each interface language.
const SPEECH={en:'en-US',zh:'zh-TW',es:'es-ES',de:'de-DE',fr:'fr-FR',ja:'ja-JP',ko:'ko-KR'};
const originalNodes=[];
const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
while(walker.nextNode()){const node=walker.currentNode;if(UI_STRINGS[node.textContent.trim()])originalNodes.push([node,node.textContent.trim()]);}
const originalPlaceholder=text.getAttribute('placeholder');
function localize(value){if(uiLanguage==='zh')return value;for(const [zh,texts] of Object.entries(UI_STRINGS)){const t=texts[uiLanguage]||texts.en;if(value===zh)return t;if(value.startsWith(zh)&&zh.endsWith('：'))return t+value.slice(zh.length);}return value;}
// One status line for every action; tone: ok, bad or plain.
function say(message,tone=''){status.dataset.original=message;status.dataset.tone=tone;status.textContent=localize(message);}
function applyLanguage(){
 document.documentElement.lang=uiLanguage==='zh'?'zh-Hant':'en';
 for(const [node,zh] of originalNodes)node.textContent=localize(zh);
 text.placeholder=localize(originalPlaceholder);
 document.title=localize('語音輸入');
 status.textContent=localize(status.dataset.original||status.textContent);
 controls();
}
// One picker: the spoken language, which also sets the interface language when there is one for it.
const uiFor=speech=>Object.keys(SPEECH).find(ui=>speech.startsWith(ui==='zh'?'zh-':SPEECH[ui]))||'';
$('language').onchange=async()=>{
 const speech=$('language').value,ui=uiFor(speech);
 localStorage.setItem('oma-speak-language',speech);
 if(!ui||ui===uiLanguage)return;
 try{const response=await fetch('/language',{method:'POST',headers:{'Content-Type':'application/json','X-Speak-Token':token},body:JSON.stringify({language:ui})});if(!response.ok)throw Error(await response.text());uiLanguage=ui;applyLanguage();}
 catch(error){say('Language change failed: '+error.message,'bad');}
};
fetch('/language').then(r=>r.text()).then(value=>{uiLanguage=SPEECH[value.trim()]?value.trim():'en';applyLanguage();
 // A language chosen on a widget since last time wins over the remembered speech language.
 const saved=localStorage.getItem('oma-speak-language');if(!saved||(uiFor(saved)&&uiFor(saved)!==uiLanguage))$('language').value=SPEECH[uiLanguage];}).catch(()=>{});

async function postAction(path,body,timeout=10000){
 if(!token)throw Error(localize('請從首頁「語音輸入」重新開啟。'));
 const response=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json','X-Speak-Token':token},body:JSON.stringify(body),signal:AbortSignal.timeout(timeout)});
 const raw=await response.text();let value;
 try{value=JSON.parse(raw);}catch(e){value={error:raw};}
 if(response.status===403)throw Error(localize('請從首頁「語音輸入」重新開啟。'));
 if(!response.ok||value.ok===false)throw Error(value.error_ui||value.error||'Action failed');return value;
}
async function getJson(path){
 const r=await fetch(path,{headers:{'X-Speak-Token':token},cache:'no-store',signal:AbortSignal.timeout(5000)});
 if(r.status===403)throw Error(localize('請從首頁「語音輸入」重新開啟。'));if(!r.ok)throw Error(path+' unavailable');return r.json();
}

// Target
let currentTarget={source:'codex',source_name:'Terminal',connected:false},switchingTarget=false;
const DISCONNECTED='終端尚未連接；請先執行 tmux new -A -s oma-voice。';
const unreachable=()=>!currentTarget.connected&&currentTarget.source==='terminal'?DISCONNECTED:'';
// Claude outside tmux cannot be typed into: Send copies the text for pasting there instead.
const copyMode=()=>currentTarget.source==='claude'&&!currentTarget.connected;
function claudeNote(){if(copyMode())say(currentTarget.claude_running?'已找到 Claude。它不在 tmux 裡：按「複製給 Claude」後到 Claude 貼上送出。':'沒有找到執行中的 Claude。');}
function renderTarget(){$('target-select').value=['claude','terminal'].includes(currentTarget.source)?currentTarget.source:'codex';controls();}
async function refreshTarget(){currentTarget=await getJson('/target');renderTarget();}
refreshTarget().then(()=>{if(unreachable())say(unreachable(),'bad');else claudeNote();}).catch(e=>say(e.message,'bad'));
$('target-select').onchange=async()=>{
 const source=$('target-select').value;switchingTarget=true;controls();say('正在切換送出目標…');
 try{currentTarget=await postAction('/target',{source},15000);renderTarget();unreachable()?say(unreachable(),'bad'):copyMode()?claudeNote():say('送出目標已切換。','ok');checkQueue();}
 catch(e){renderTarget();say('切換目標失敗：'+e.message,'bad');}
 finally{switchingTarget=false;controls();}
};

// Recognition
const Speech=window.SpeechRecognition||window.webkitSpeechRecognition;
let recognition=null,wanted=false,afterStop=null;
text.value=localStorage.getItem('oma-speak-draft')||'';
$('language').value=localStorage.getItem('oma-speak-language')||'zh-TW';
let sending=false,refining=false,refineSource='',refineTimer=null,saveTimer=null,lastSaved=null;
const listening=()=>wanted||!!recognition;
function controls(){
 const busy=listening();
 document.body.dataset.listening=String(busy);
 $('mic-label').textContent=localize(busy?'停止':'聽寫');
 $('mic').disabled=!Speech&&!busy;
 $('language').disabled=busy;
 $('send-label').textContent=localize(sending?'送出中…':copyMode()?'複製給 Claude':'送出');
 $('send').disabled=sending||switchingTarget||!text.value.trim();
 $('target-select').disabled=sending||switchingTarget;
 $('refine-label').textContent=localize(refining?'整理中…':'Agent 整理');
 $('refine').disabled=busy||sending||refining||!text.value.trim();
 $('clear').disabled=sending||!text.value;
 $('copy').disabled=!text.value;
 text.readOnly=sending;
}
// The home widget sends what was saved last, so keep it current without a Save button.
function persist(){localStorage.setItem('oma-speak-draft',text.value);clearTimeout(saveTimer);saveTimer=setTimeout(save,900);}
async function save(){
 clearTimeout(saveTimer);
 const value=text.value;if(!value.trim()||value===lastSaved||!token)return true;
 try{const r=await fetch('/text',{method:'POST',headers:{'Content-Type':'application/json','X-Speak-Token':token},body:JSON.stringify({text:value}),signal:AbortSignal.timeout(10000)});
  if(r.status===403)throw Error(localize('請從首頁「語音輸入」重新開啟。'));if(!r.ok)throw Error(await r.text());lastSaved=value;return true;}
 catch(e){say('保存失敗：'+e.message,'bad');return false;}
}
function edited(){
 persist();
 if(!$('refined-panel').hidden&&text.value!==refineSource){hideRefined();say('原文已變更，請重新整理。');}
 controls();
}
function startSession(){
 if(!wanted||recognition)return;
 const r=new Speech();recognition=r;const base=text.value;
 r.lang=$('language').value;r.interimResults=true;r.continuous=false;r.maxAlternatives=3;let endedByError=false;
 r.onstart=()=>{say('正在聽…');controls();};
 r.onresult=e=>{
  if(recognition!==r)return;
  // Results are a session snapshot, not new append-only sentences.
  let rendered=base;
  for(let i=0;i<e.results.length;i++){
   const result=e.results[i],words=result[0].transcript;
   const prefix=rendered+(rendered&&!/[\s\n]$/.test(rendered)?' ':'');
   if(result.isFinal)showAlternatives(result,prefix);
   rendered=prefix+words;
  }
  text.value=rendered;edited();
 };
 r.onerror=e=>{if(recognition!==r)return;endedByError=true;const errors={'not-allowed':'麥克風權限被拒絕。請到 Android 設定 → 應用程式 → 目前瀏覽器 → 權限 → 麥克風，並在瀏覽器的本站設定允許麥克風。給 omalauncher 權限不會同時授權瀏覽器。','service-not-allowed':'瀏覽器不允許此語音服務，請用 Chrome 開啟。','audio-capture':'無法取得麥克風。請確認瀏覽器權限，並關閉其他正在錄音的程式。','network':'語音服務連線失敗，請檢查網路後重試。','no-speech':'沒聽到聲音，請按開始重試。','language-not-supported':'此語音服務不支援所選語言，請切換語言。','aborted':'語音已停止。'};
  wanted=false;say(errors[e.error]||'辨識錯誤：'+e.error,e.error==='aborted'?'':'bad');controls();};
 r.onend=()=>{
  if(recognition!==r)return;
  recognition=null;wanted=false;save();controls();
  if(afterStop){const f=afterStop;afterStop=null;f();}
  else if(!endedByError)say('已停止，可編輯文字。');
 };
 try{r.start();controls();}catch(e){recognition=null;wanted=false;say('無法開始：'+e.message,'bad');controls();}
}
function stopListening(then=null){
 wanted=false;afterStop=then;
 if(recognition){say('正在停止…');recognition.stop();}else if(then){afterStop=null;then();}
 controls();
}
text.onfocus=()=>{if(recognition){const r=recognition;recognition=null;wanted=false;afterStop=null;r.abort();save();say('已暫停，可編輯文字。');controls();}};
text.oninput=edited;
function showAlternatives(result,prefix){
 const box=$('alternatives');box.replaceChildren();
 if(result.length<2)return;
 const label=document.createElement('small');label.textContent=localize('其他辨識結果');box.append(label);
 for(let j=0;j<result.length;j++){
  const b=document.createElement('button');b.textContent=result[j].transcript;
  const original=prefix+result[0].transcript,candidate=prefix+result[j].transcript;
  b.onclick=()=>{if(listening()){say('先按停止，再選候選文字。');return;}if(!text.value.startsWith(original)){say('這句已修改，請直接編輯文字。');return;}text.value=candidate+text.value.slice(original.length);box.replaceChildren();edited();};box.append(b);
 }
}
$('mic').onclick=()=>{if(listening())stopListening();else{wanted=true;hideRefined();startSession();}};

// Refine: a reviewable suggestion that replaces the text only when chosen.
function hideRefined(){clearTimeout(refineTimer);refining=false;refineSource='';$('refined-panel').hidden=true;$('refined-text').textContent='';controls();}
async function pollRefine(source,deadline){
 try{
  const value=await getJson('/refine-status');
  if(source!==refineSource||text.value!==source)return;
  if(value.phase==='ready'&&value.text){refining=false;$('refined-text').textContent=value.text;$('refined-panel').hidden=false;say('整理完成，請檢查內容。','ok');controls();return;}
  if(value.phase==='failed'||Date.now()>deadline)throw Error('failed');
  refineTimer=setTimeout(()=>pollRefine(source,deadline),1500);
 }catch(e){refining=false;say('整理失敗，原文仍可送出。','bad');controls();}
}
$('refine').onclick=async()=>{
 const source=text.value;if(!source.trim()){say('請先輸入文字。');return;}
 hideRefined();refining=true;refineSource=source;say('正在整理…');controls();
 try{await postAction('/refine',{text:source.trim()});lastSaved=source.trim();pollRefine(source,Date.now()+130000);}
 catch(e){refining=false;refineSource='';say('整理失敗，原文仍可送出。','bad');controls();}
};
$('refine-apply').onclick=()=>{text.value=$('refined-text').textContent;hideRefined();persist();say('已採用整理稿，可再編輯後送出。','ok');controls();};
$('refine-discard').onclick=()=>{hideRefined();say('準備就緒');};

// Codex keeps at most one waiting dictation; show it with a way to cancel it.
let queueTimer=null;
function showQueue(value){
 $('queue-panel').hidden=!value;$('queue-text').textContent=value||'';
 clearTimeout(queueTimer);if(value)queueTimer=setTimeout(()=>checkQueue(true),2500);
}
async function checkQueue(watching=false){
 try{const value=await getJson('/queue');
  if(watching&&!value.pending&&!$('queue-panel').hidden)say('Codex 已收到排隊的訊息。','ok');
  showQueue(value.pending?value.text:'');}
 catch(e){if(watching)queueTimer=setTimeout(()=>checkQueue(true),5000);}
}
$('unqueue').onclick=async()=>{
 $('unqueue').disabled=true;
 try{const result=await postAction('/unqueue',{},15000);showQueue('');
  if(result.text&&!text.value.trim()){text.value=result.text;persist();}
  say(result.text?'已取消，文字已放回編輯區。':(result.status_ui||result.status),'ok');}
 catch(e){say('取消失敗：'+e.message,'bad');}
 finally{$('unqueue').disabled=false;controls();}
};

// Send: one tap sends the current text and clears the editor, so it cannot be sent twice by accident.
async function send(){
 if(sending)return;
 const value=text.value.trim();if(!value){say('請先輸入文字。');return;}
 sending=true;say('送出中…');controls();
 try{
  await refreshTarget();
  if(unreachable())throw Error(localize(unreachable()));
  if(copyMode()){
   try{await navigator.clipboard.writeText(value);say('已複製，請到 Claude 貼上送出。','ok');}
   catch(e){text.focus();text.select();say('請長按選取的文字並複製。');}
   return;
  }
  if(!await save())throw Error(status.textContent);
  const result=await postAction('/send',{version:'original'},30000);
  text.value='';localStorage.setItem('oma-speak-draft','');$('alternatives').replaceChildren();hideRefined();
  showQueue(result.queued?value:'');
  say(result.status_ui||'已送出。',result.queued?'':'ok');
 }catch(e){say('送出失敗：'+e.message,'bad');}
 finally{sending=false;controls();}
}
$('send').onclick=()=>{if(listening())stopListening(send);else send();};
$('copy').onclick=async()=>{try{await navigator.clipboard.writeText(text.value);say('已複製。','ok');}catch(e){text.focus();text.select();say('請長按選取的文字並複製。');}};
$('clear').onclick=()=>{afterStop=null;wanted=false;if(recognition){const r=recognition;recognition=null;r.onresult=null;r.abort();}text.value='';localStorage.setItem('oma-speak-draft','');$('alternatives').replaceChildren();hideRefined();say('已清空。');controls();};
document.addEventListener('visibilitychange',()=>{if(document.hidden){wanted=false;if(recognition)recognition.stop();save();}else checkQueue();});
if(!Speech)say('此瀏覽器不支援語音辨識，請使用 Chrome 開啟。','bad');
controls();checkQueue();
</script>
</body>
</html>
