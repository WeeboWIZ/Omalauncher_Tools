put "$HOME/.local/bin/speak" <<'OMA_VOICE_FILE_10_END'
#!/bin/bash
set -eu
cache="$HOME/.cache/oma-speak"
json=no
case "${1:-}" in
  --text) cat "$cache/latest.txt" 2>/dev/null || true; exit ;;
  --help) echo 'speak: open voice input; speak --text: print latest dictation. Bash Ctrl+G inserts it.'; exit ;;
  --json) json=yes ;;
  '') ;;
  *) echo 'Usage: speak [--text|--json|--help]' >&2; exit 2 ;;
esac
mkdir -p "$cache"
exec 9>"$cache/start.lock"
flock 9
if ! curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then
  nohup python "$HOME/.local/share/oma-speak/server.py" >"$cache/server.log" 2>&1 < /dev/null 9>&- &
  for ((i=0;i<40;i++)); do
    if curl --noproxy '*' -fsS --max-time 1 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then break; fi
    sleep .1
  done
fi
if ! curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:18763/health 2>/dev/null | grep -qx oma-speak-v1; then
  if [ "$json" = yes ]; then printf '{"ok":false}\n'; else echo "Could not start voice input. See $cache/server.log" >&2; fi
  exit 1
fi
token=$(cat "$cache/token")
flock -u 9
if [ "$json" = yes ]; then
  if xdg-open "http://127.0.0.1:18763/#$token" >/dev/null 2>&1; then
    printf '{"ok":true}\n'
  else
    printf '{"ok":false}\n'
    exit 1
  fi
else
  xdg-open "http://127.0.0.1:18763/#$token"
fi
OMA_VOICE_FILE_10_END
chmod u+x "$HOME/.local/bin/oma-refine-dictation" "$HOME/.local/bin/oma-send-dictation" "$HOME/.local/bin/oma-voice" "$HOME/.local/bin/speak"
venv="$share/oma-voice/venv"
[ -x "$venv/bin/python" ] || python -m venv "$venv" || { say failed; exit 1; }
# Without the network this fails and speech stays offline (espeak-ng) until the next setup.
"$venv/bin/python" -m pip install --quiet --disable-pip-version-check edge-tts==7.3.1 || echo "edge-tts was not installed"
# Stop the old voice service and dictation page; the widget starts the new ones.
pkill -f '^[^ ]*python[0-9.]* .*/oma_voice\.py daemon$' || true
pkill -f '^[^ ]*python[0-9.]* .*/oma-speak/server\.py$' || true
printf '%s' '3.5.6-a593ddbe' > "$HOME/.local/share/oma-voice/store-version"
fi
printf '%s' '3.5.6-a593ddbe' > "$HOME/.local/share/oma-voice/dictation-version"
say done
""") }
